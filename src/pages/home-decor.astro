---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

const products = [
  {
    title: "Vintage Butterfly Photo Frame",
    brand: "LEYI DECOR",
    category: "Decorative Objects",
    image: "/images/new-finds/vintage-butterfly-photo-frame.png",
    href: "/new-finds/vintage-butterfly-photo-frame",
  },
  {
    title: "Botanical Vintage Pitcher",
    brand: "Ethereal Eves",
    category: "Home Decor",
    image: "/images/kasodi-edit/kasodi-edit-floral-ceramic-pitcher.png",
    href: "/kasodi-edit/botanical-vintage-pitcher",
  },
  {
    title: "Vintage Botanical Jewelry Box",
    brand: "Tila Home",
    category: "Decorative Objects",
    image: "/images/new-finds/vintage-botanical-jewelry-box.png",
    href: "/new-finds/vintage-botanical-jewelry-box",
  },
  {
    title: "White Twisted Ceramic Vase",
    brand: "Rundago",
    category: "Home Decor",
    image: "/images/home-decor/white-twisted-ceramic-vase.png",
    href: "/home-decor/white-twisted-ceramic-vase",
  },
  {
    title: "Blue Floral Ceramic Pitcher",
    brand: "Temu Find",
    category: "Home Decor",
    image: "/images/home-decor/blue-floral-ceramic-pitcher.png",
    href: "/home-decor/blue-floral-ceramic-pitcher",
  },
  {
    title: "Vintage Textured Ceramic Vase",
    brand: "YUMIPLUS",
    category: "Home Decor",
    image: "/images/home-decor/vintage-textured-ceramic-vase.png",
    href: "/home-decor/vintage-textured-ceramic-vase",
  },
];
---

<html lang="en">
