      content="Discover how to style a beautiful kitchen with natural materials, useful objects, warm wood, ceramics and everyday pieces worth keeping on display."
    />

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="KASODI" />

    <meta
      property="og:title"
      content="The Art of a Beautifully Styled Kitchen | KASODI"
