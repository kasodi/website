                alt="Cindea Green Marble Mortar and Pestle by Kave Home"
              />
            </a>

            <div class="journal-look-info">

              <p class="journal-story-product-category">
                KITCHEN UTENSILS
              </p>

              <h3>
                Cindea Green Marble Mortar &amp; Pestle
              </h3>

              <p class="journal-story-product-brand">
                Kave Home
              </p>

              <a
                href="/kitchen/cindea-green-marble-mortar-pestle"
                class="journal-story-discover"
              >
                Discover &rarr;
              </a>

            </div>

          </article>


          <article class="journal-look-card">

            <a
              href="/kitchen/rommu-acacia-serving-tray"
              class="journal-look-image"
            >
              <img
                src="/images/kitchen/kave-home-rommu-acacia-serving-tray.png"
                alt="Rommu Acacia Wood Serving Tray by Kave Home"
              />
            </a>

            <div class="journal-look-info">

              <p class="journal-story-product-category">
                SERVING &amp; TRAYS
              </p>

              <h3>
                Rommu Acacia Wood Serving Tray
              </h3>

              <p class="journal-story-product-brand">
                Kave Home
              </p>

              <a
                href="/kitchen/rommu-acacia-serving-tray"
                class="journal-story-discover"
              >
                Discover &rarr;
              </a>

            </div>

          </article>


          <article class="journal-look-card">

            <a
              href="/kitchen/nukha-acacia-toast-rack"
              class="journal-look-image"
            >
              <img
                src="/images/kitchen/kave-home-nukha-acacia-toast-rack.png"
                alt="Nukha Acacia Toast Rack by Kave Home"
              />
            </a>

            <div class="journal-look-info">

              <p class="journal-story-product-category">
                SERVING &amp; BREAKFAST
              </p>

              <h3>
                Nukha Acacia Toast Rack
              </h3>

              <p class="journal-story-product-brand">
                Kave Home
              </p>

              <a
                href="/kitchen/nukha-acacia-toast-rack"
                class="journal-story-discover"
              >
                Discover &rarr;
              </a>

            </div>

          </article>


        </div>

      </section>


      <!-- FINAL -->

      <section class="journal-article-final">

        <p class="product-detail-eyebrow">
          THE KASODI APPROACH
        </p>

        <h2>
          Let everyday life become part of the room.
        </h2>

        <p>
          Choose useful objects with character, mix natural materials and leave
          enough space for the kitchen to feel warm, personal and genuinely lived in.
        </p>

      </section>

    </main>

    <Footer />

  </body>
</html>