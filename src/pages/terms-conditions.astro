---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
---

<html lang="en">
  <head><!-- Start cookieyes banner --> <script id="cookieyes" type="text/javascript" src="https://cdn-cookieyes.com/client_data/e9c032e34948c08e8ad6b9973971db36/script.js"></script> <!-- End cookieyes banner -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Terms & Conditions | KASODI</title>

    <meta
      name="description"
      content="Read the Terms and Conditions governing the use of KASODI, an independent home and lifestyle curation website."
    />
  </head>

  <body>

    <Header />


    <main class="policy-page">

      <section class="policy-hero">

        <p class="policy-eyebrow">
          KASODI
        </p>

        <h1>
          Terms & Conditions
        </h1>

        <p class="policy-intro">
          These Terms & Conditions govern your use of the KASODI website.
          By accessing or using KASODI, you agree to these terms.
        </p>

        <p class="policy-updated">
          Last updated: August 2026
        </p>

      </section>


      <section class="policy-content">


        <div class="policy-section">

          <span class="policy-number">01</span>

          <div>

            <h2>About KASODI</h2>

            <p>
              KASODI is an independent home and lifestyle curation website
              based in Spain and intended for readers in Spain and across
              Europe.
            </p>

            <p>
              We publish curated product discoveries, editorial
              recommendations, inspiration and information relating to
              tableware, kitchen accessories, home décor, textiles, bathroom
              accessories, organization and other products for the home.
            </p>

            <p>
              KASODI is not an online retailer and does not directly sell the
              products featured on this website.
            </p>

          </div>

        </div>


        <div class="policy-section">

          <span class="policy-number">02</span>

          <div>

            <h2>Acceptance of these terms</h2>

            <p>
              By accessing or using the KASODI website, you agree to be bound
              by these Terms & Conditions and any applicable laws and
              regulations.
            </p>

            <p>
              If you do not agree with these terms, you should discontinue use
              of the website.
            </p>

          </div>

        </div>


        <div class="policy-section">

          <span class="policy-number">03</span>

          <div>

            <h2>Editorial content and product recommendations</h2>

            <p>
              KASODI provides editorial content, curated product selections,
              descriptions, styling ideas and recommendations for informational
              and inspirational purposes.
            </p>

            <p>
              We aim to present useful and accurate information, but product
              details may change after publication. This may include prices,
              colours, dimensions, materials, specifications, availability,
              delivery options and other product information.
            </p>

            <p>
              Before making a purchase, you should review the current product
              information provided by the retailer or seller.
            </p>

          </div>

        </div>


        <div class="policy-section">

          <span class="policy-number">04</span>

          <div>

            <h2>Third-party retailers and purchases</h2>

            <p>
              Products featured on KASODI are generally purchased from
              third-party retailers, marketplaces or brands through links
              provided on our website.
            </p>

            <p>
              KASODI does not process orders, receive customer payments,
              fulfil orders or enter into the sales contract between you and
              the third-party seller.
            </p>

            <p>
              When you choose to purchase a product through an external link,
              the transaction takes place directly between you and the relevant
              retailer or seller and is subject to that third party's terms
              and policies.
            </p>

          </div>

        </div>


        <div class="policy-section">

          <span class="policy-number">05</span>

          <div>

            <h2>Prices and availability</h2>

            <p>
              Prices and product availability displayed or mentioned on KASODI
              may change without notice.
            </p>

            <p>
              A retailer may change its price, promotion, stock availability,
              product specifications or delivery options after a product has
              been featured on KASODI.
            </p>

            <p>
              The price and information displayed by the retailer at the time
              of purchase should be considered the current and final
              information for that transaction.
            </p>

          </div>

        </div>


        <div class="policy-section">

          <span class="policy-number">06</span>

          <div>

            <h2>Delivery, returns and warranties</h2>

            <p>
              KASODI does not manage product delivery, shipping, cancellations,
              exchanges, refunds, returns, warranties or customer service for
              purchases made through third-party retailers.
            </p>

            <p>
              These matters are governed by the policies and terms of the
              retailer or seller from whom the product is purchased.
            </p>

            <p>
              Questions relating to an order or purchase should therefore be
              directed to the relevant retailer or seller.
            </p>

          </div>

        </div>


        <div class="policy-section">

          <span class="policy-number">07</span>

          <div>

            <h2>Affiliate links</h2>

            <p>
              Some links on KASODI are affiliate links. If you click one of
              these links and make a qualifying purchase, KASODI may receive
              a commission from the retailer, marketplace or affiliate network
              at no additional cost to you.
            </p>

            <p>
              KASODI currently participates in affiliate relationships
              including Amazon.es through the Amazon Associates Program and
              the Temu Affiliate Program, and may participate in additional
              affiliate programs in the future.
            </p>

            <p>
              Further information is available in our
              <a href="/affiliate-disclosure">Affiliate Disclosure</a>.
            </p>

          </div>

        </div>


        <div class="policy-section">

          <span class="policy-number">08</span>

          <div>

            <h2>External websites</h2>

            <p>
              KASODI contains links to websites operated by third parties,
              including retailers, marketplaces, brands, affiliate partners
              and social media platforms.
            </p>

            <p>
              These external websites are not controlled by KASODI. We are
              not responsible for their content, availability, security,
              privacy practices or terms.
            </p>

            <p>
              Your use of a third-party website is subject to the terms and
              policies of that website.
            </p>

          </div>

        </div>


        <div class="policy-section">

          <span class="policy-number">09</span>

          <div>

            <h2>Intellectual property</h2>

            <p>
              Unless otherwise stated, the original editorial content,
              written copy, website design elements, KASODI branding, logos,
              graphics and other original materials created for KASODI are
              protected by applicable intellectual property laws.
            </p>

            <p>
              You may view and use the website for personal, non-commercial
              purposes.
            </p>

            <p>
              You may not reproduce, republish, distribute, modify, sell,
              commercially exploit or otherwise use KASODI's original content
              or branding without prior permission, except where such use is
              permitted by applicable law.
            </p>

            <p>
              Product names, trademarks, logos and other materials belonging
              to third-party brands or retailers remain the property of their
              respective owners.
            </p>

          </div>

        </div>


        <div class="policy-section">

          <span class="policy-number">10</span>

          <div>

            <h2>Permitted use of the website</h2>

            <p>
              You agree to use KASODI only for lawful purposes and in a manner
              that does not interfere with the operation or security of the
              website or the rights of others.
            </p>

            <p>
              You must not attempt to gain unauthorized access to the website,
              its infrastructure or related systems, or intentionally interfere
              with the website's normal operation.
            </p>

          </div>

        </div>


        <div class="policy-section">

          <span class="policy-number">11</span>

          <div>

            <h2>Limitation of responsibility</h2>

            <p>
              KASODI provides its editorial content and product information
              for general informational and inspirational purposes.
            </p>

            <p>
              To the extent permitted by applicable law, KASODI does not
              guarantee that all website content will always be complete,
              current, error-free or continuously available.
            </p>

            <p>
              Nothing in these Terms & Conditions is intended to exclude or
              limit any rights or liability that cannot lawfully be excluded
              or limited under applicable law.
            </p>

          </div>

        </div>


        <div class="policy-section">

          <span class="policy-number">12</span>

          <div>

            <h2>Privacy</h2>

            <p>
              Information about privacy and the handling of personal
              information in connection with KASODI is available in our
              <a href="/privacy-policy">Privacy Policy</a>.
            </p>

            <p>
              Information about cookies and similar technologies is available
              in our <a href="/cookie-policy">Cookie Policy</a>.
            </p>

          </div>

        </div>


        <div class="policy-section">

          <span class="policy-number">13</span>

          <div>

            <h2>Changes to these terms</h2>

            <p>
              KASODI may update these Terms & Conditions as the website,
              services, partnerships or applicable requirements change.
            </p>

            <p>
              Updated terms will be published on this page and the
              “Last updated” date will be revised.
            </p>

          </div>

        </div>


        <div class="policy-section">

          <span class="policy-number">14</span>

          <div>

            <h2>Contact</h2>

            <p>
              If you have questions about these Terms & Conditions, contact
              KASODI at:
            </p>

            <a
              class="policy-email"
              href="mailto:kasodi.info@gmail.com"
            >
              kasodi.info@gmail.com
            </a>

          </div>

        </div>

      </section>


      <section class="policy-final">

        <p class="policy-eyebrow">
          KASODI
        </p>

        <h2>
          Curated with care for a more considered home.
        </h2>

        <a href="/#collections" class="product-shop-button">
          Explore the Collection →
        </a>

      </section>

    </main>


    <Footer />
    
  </body>
</html>


<style>

  .policy-page {
    background: #f8f5ef;
    color: #29251f;
  }


  .policy-hero {
    max-width: 1000px;
    margin: 0 auto;
    padding: 110px 40px 100px;
    text-align: center;
  }


  .policy-eyebrow {
    margin: 0 0 25px;
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #917552;
  }


  .policy-hero h1 {
    margin: 0 auto 35px;
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
    font-size: clamp(48px, 6vw, 78px);
    line-height: 1.05;
  }


  .policy-intro {
    max-width: 720px;
    margin: 0 auto;
    font-size: 19px;
    line-height: 1.75;
    color: #5e574d;
  }


  .policy-updated {
    margin: 30px 0 0;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: #8b8378;
  }


  .policy-content {
    max-width: 1080px;
    margin: 0 auto;
    padding: 20px 40px 120px;
  }


  .policy-section {
    padding: 60px 0;
    border-top: 1px solid rgba(41, 37, 31, 0.15);
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 45px;
  }


  .policy-number {
    font-size: 11px;
    letter-spacing: 0.18em;
    color: #917552;
  }


  .policy-section > div {
    max-width: 760px;
  }


  .policy-section h2 {
    margin: 0 0 25px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 32px;
    line-height: 1.2;
    font-weight: 400;
  }


  .policy-section p {
    margin: 0 0 20px;
    font-size: 16px;
    line-height: 1.85;
    color: #5d564c;
  }


  .policy-section p a {
    color: #29251f;
    text-decoration: underline;
    text-underline-offset: 4px;
  }


  .policy-email {
    display: inline-block;
    margin-top: 5px;
    color: #29251f;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 24px;
    text-decoration: none;
    border-bottom: 1px solid rgba(41, 37, 31, 0.35);
  }


  .policy-email:hover {
    opacity: 0.65;
  }


  .policy-final {
    padding: 110px 40px;
    text-align: center;
    background: #29251f;
    color: #f8f5ef;
  }


  .policy-final h2 {
    max-width: 800px;
    margin: 0 auto 35px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(36px, 4vw, 55px);
    line-height: 1.15;
    font-weight: 400;
  }


  .policy-final .product-shop-button {
    display: inline-block;
  }


  @media (max-width: 700px) {

    .policy-hero,
    .policy-content,
    .policy-final {
      padding-left: 22px;
      padding-right: 22px;
    }


    .policy-section {
      grid-template-columns: 1fr;
      gap: 18px;
      padding: 45px 0;
    }


    .policy-hero {
      padding-top: 70px;
      padding-bottom: 70px;
    }


    .policy-email {
      font-size: 20px;
    }

  }

</style>