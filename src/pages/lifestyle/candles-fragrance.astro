---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

const products = [
  {
    name: 'Sculptural Ivory Candles',
    brand: 'ALMA DE LLAMA',
    category: 'Candles & Fragrance',
    image: '/images/kasodi-edit/kasodi-edit-sculptural-ivory-candles.png',
    href: '/candles-fragrance/sculptural-ivory-candles',
  },
  {
    name: 'Ribbed Sculptural Candle Set',
    brand: 'ALMA DE LLAMA',
    category: 'Candles & Fragrance',
    image: '/images/candles-fragrance/alma-de-llama-ribbed-sculptural-candles.png',
    href: '/candles-fragrance/ribbed-sculptural-candle-set',
  },
  {
    name: 'Lena Sculptural Flower Candle',
    brand: 'Serenitique',
    category: 'Candles & Fragrance',
    image: '/images/candles-fragrance/serentique-lena-sculptural-flower-candle.png',
    href: '/candles-fragrance/lena-sculptural-flower-candle',
  },
  {
    name: 'Walnut Candle Holder Set',
    brand: 'Sabaily',
    category: 'Candles & Fragrance',
    image: '/images/candles-fragrance/sabaily-walnut-candle-holder-set.png',
    href: '/candles-fragrance/walnut-candle-holder-set',
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Candles & Fragrance | KASODI</title>
    <meta
      name="description"
      content="Discover KASODI's curated selection of sculptural candles, candle holders and atmospheric details for a warm and considered home."
    />
  </head>

  <body>
    <Header />

    <main class="collection-page">
      <section class="collection-intro">
        <div>
          <a href="/lifestyle" class="collection-eyebrow">LIFESTYLE</a>
          <h1>Candles & Fragrance</h1>
        </div>

        <p class="collection-description">
          Sculptural candles and atmospheric details for warmth, ritual and a
          softer everyday mood.
        </p>
      </section>

      <section class="products-section">
        <div class="product-grid">
          {products.map((product) => (
            <a href={product.href} class="product-card">
              <div class="product-image">
                <img
                  src={product.image}
                  alt={`${product.name} by ${product.brand}`}
                  loading="lazy"
                />
              </div>

              <div class="product-info">
                <span class="product-category">{product.category}</span>
                <h2>{product.name}</h2>
                <p>{product.brand}</p>
                <strong>DISCOVER &rarr;</strong>
              </div>
            </a>
          ))}
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .collection-page {
    background: #f7f4ee;
    color: #2f2922;
    min-height: 100vh;
  }

  .collection-intro {
    width: min(1240px, 84%);
    margin: 0 auto;
    padding: 115px 0 70px;

    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: end;
  }

  .collection-eyebrow {
  display: inline-block;
  margin: 0 0 32px;
  font-size: 13px;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: #a3622b;
  text-decoration: none;
}

.collection-eyebrow:hover {
  opacity: 0.65;
}

  .collection-intro h1 {
    margin: 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(52px, 5vw, 76px);
    font-weight: 400;
    line-height: 1;
  }

  .collection-description {
    max-width: 540px;
    margin: 0 0 4px;
    font-size: 18px;
    line-height: 1.65;
    color: #9a602f;
  }

  .products-section {
    width: min(1240px, 84%);
    margin: 0 auto;
    padding-bottom: 130px;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 26px;
  }

  .product-card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .product-image {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #eee9df;
  }

  .product-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .product-card:hover .product-image img {
    transform: scale(1.025);
  }

  .product-info {
    padding-top: 18px;
  }

  .product-category {
    display: block;
    margin-bottom: 14px;
    color: #a3622b;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .product-info h2 {
    margin: 0 0 9px;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 24px;
    line-height: 1.3;
    font-weight: 400;
  }

  .product-info p {
    margin: 0 0 24px;
    color: #8b592f;
    font-size: 14px;
  }

  .product-info strong {
    display: inline-block;
    padding-bottom: 4px;
    border-bottom: 1px solid #2f2922;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.14em;
  }

  @media (max-width: 1050px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 760px) {
    .collection-intro {
      width: 90%;
      padding: 70px 0 50px;
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .collection-intro h1 {
      font-size: 48px;
    }

    .products-section {
      width: 90%;
      padding-bottom: 90px;
    }

    .product-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
</style>