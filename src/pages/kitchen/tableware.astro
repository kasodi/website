---
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const products = [
  {
    name: 'Blue Floral Dessert Plates',
    brand: 'fanquare',
    category: 'Tableware',
    image: '/images/new-finds/fanquare-blue-floral-dessert-plates.png',
    href: '/kitchen/tableware/fanquare-blue-floral-dessert-plates',
  },
  {
    name: 'Pink Floral Tea Cup & Saucer',
    brand: 'KASODI Find',
    category: 'Tableware',
    image: '/images/tableware/pink-floral-tea-cup-saucer.png',
    href: '/kitchen/tableware/pink-floral-tea-cup-saucer',
  },
  {
    name: 'French Garden Fleurence Dinner Plate',
    brand: 'Villeroy & Boch',
    category: 'Tableware',
    image: '/images/tableware/villeroy-boch-french-garden-fleurence-dinner-plate.png',
    href: '/kitchen/tableware/villeroy-boch-french-garden-fleurence-dinner-plate',
  },
  {
    name: 'French Garden Fleurence Sugar Bowl',
    brand: 'Villeroy & Boch',
    category: 'Tableware',
    image: '/images/tableware/villeroy-boch-french-garden-fleurence-sugar-bowl.png',
    href: '/kitchen/tableware/french-garden-fleurence-sugar-bowl',
  },
  {
    name: 'Blue Floral Porcelain Tea Set',
    brand: 'KASODI Find',
    category: 'Tableware',
    image: '/images/tableware/blue-floral-porcelain-tea-set.png',
    href: '/kitchen/tableware/blue-floral-porcelain-tea-set',
  },
  {
    name: 'Vintage Multicolour Dinnerware Set',
    brand: 'KASODI Find',
    category: 'Tableware',
    image: '/images/tableware/vintage-multicolour-dinnerware-set.png',
    href: '/kitchen/tableware/vintage-multicolour-dinnerware-set',
  },
  {
    name: 'Vintage Gold Cake Serving Set',
    brand: 'KASODI Find',
    category: 'Serveware',
    image: '/images/tableware/vintage-gold-cake-serving-set.png',
    href: '/kitchen/tableware/vintage-gold-cake-serving-set',
  },
  {
    name: 'Botanical Vintage Pitcher',
    brand: 'Ethereal Eves',
    category: 'Serveware',
    image: '/images/kasodi-edit/kasodi-edit-floral-ceramic-pitcher.png',
    href: '/kasodi-edit/botanical-vintage-pitcher',
  },
  {
    name: 'Blue Floral Ceramic Pitcher',
    brand: 'KASODI Find',
    category: 'Serveware',
    image: '/images/home-decor/blue-floral-ceramic-pitcher.png',
    href: '/home-decor/blue-floral-ceramic-pitcher',
  },
  {
    name: 'Cream Tassel Table Runner',
    brand: 'KASODI Find',
    category: 'Table Linen',
    image: '/images/textiles-cozy/cream-tassel-table-runner.png',
    href: '/textiles-cozy/cream-tassel-table-runner',
  },
];

---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Tableware | KASODI</title>

    <meta
      name="description"
      content="Discover the KASODI Tableware edit — plates, bowls, cups and serving pieces selected to bring character to everyday meals and gatherings."
    />

    <link
      rel="icon"
      type="image/png"
      href="/images/kasodi-favicon.png?v=2"
    />
  </head>

  <body>
    <Header />

    <main>
      <section class="kitchen-collection">
        <div class="collection-head">
          <div>
            <a href="/kitchen" class="collection-parent">KITCHEN</a>
            <h1>Tableware</h1>
          </div>

          <p>
            Plates, bowls, cups and serving pieces selected to bring character
            to everyday meals and gatherings.
          </p>
        </div>

        <div class="product-grid">
          {products.map((product) => (
            <a class="product" href={product.href}>
              <img src={product.image} alt={product.name} />

              <span>{product.category}</span>

              <h2>{product.name}</h2>

              <p>{product.brand}</p>

              <u>Discover &rarr;</u>
            </a>
          ))}
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #f8f6f1;
    color: #29251f;
    font-family: Arial, sans-serif;
  }

  .kitchen-collection {
    padding: 90px 8% 120px;
    min-height: 70vh;
  }

  .collection-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: end;
    margin-bottom: 55px;
  }

  .collection-parent {
  display: inline-block;
  width: max-content;
  font-size: 11px;
  letter-spacing: 0.28em;
  color: #9a6b3b;
  text-decoration: none;
}

.collection-parent:hover {
  opacity: 0.65;
}

  .collection-head h1 {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 64px;
    line-height: 1;
    font-weight: 400;
    margin: 20px 0 0;
  }

  .collection-head p {
    max-width: 520px;
    margin: 0;
    color: #8a6848;
    font-size: 17px;
    line-height: 1.6;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .product {
    color: #29251f;
    text-decoration: none;
  }

  .product img {
    width: 100%;
    aspect-ratio: 0.82;
    object-fit: cover;
    display: block;
  }

  .product > span {
    display: block;
    margin-top: 16px;
    font-size: 10px;
    letter-spacing: 0.16em;
    color: #9a6b3b;
    text-transform: uppercase;
  }

  .product h2 {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 24px;
    line-height: 1.3;
    font-weight: 400;
    margin: 8px 0 5px;
  }

  .product p {
    margin: 0 0 14px;
    color: #775d43;
    font-size: 13px;
  }

  .product u {
    font-size: 12px;
    text-underline-offset: 5px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  @media (max-width: 900px) {
    .collection-head {
      grid-template-columns: 1fr;
    }

    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .kitchen-collection {
      padding: 65px 6% 90px;
    }

    .collection-head h1 {
      font-size: 52px;
    }

    .product-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }

    .product h2 {
      font-size: 20px;
    }
  }
</style>