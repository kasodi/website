
---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const affiliateUrl = "https://tidd.ly/4AoLlTt";
---

<html lang="en">
  <head>
    <!-- Google Consent Mode -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];

      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
        functionality_storage: "denied",
        personalization_storage: "denied",
        security_storage: "granted",
        wait_for_update: 2000
      });

      gtag("set", "ads_data_redaction", true);
      gtag("set", "url_passthrough", true);
    </script>

    <!-- CookieYes -->
    <script
      id="cookieyes"
      type="text/javascript"
      src="https://cdn-cookieyes.com/client_data/e9c032e34948c08e8ad6b9973971db36/script.js"
    ></script>

    <!-- Google Analytics -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-LT2BEMKHKC"
    ></script>

    <script is:inline>
      window.dataLayer = window.dataLayer || [];

      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("js", new Date());
      gtag("config", "G-LT2BEMKHKC");
    </script>

    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>STAUB Ceramic Oil & Vinegar Set | KASODI</title>

    <meta
      name="description"
      content="Discover the STAUB Ceramic Oil & Vinegar Set in Cherry Red. Two 250 ml ceramic bottles with stainless steel pouring spouts, selected for everyday cooking and table styling."
    />

    <link
      rel="canonical"
      href="https://kasodi.com/kitchen/staub-ceramic-oil-vinegar-set/"
    />

    <link
      rel="icon"
      type="image/png"
      href="/images/kasodi-favicon.png?v=2"
    />
  </head>

  <body>
    <Header />

    <main class="product-detail-page">

      <!-- BREADCRUMBS -->
      <div class="product-breadcrumb">
        <a href="/">Home</a>
        <span>&middot;</span>
        <a href="/kitchen/">Kitchen</a>
        <span>&middot;</span>
        <span>STAUB Ceramic Oil & Vinegar Set</span>
      </div>

      <!-- PRODUCT HERO -->
      <section class="product-detail-hero">

        <div class="product-detail-image">
          <img
            src="/images/kitchen/staub-ceramic-oil-vinegar-set.png"
            alt="STAUB Cherry Red Ceramic Oil and Vinegar Set styled in a warm Mediterranean kitchen with natural ceramics and fresh herbs"
          />
        </div>

        <div class="product-detail-content">

          <p class="product-detail-eyebrow">
            THE KASODI EDIT · KITCHEN ESSENTIALS
          </p>

          <h1>STAUB Ceramic Oil & Vinegar Set</h1>

          <p class="product-detail-brand">STAUB</p>

          <p class="product-detail-intro">
            A little colour can make an everyday kitchen feel
            more personal. This STAUB oil and vinegar set brings
            two cherry-red ceramic bottles to the countertop
            or dining table, each finished with a slim stainless
            steel pouring spout.

            The simple shape, glossy glaze and familiar STAUB
            lettering give the pair a distinctive look.
            They sit comfortably alongside wooden utensils,
            natural linen and everyday ceramics.
          </p>

          <div class="product-detail-divider"></div>

          <div class="product-detail-meta">

            <div>
              <span>Material</span>
              <strong>Ceramic</strong>
            </div>

            <div>
              <span>Colour</span>
              <strong>Cherry Red</strong>
            </div>

            <div>
              <span>Capacity</span>
              <strong>250 ml per bottle</strong>
            </div>

            <div>
              <span>Set Includes</span>
              <strong>2 bottles</strong>
            </div>

            <div>
              <span>Height</span>
              <strong>19.6 cm</strong>
            </div>

            <div>
              <span>Width</span>
              <strong>6.3 cm</strong>
            </div>

            <div>
              <span>Weight</span>
              <strong>0.63 kg per set</strong>
            </div>

            <div>
              <span>Care</span>
              <strong>Dishwasher-safe ceramic</strong>
            </div>

          </div>

          <div class="affiliate-action">

            <a
              href={affiliateUrl}
              target="_blank"
              rel="nofollow sponsored noopener"
              class="product-shop-button"
            >
              Find It Here →
            </a>

            <p class="affiliate-note">
              Affiliate link · KASODI may earn a commission
              at no extra cost to you.
            </p>

          </div>

        </div>
      </section>

      <!-- WHY WE LOVE IT -->
      <section class="why-we-love">

        <div class="why-we-love-label">
          KASODI NOTE
        </div>

        <div class="why-we-love-content">

          <h2>Why we love it</h2>

          <p>
            Oil and vinegar are always close at hand in a
            busy kitchen, so it makes sense to keep them
            in bottles you enjoy looking at.
          </p>

          <p>
            This STAUB set has a pleasing balance of colour
            and simplicity. The cherry-red glaze adds warmth
            to open shelves and wooden countertops, while
            the narrow spouts make it easier to pour just
            the amount you need.
          </p>

          <p>
            We particularly like the pair on a small wooden
            tray beside a bowl of sea salt and a few fresh
            herbs. Everything stays within reach, and the
            arrangement looks just as good when dinner
            is served.
          </p>

        </div>
      </section>

      <!-- CARE -->
      <section class="product-care">

        <p class="product-detail-eyebrow">
          CARE & DETAILS
        </p>

        <h2>Made for everyday use</h2>

        <p>
          The set includes two ceramic bottles, one for
          olive oil and one for vinegar. Each holds 250 ml
          and comes with a narrow pouring spout for
          controlled serving.
        </p>

        <p>
          The ceramic bottles are dishwasher safe according
          to the retailer's specifications. Clean the
          pouring attachments as directed by the manufacturer
          and allow all parts to dry thoroughly before
          refilling.
        </p>

      </section>

      <!-- STYLING -->
      <section class="styling-ideas">

        <div class="styling-heading">
          <p>KASODI STYLING</p>
          <h2>Style it with</h2>
        </div>

        <div class="styling-grid">

          <div class="styling-card">
            <span>01</span>
            <h3>Natural Wood</h3>

            <p>
              Keep the bottles on a small wooden tray
              alongside a salt dish and your favourite
              cooking utensils.
            </p>
          </div>

          <div class="styling-card">
            <span>02</span>
            <h3>Warm Ceramics</h3>

            <p>
              Cream stoneware bowls and handmade
              ceramic pieces soften the bright red
              glaze without competing with it.
            </p>
          </div>

          <div class="styling-card">
            <span>03</span>
            <h3>Fresh Herbs & Linen</h3>

            <p>
              Add a pot of basil, a few olive branches
              and a softly washed linen napkin for
              a relaxed Mediterranean setting.
            </p>
          </div>

        </div>
      </section>

      <!-- CONTINUE EXPLORING -->
      <section class="continue-exploring">

        <div class="continue-exploring-heading">
          <p>CURATED FOR YOU</p>
          <h2>Continue Exploring</h2>
        </div>

        <div class="continue-exploring-grid">

          <!-- CARD 1 -->
          <a
            href="/kitchen/staub-artichoke-cocotte-22cm/"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/kitchen/staub-artichoke-cocotte-22cm.png"
                alt="STAUB Artichoke Cocotte in Basil Green"
                loading="lazy"
              />
            </div>

            <div class="continue-card-info">
              <span>KITCHEN ESSENTIALS</span>
              <h3>STAUB Artichoke Cocotte 22 cm</h3>
              <p>Sculptural cast iron for slow cooking</p>
              <strong>Discover →</strong>
            </div>

          </a>

          <!-- CARD 2 -->
          <a
            href="/kitchen/kitchen-essentials/"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/journal/the-art-of-a-beautifully-styled-kitchen-hero.png"
                alt="Mediterranean kitchen with natural materials and warm details"
                loading="lazy"
              />
            </div>

            <div class="continue-card-info">
              <span>KITCHEN COLLECTION</span>
              <h3>Kitchen Essentials</h3>
              <p>Thoughtful pieces for everyday cooking</p>
              <strong>Discover →</strong>
            </div>

          </a>

          <!-- CARD 3 -->
          <a
            href="/kitchen/tableware/natural-linen-drink-coasters/"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/tableware/natural-linen-drink-coasters.png"
                alt="Natural Linen Drink Coasters"
                loading="lazy"
              />
            </div>

            <div class="continue-card-info">
              <span>TABLE LINEN</span>
              <h3>Natural Linen Drink Coasters</h3>
              <p>Linen Couture</p>
              <strong>Discover →</strong>
            </div>

          </a>

        </div>
      </section>

      <!-- FINAL CTA -->
      <section class="product-final-cta">

        <p class="product-detail-eyebrow">
          STAUB · CERAMIC COLLECTION
        </p>

        <h2>
          A little colour for the everyday table.
        </h2>

        <a
          href={affiliateUrl}
          target="_blank"
          rel="nofollow sponsored noopener"
          class="product-shop-button"
        >
          Find It Here →
        </a>

        <p class="affiliate-note affiliate-note-light">
          Affiliate link · KASODI may earn a commission
          at no extra cost to you.
        </p>

      </section>

    </main>

    <Footer />
  </body>
</html>
