
---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const affiliateUrl = "https://tidd.ly/3UMJZD6";
---

<html lang="en">
  <head>
    <!-- Google Consent Mode -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
        functionality_storage: "denied",
        personalization_storage: "denied",
        security_storage: "granted",
        wait_for_update: 2000
      });

      gtag("set", "ads_data_redaction", true);
      gtag("set", "url_passthrough", true);
    </script>

    <!-- CookieYes -->
    <script
      id="cookieyes"
      type="text/javascript"
      src="https://cdn-cookieyes.com/client_data/e9c032e34948c08e8ad6b9973971db36/script.js"
    ></script>

    <!-- Google Analytics -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-LT2BEMKHKC"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-LT2BEMKHKC");
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>STAUB Artichoke Cocotte 22 cm | KASODI</title>

    <meta
      name="description"
      content="Discover the STAUB Artichoke Cocotte in Basil Green. A sculptural 22 cm enamelled cast iron cocotte, selected by KASODI for timeless cooking and beautiful gatherings."
    />

    <link
      rel="canonical"
      href="https://kasodi.com/kitchen/staub-artichoke-cocotte-22cm/"
    />

    <link
      rel="icon"
      type="image/png"
      href="/images/kasodi-favicon.png?v=2"
    />
  </head>

  <body>
    <Header />

    <main class="product-detail-page">

      <!-- BREADCRUMBS -->
      <div class="product-breadcrumb">
        <a href="/">Home</a>
        <span>&middot;</span>
        <a href="/kitchen/">Kitchen</a>
        <span>&middot;</span>
        <span>STAUB Artichoke Cocotte</span>
      </div>

      <!-- PRODUCT HERO -->
      <section class="product-detail-hero">

        <div class="product-detail-image">
          <img
            src="/images/kitchen/staub-artichoke-cocotte-22cm.png"
            alt="STAUB Basil Green Artichoke Cocotte styled with natural linen, ceramics and Mediterranean details"
          />
        </div>

        <div class="product-detail-content">

          <p class="product-detail-eyebrow">
            THE KASODI EDIT · KITCHEN ESSENTIALS
          </p>

          <h1>STAUB Artichoke Cocotte 22 cm</h1>

          <p class="product-detail-brand">STAUB</p>

          <p class="product-detail-intro">
            Where beautiful design meets the pleasure of slow cooking.
            Inspired by the organic shape of an artichoke, this
            enamelled cast iron cocotte brings sculptural character
            and timeless French craftsmanship to the kitchen.
            Its rich basil-green finish feels especially beautiful
            alongside natural linen, warm wood and handmade ceramics.
          </p>

          <div class="product-detail-divider"></div>

          <div class="product-detail-meta">
            <div>
              <span>Material</span>
              <strong>Enamelled cast iron</strong>
            </div>

            <div>
              <span>Colour</span>
              <strong>Basil Green</strong>
            </div>

            <div>
              <span>Diameter</span>
              <strong>22 cm</strong>
            </div>

            <div>
              <span>Capacity</span>
              <strong>3 L</strong>
            </div>

            <div>
              <span>Weight</span>
              <strong>4.25 kg</strong>
            </div>

            <div>
              <span>Compatibility</span>
              <strong>All hobs, including induction</strong>
            </div>

            <div>
              <span>Oven Safe</span>
              <strong>Up to 260°C</strong>
            </div>

            <div>
              <span>Collection</span>
              <strong>STAUB Vegetable Garden</strong>
            </div>
          </div>

          <div class="affiliate-action">
            <a
              href={affiliateUrl}
              target="_blank"
              rel="nofollow sponsored noopener"
              class="product-shop-button"
            >
              Find It Here →
            </a>

            <p class="affiliate-note">
              Affiliate link · KASODI may earn a commission
              at no extra cost to you.
            </p>
          </div>

        </div>
      </section>

      <!-- WHY WE LOVE IT -->
      <section class="why-we-love">

        <div class="why-we-love-label">KASODI NOTE</div>

        <div class="why-we-love-content">

          <h2>Why we love it</h2>

          <p>
            Some kitchen pieces are designed to be seen as much
            as they are to be used. The STAUB Artichoke Cocotte
            is one of those rare finds that feels both practical
            and beautifully expressive.
          </p>

          <p>
            Its artichoke-inspired silhouette and deep basil-green
            enamel introduce an organic, almost sculptural quality.
            The enamelled cast iron retains and distributes heat
            evenly, making it a lovely choice for slow-cooked
            dishes, comforting stews and relaxed family meals.
          </p>

          <p>
            We especially love how naturally it fits into
            a Mediterranean-inspired kitchen — surrounded by
            olive branches, textured ceramics, simple glassware
            and softly washed linen.
          </p>

        </div>
      </section>

      <!-- CARE -->
      <section class="product-care">

        <p class="product-detail-eyebrow">CARE</p>

        <h2>Made for slow, beautiful cooking</h2>

        <p>
          Suitable for gas, electric, ceramic and induction
          hobs, as well as oven cooking up to 260°C.
          Heat gradually and use wooden or silicone utensils
          to help protect the enamelled surface.
          Allow the cocotte to cool before washing and avoid
          sudden temperature changes.
          Although dishwasher-safe according to the product
          specifications, gentle handwashing is recommended
          to help preserve its finish.
          Always follow the manufacturer's care instructions.
        </p>

      </section>

      <!-- STYLING -->
      <section class="styling-ideas">

        <div class="styling-heading">
          <p>KASODI STYLING</p>
          <h2>Style it with</h2>
        </div>

        <div class="styling-grid">

          <div class="styling-card">
            <span>01</span>
            <h3>Natural Linen</h3>
            <p>
              Soft ivory tablecloths and textured linen napkins
              create a relaxed foundation for the cocotte's
              rich green enamel.
            </p>
          </div>

          <div class="styling-card">
            <span>02</span>
            <h3>Handmade Ceramics</h3>
            <p>
              Creamy stoneware, botanical plates and simple
              serving bowls complement its sculptural
              silhouette beautifully.
            </p>
          </div>

          <div class="styling-card">
            <span>03</span>
            <h3>Warm Wood & Olive Branches</h3>
            <p>
              A natural wooden trivet, olive branches
              and understated glassware complete
              a timeless Mediterranean table.
            </p>
          </div>

        </div>
      </section>

      <!-- CONTINUE EXPLORING -->
      <section class="continue-exploring">

        <div class="continue-exploring-heading">
          <p>CURATED FOR YOU</p>
          <h2>Continue Exploring</h2>
        </div>

        <div class="continue-exploring-grid">

          <!-- CARD 1 -->
          <a href="/kitchen/kitchen-essentials/" class="continue-card">

            <div class="continue-card-image">
              <img
                src="/images/journal/the-art-of-a-beautifully-styled-kitchen-hero.png"
                alt="Warm Mediterranean kitchen with natural materials and timeless details"
                loading="lazy"
              />
            </div>

            <div class="continue-card-info">
              <span>KITCHEN COLLECTION</span>
              <h3>Kitchen Essentials</h3>
              <p>Beautiful pieces for everyday cooking</p>
              <strong>Discover →</strong>
            </div>

          </a>

          <!-- CARD 2 -->
          <a
            href="/kitchen/tableware/white-ruffled-linen-round-tablecloth/"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/tableware/linen-couture-white-ruffled-round-tablecloth.png"
                alt="White Ruffled Linen Round Tablecloth"
                loading="lazy"
              />
            </div>

            <div class="continue-card-info">
              <span>TABLE LINEN</span>
              <h3>White Ruffled Linen Round Tablecloth</h3>
              <p>Linen Couture</p>
              <strong>Discover →</strong>
            </div>

          </a>

          <!-- CARD 3 -->
          <a
            href="/journal/how-to-create-a-mediterranean-table/"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/categories/category-tableware.webp"
                alt="Mediterranean table with green ceramics and natural textures"
                loading="lazy"
              />
            </div>

            <div class="continue-card-info">
              <span>KASODI JOURNAL</span>
              <h3>How to Create a Mediterranean Table</h3>
              <p>Natural textures and timeless table styling</p>
              <strong>Discover →</strong>
            </div>

          </a>

        </div>
      </section>

      <!-- FINAL CTA -->
      <section class="product-final-cta">

        <p class="product-detail-eyebrow">
          STAUB · FRENCH CAST IRON
        </p>

        <h2>
          A beautiful expression of slow cooking
          and timeless craftsmanship.
        </h2>

        <a
          href={affiliateUrl}
          target="_blank"
          rel="nofollow sponsored noopener"
          class="product-shop-button"
        >
          Find It Here →
        </a>

        <p class="affiliate-note affiliate-note-light">
          Affiliate link · KASODI may earn a commission
          at no extra cost to you.
        </p>

      </section>

    </main>

    <Footer />
  </body>
</html>
