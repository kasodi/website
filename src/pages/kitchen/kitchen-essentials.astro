---
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const products = [
  {
    name: 'Cindea Green Marble Mortar & Pestle',
    brand: 'Kave Home',
    category: 'Kitchen',
    image: '/images/kitchen/kave-home-cindea-green-marble-mortar-pestle.png',
    href: '/kitchen/cindea-green-marble-mortar-pestle',
  },
  {
    name: 'Convia Reactive Glaze Baking Dish',
    brand: 'Kave Home',
    category: 'Kitchen',
    image: '/images/kitchen/kave-home-convia-reactive-glaze-baking-dish.png',
    href: '/kitchen/convia-reactive-glaze-baking-dish',
  },
  {
    name: 'Rommu Acacia Serving Tray',
    brand: 'Kave Home',
    category: 'Kitchen',
    image: '/images/kitchen/kave-home-rommu-acacia-serving-tray.png',
    href: '/kitchen/rommu-acacia-serving-tray',
  },
  {
    name: 'Nukha Acacia Toast Rack',
    brand: 'Kave Home',
    category: 'Kitchen',
    image: '/images/kitchen/kave-home-nukha-acacia-toast-rack.png',
    href: '/kitchen/nukha-acacia-toast-rack',
  },
  {
    name: 'Nukha Acacia Wood Nutcracker',
    brand: 'Kave Home',
    category: 'Kitchen',
    image: '/images/kitchen/kave-home-nukha-acacia-wood-nutcracker.png',
    href: '/kitchen/nukha-acacia-wood-nutcracker',
  },
  {
    name: 'Sataya Acacia Holed Spatula',
    brand: 'Kave Home',
    category: 'Kitchen',
    image: '/images/kitchen/kave-home-sataya-acacia-holed-spatula.png',
    href: '/kitchen/sataya-acacia-holed-spatula',
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Kitchen Essentials | KASODI</title>

    <meta
      name="description"
      content="Discover the KASODI Kitchen Essentials edit — useful pieces with material warmth, chosen for preparing and serving without losing the beauty of the room."
    />

    <link
      rel="icon"
      type="image/png"
      href="/images/kasodi-favicon.png?v=2"
    />
  </head>

  <body>
    <Header />

    <main>
      <section class="kitchen-collection">
        <div class="collection-head">
          <div>
            <a href="/kitchen" class="collection-parent">KITCHEN</a>
            <h1>Kitchen Essentials</h1>
          </div>

          <p>
            Useful pieces with material warmth — serving and preparing without
            losing the beauty of the room.
          </p>
        </div>

        <div class="product-grid">
          {products.map((product) => (
            <a class="product" href={product.href}>
              <img src={product.image} alt={product.name} />

              <span>{product.category}</span>

              <h2>{product.name}</h2>

              <p>{product.brand}</p>

              <u>Discover &rarr;</u>
            </a>
          ))}
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #f8f6f1;
    color: #29251f;
    font-family: Arial, sans-serif;
  }

  .kitchen-collection {
    padding: 90px 8% 120px;
    min-height: 70vh;
  }

  .collection-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: end;
    margin-bottom: 55px;
  }

  .collection-parent {
  display: inline-block;
  width: max-content;
  font-size: 11px;
  letter-spacing: 0.28em;
  color: #9a6b3b;
  text-decoration: none;
}

.collection-parent:hover {
  opacity: 0.65;
  }

  .collection-head h1 {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 64px;
    line-height: 1;
    font-weight: 400;
    margin: 20px 0 0;
  }

  .collection-head p {
    max-width: 520px;
    margin: 0;
    color: #8a6848;
    font-size: 17px;
    line-height: 1.6;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .product {
    color: #29251f;
    text-decoration: none;
  }

  .product img {
    width: 100%;
    aspect-ratio: 0.82;
    object-fit: cover;
    display: block;
  }

  .product > span {
    display: block;
    margin-top: 16px;
    font-size: 10px;
    letter-spacing: 0.16em;
    color: #9a6b3b;
    text-transform: uppercase;
  }

  .product h2 {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 24px;
    line-height: 1.3;
    font-weight: 400;
    margin: 8px 0 5px;
  }

  .product p {
    margin: 0 0 14px;
    color: #775d43;
    font-size: 13px;
  }

  .product u {
    font-size: 12px;
    text-underline-offset: 5px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  @media (max-width: 900px) {
    .collection-head {
      grid-template-columns: 1fr;
    }

    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .kitchen-collection {
      padding: 65px 6% 90px;
    }

    .collection-head h1 {
      font-size: 52px;
    }

    .product-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }

    .product h2 {
      font-size: 20px;
    }
  }
</style>