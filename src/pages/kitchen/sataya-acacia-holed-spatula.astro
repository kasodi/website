---
import "../../styles/global.css";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
---

<html lang="en">
  <head>
    <!-- Google Consent Mode -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}

      gtag('consent', 'default', {
        'ad_storage': 'denied',
        'analytics_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'functionality_storage': 'granted',
        'personalization_storage': 'denied',
        'security_storage': 'granted',
        'wait_for_update': 2000
      });
    </script>

    <!-- CookieYes Cookie Banner -->
    <script
      id="cookieyes"
      type="text/javascript"
      src="https://cdn-cookieyes.com/client_data/e9c032e34948c08e8ad6b9973971db36/script.js"
    ></script>

    <!-- Google Analytics -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-LT2BEMKHKC"
    ></script>

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-LT2BEMKHKC');
    </script>

    <title>Sataya Acacia Holed Spatula | KASODI</title>

    <meta
      name="description"
      content="Discover the Sataya Acacia Holed Spatula by Kave Home, crafted from FSC-certified acacia wood and finished with an elegant golden detail."
    />
  </head>

  <body>
    <Header />

    <main class="product-detail-page">

      <!-- Breadcrumbs -->
      <div class="product-breadcrumb">
        <a href="/">Home</a>
        <span>&middot;</span>
        <a href="/kitchen">Kitchen</a>
        <span>&middot;</span>
        <span>SATAYA ACACIA HOLED SPATULA</span>
      </div>

      <!-- Product Hero -->
      <section class="product-detail-hero">

        <div class="product-detail-image">
          <img
            src="/images/kitchen/kave-home-sataya-acacia-holed-spatula.png"
            alt="Sataya Acacia Holed Spatula by Kave Home"
          />
        </div>

        <div class="product-detail-content">

          <p class="product-detail-eyebrow">
            KASODI EDIT &middot; KITCHEN
          </p>

          <h1>Sataya Acacia Holed Spatula</h1>

          <p class="product-detail-brand">Kave Home</p>

          <p class="product-detail-intro">
            A practical kitchen utensil with an unexpectedly refined finish.
            Sataya pairs the natural warmth and individual grain of acacia wood
            with a golden detail that gives an everyday cooking tool a more
            considered character.
          </p>

          <div class="product-detail-divider"></div>

          <div class="product-detail-meta">

            <div>
              <span>Material</span>
              <strong>Acacia wood</strong>
            </div>

            <div>
              <span>Dimensions</span>
              <strong>35.6 &times; 8 &times; 1.9 cm</strong>
            </div>

            <div>
              <span>Colour</span>
              <strong>Brown &middot; Gold</strong>
            </div>

            <div>
              <span>Weight</span>
              <strong>0.12 kg</strong>
            </div>

            <div>
              <span>Certification</span>
              <strong>FSC&trade; 100%</strong>
            </div>

            <div>
              <span>Ideal for</span>
              <strong>Cooking &middot; Serving</strong>
            </div>

          </div>

          <div class="affiliate-action">
            <a
              href="https://kavehome.com/es/en/p/sataya-holed-spatula-made-from-fsc-100-acacia-wood?utm_affaid=kasodi"
              target="_blank"
              rel="nofollow sponsored"
              class="product-shop-button"
            >
              Find It Here &rarr;
            </a>

            <p class="affiliate-note">
              Affiliate link &middot; KASODI may earn a commission at no extra cost to you.
            </p>
          </div>

        </div>
      </section>

      <!-- Why We Love It -->
      <section class="why-we-love">

        <div class="why-we-love-label">
          KASODI NOTE
        </div>

        <div class="why-we-love-content">

          <h2>Why We Love It</h2>

          <p>
            Sataya is a good example of how a small functional object can still
            contribute to the look of a kitchen. The warm acacia wood keeps it
            natural and understated, while the golden detail gives the simple
            utensil a subtle decorative edge.
          </p>

          <p>
            Its distinctive slotted head and natural wood grain make it
            attractive enough to keep visible in a ceramic utensil holder or
            beside a favourite chopping board. Each piece has its own variation
            in grain and tone.
          </p>

        </div>
      </section>

      <!-- Care -->
      <section class="product-care">

        <p class="product-detail-eyebrow">CARE</p>

        <h2>Care for the natural wood</h2>

        <p>
          Hand wash only. Keep away from direct sources of heat and prolonged
          direct sunlight. Avoid abrasive products, acetone, bleach and
          solvents, and protect the surface from sharp objects that may cause
          scratches.
        </p>

      </section>

      <!-- Styling Ideas -->
      <section class="styling-ideas">

        <div class="styling-heading">
          <p>KASODI STYLING</p>
          <h2>Style it with</h2>
        </div>

        <div class="styling-grid">

          <div class="styling-card">
            <span>01</span>
            <h3>Natural Wood</h3>
            <p>
              Pair it with walnut or acacia chopping boards to build a warm,
              layered collection of natural wood tones.
            </p>
          </div>

          <div class="styling-card">
            <span>02</span>
            <h3>Textured Ceramics</h3>
            <p>
              Keep it within reach in a handmade-looking ceramic utensil pot
              in cream, sand or softly speckled stoneware.
            </p>
          </div>

          <div class="styling-card">
            <span>03</span>
            <h3>Warm Metallics</h3>
            <p>
              Echo the golden detail with subtle brass accents rather than
              highly polished metal for a softer, more relaxed kitchen look.
            </p>
          </div>

        </div>
      </section>

      <!-- Continue Exploring -->
      <section class="continue-exploring">

        <div class="continue-exploring-heading">
          <p>KASODI EDIT</p>
          <h2>Continue Exploring</h2>
        </div>

        <div class="continue-exploring-grid">

          <a
            href="/kitchen/rommu-acacia-serving-tray"
            class="continue-card"
          >
            <div class="continue-card-image">
              <img
                src="/images/kitchen/kave-home-rommu-acacia-serving-tray.png"
                alt="Rommu Acacia Wood Serving Tray"
              />
            </div>

            <div class="continue-card-info">
              <span>KITCHEN</span>
              <h3>Rommu Acacia Wood Serving Tray</h3>
              <p>Kave Home</p>
              <strong>Discover &rarr;</strong>
            </div>
          </a>

          <a
            href="/kitchen/nukha-acacia-toast-rack"
            class="continue-card"
          >
            <div class="continue-card-image">
              <img
                src="/images/kitchen/kave-home-nukha-acacia-toast-rack.png"
                alt="Nukha Acacia Toast Rack"
              />
            </div>

            <div class="continue-card-info">
              <span>KITCHEN</span>
              <h3>Nukha Acacia Toast Rack</h3>
              <p>Kave Home</p>
              <strong>Discover &rarr;</strong>
            </div>
          </a>

          <a
            href="/kitchen/cindea-green-marble-mortar-pestle"
            class="continue-card"
          >
            <div class="continue-card-image">
              <img
                src="/images/kitchen/kave-home-cindea-green-marble-mortar-pestle.png"
                alt="Cindea Green Marble Mortar and Pestle"
              />
            </div>

            <div class="continue-card-info">
              <span>KITCHEN</span>
              <h3>Cindea Green Marble Mortar &amp; Pestle</h3>
              <p>Kave Home</p>
              <strong>Discover &rarr;</strong>
            </div>
          </a>

        </div>
      </section>

      <!-- Final CTA -->
      <section class="product-final-cta">

        <p class="product-detail-eyebrow">
          KASODI EDIT &middot; KITCHEN
        </p>

        <h2>Sataya Acacia Holed Spatula</h2>

        <a
          href="https://kavehome.com/es/en/p/sataya-holed-spatula-made-from-fsc-100-acacia-wood?utm_affaid=kasodi"
          target="_blank"
          rel="nofollow sponsored"
          class="product-shop-button"
        >
          Find It Here &rarr;
        </a>

        <p class="affiliate-note affiliate-note-light">
          Affiliate link &middot; KASODI may earn a commission at no extra cost to you.
        </p>

      </section>

    </main>

    <Footer />
  </body>
</html>

