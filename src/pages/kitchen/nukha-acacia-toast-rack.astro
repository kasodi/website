---
import "../../styles/global.css";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
---

<html lang="en">
  <head>
    <!-- Google Consent Mode -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
        functionality_storage: "denied",
        personalization_storage: "denied",
        security_storage: "granted",
        wait_for_update: 2000
      });

      gtag("set", "ads_data_redaction", true);
      gtag("set", "url_passthrough", true);
    </script>

    <!-- Start cookieyes banner -->
    <script
      id="cookieyes"
      type="text/javascript"
      src="https://cdn-cookieyes.com/client_data/e9c032e34948c08e8ad6b9973971db36/script.js"
    ></script>
    <!-- End cookieyes banner -->

    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-LT2BEMKHKC"
    ></script>

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-LT2BEMKHKC');
    </script>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>Nukha Acacia Toast Rack | KASODI</title>

    <meta
      name="description"
      content="Discover the Nukha Acacia Toast Rack by Kave Home, crafted from FSC 100% acacia wood with softly rounded forms and a warm natural finish."
    />
  </head>

  <body>

    <Header />


    <main class="product-detail-page">

      <!-- BREADCRUMBS -->
      <div class="product-breadcrumb">
        <a href="/">Home</a>
        <span>&middot;</span>
        <a href="/kitchen">Kitchen</a>
        <span>&middot;</span>
        <span>NUKHA ACACIA TOAST RACK</span>
      </div>


      <!-- PRODUCT HERO -->
      <section class="product-detail-hero">

        <div class="product-detail-image">
          <img
            src="/images/kitchen/kave-home-nukha-acacia-toast-rack.png"
            alt="Nukha Acacia Toast Rack by Kave Home"
          />
        </div>


        <div class="product-detail-content">

          <p class="product-detail-eyebrow">
            KASODI EDIT &middot; KITCHEN
          </p>

          <h1>
            Nukha Acacia Toast Rack
          </h1>

          <p class="product-detail-brand">
            Kave Home
          </p>

          <p class="product-detail-intro">
            A simple breakfast essential shaped with enough warmth and
            character to stay on display. Nukha pairs solid acacia wood
            with softly rounded forms, turning an everyday toast rack
            into a small sculptural detail for the kitchen or table.
          </p>


          <div class="product-detail-divider"></div>


          <div class="product-detail-meta">

            <div>
              <span>Material</span>
              <strong>Solid acacia wood</strong>
            </div>

            <div>
              <span>Dimensions</span>
              <strong>18 &times; 9 &times; 5.3 cm</strong>
            </div>

            <div>
              <span>Colour</span>
              <strong>Natural wood</strong>
            </div>

            <div>
              <span>Finish</span>
              <strong>Varnished</strong>
            </div>

            <div>
              <span>Certification</span>
              <strong>FSC&trade; 100%</strong>
            </div>

            <div>
              <span>Ideal for</span>
              <strong>Toast &middot; Breakfast table</strong>
            </div>

          </div>


          <div class="affiliate-action">

            <a
              href="https://kavehome.com/es/en/p/nukha-toast-rack-in-fsc-100-acacia-wood?utm_affaid=kasodi"
              target="_blank"
              rel="nofollow sponsored"
              class="product-shop-button"
            >
              Find It Here &rarr;
            </a>

            <p class="affiliate-note">
              Affiliate link &middot; KASODI may earn a commission at no extra cost to you.
            </p>

          </div>

        </div>

      </section>


      <!-- WHY WE LOVE IT -->
      <section class="why-we-love">

        <div class="why-we-love-label">
          KASODI NOTE
        </div>


        <div class="why-we-love-content">

          <h2>
            Why we love it
          </h2>

          <p>
            Nukha takes a very practical kitchen object and gives it a
            beautifully considered silhouette. The repeating rounded
            arches bring rhythm to the design, while the warm grain of
            the acacia keeps it relaxed and natural rather than overly
            polished.
          </p>

          <p>
            Because each piece is made from natural wood, subtle
            variations in tone and texture make every rack slightly
            different. At just 18 cm wide, it is compact enough for an
            everyday breakfast table but distinctive enough to leave
            out between uses.
          </p>

        </div>

      </section>


      <!-- CARE -->
      <section class="product-care">

        <p class="product-detail-eyebrow">
          CARE
        </p>

        <h2>
          Keep the natural wood looking beautiful
        </h2>

        <p>
          Clean gently with a soft cloth and follow the manufacturer's
          care instructions for varnished acacia wood. As this is a
          natural material, variations in grain and colour are part of
          the character of each piece.
        </p>

      </section>


      <!-- STYLE IT WITH -->
      <section class="styling-ideas">

        <div class="styling-heading">

          <p>
            KASODI STYLING
          </p>

          <h2>
            Style it with
          </h2>

        </div>


        <div class="styling-grid">

          <div class="styling-card">

            <span>01</span>

            <h3>
              Textured Linen
            </h3>

            <p>
              Pair the warm acacia with softly rumpled natural linen
              for an easy Mediterranean breakfast setting.
            </p>

          </div>


          <div class="styling-card">

            <span>02</span>

            <h3>
              Handmade Ceramics
            </h3>

            <p>
              Add stoneware plates and small bowls with irregular
              glazes to complement the organic grain of the wood.
            </p>

          </div>


          <div class="styling-card">

            <span>03</span>

            <h3>
              Warm Glassware
            </h3>

            <p>
              Amber or softly tinted glasses bring another layer of
              warmth while keeping the table relaxed and refined.
            </p>

          </div>

        </div>

      </section>


      <!-- CONTINUE EXPLORING -->
      <section class="continue-exploring">

        <div class="continue-exploring-heading">

          <p>
            KASODI EDIT
          </p>

          <h2>
            Continue Exploring
          </h2>

        </div>


        <div class="continue-exploring-grid">

          <a
            href="/kitchen/cindea-green-marble-mortar-pestle"
            class="continue-card"
          >

            <div class="continue-card-image">

              <img
                src="/images/kitchen/kave-home-cindea-green-marble-mortar-pestle.png"
                alt="Cindea Green Marble Mortar and Pestle by Kave Home"
                loading="lazy"
              />

            </div>


            <div class="continue-card-info">

              <span>
                KITCHEN UTENSILS
              </span>

              <h3>
                Cindea Green Marble Mortar &amp; Pestle
              </h3>

              <p>
                Kave Home
              </p>

              <strong>
                Discover &rarr;
              </strong>

            </div>

          </a>


          <a
            href="/kasodi-edit/botanical-vintage-pitcher"
            class="continue-card"
          >

            <div class="continue-card-image">

              <img
                src="/images/kasodi-edit/kasodi-edit-floral-ceramic-pitcher.png"
                alt="Botanical Vintage Pitcher by Ethereal Eves"
                loading="lazy"
              />

            </div>


            <div class="continue-card-info">

              <span>
                SERVING &amp; DECOR
              </span>

              <h3>
                Botanical Vintage Pitcher
              </h3>

              <p>
                Ethereal Eves
              </p>

              <strong>
                Discover &rarr;
              </strong>

            </div>

          </a>


          <a
            href="/tableware/alori-amber-champagne-glass"
            class="continue-card"
          >

            <div class="continue-card-image">

              <img
                src="/images/tableware/kave-home-alori-amber-cava-glass.png"
                alt="Alori Amber Champagne Glass by Kave Home"
                loading="lazy"
              />

            </div>


            <div class="continue-card-info">

              <span>
                TABLEWARE
              </span>

              <h3>
                Alori Amber Champagne Glass
              </h3>

              <p>
                Kave Home
              </p>

              <strong>
                Discover &rarr;
              </strong>

            </div>

          </a>

        </div>

      </section>


      <!-- FINAL CTA -->
      <section class="product-final-cta">

        <p class="product-detail-eyebrow">
          KASODI EDIT &middot; KITCHEN
        </p>

        <h2>
          A small detail for a more considered breakfast table.
        </h2>

        <a
          href="https://kavehome.com/es/en/p/nukha-toast-rack-in-fsc-100-acacia-wood?utm_affaid=kasodi"
          target="_blank"
          rel="nofollow sponsored"
          class="product-shop-button"
        >
          Find It Here &rarr;
        </a>

        <p class="affiliate-note affiliate-note-light">
          Affiliate link &middot; KASODI may earn a commission at no extra cost to you.
        </p>

      </section>

    </main>


    <Footer />

  </body>
</html>