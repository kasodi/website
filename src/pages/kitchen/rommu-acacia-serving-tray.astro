---
import "../../styles/global.css";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
---

<html lang="en">
  <head>
    <!-- Google Consent Mode -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}

      gtag('consent', 'default', {
        'ad_storage': 'denied',
        'analytics_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'functionality_storage': 'granted',
        'personalization_storage': 'denied',
        'security_storage': 'granted',
        'wait_for_update': 2000
      });
    </script>

    <!-- CookieYes Cookie Banner -->
    <script
      id="cookieyes"
      type="text/javascript"
      src="https://cdn-cookieyes.com/client_data/e9c032e34948c08e8ad6b9973971db36/script.js"
    ></script>

    <!-- Google Analytics -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-LT2BEMKHKC"
    ></script>

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-LT2BEMKHKC');
    </script>

    <title>Rommu Acacia Wood Serving Tray | KASODI</title>

    <meta
      name="description"
      content="Discover the Rommu Acacia Wood Serving Tray by Kave Home, a warm solid-wood serving piece with sculptural handles and FSC-certified acacia."
    />
  </head>

  <body>
    <Header />

    <main class="product-detail-page">

      <!-- Breadcrumbs -->
      <div class="product-breadcrumb">
        <a href="/">Home</a>
        <span>&middot;</span>
        <a href="/kitchen">Kitchen</a>
        <span>&middot;</span>
        <span>ROMMU ACACIA WOOD SERVING TRAY</span>
      </div>

      <!-- Product Hero -->
      <section class="product-detail-hero">

        <div class="product-detail-image">
          <img
            src="/images/kitchen/kave-home-rommu-acacia-serving-tray.png"
            alt="Rommu Acacia Wood Serving Tray by Kave Home"
          />
        </div>

        <div class="product-detail-content">

          <p class="product-detail-eyebrow">
            KASODI EDIT &middot; KITCHEN
          </p>

          <h1>Rommu Acacia Wood Serving Tray</h1>

          <p class="product-detail-brand">Kave Home</p>

          <p class="product-detail-intro">
            A generous wooden tray that turns everyday serving into part of the
            table setting. Rommu combines rich acacia grain, a ribbed surface
            and softly curved handles for a warm, considered look.
          </p>

          <div class="product-detail-divider"></div>

          <div class="product-detail-meta">

            <div>
              <span>Material</span>
              <strong>Solid acacia wood</strong>
            </div>

            <div>
              <span>Dimensions</span>
              <strong>50.8 &times; 35.6 &times; 8.3 cm</strong>
            </div>

            <div>
              <span>Colour</span>
              <strong>Brown</strong>
            </div>

            <div>
              <span>Finish</span>
              <strong>Dyed wood</strong>
            </div>

            <div>
              <span>Certification</span>
              <strong>FSC&trade; 100%</strong>
            </div>

            <div>
              <span>Ideal for</span>
              <strong>Serving &middot; Table styling</strong>
            </div>

          </div>

          <div class="affiliate-action">
            <a
              href="https://kavehome.com/es/en/p/rommu-tray-made-of-acacia-wood-fsc-100?utm_affaid=kasodi"
              target="_blank"
              rel="nofollow sponsored"
              class="product-shop-button"
            >
              Find It Here &rarr;
            </a>

            <p class="affiliate-note">
              Affiliate link &middot; KASODI may earn a commission at no extra cost to you.
            </p>
          </div>

        </div>
      </section>

      <!-- Why We Love It -->
      <section class="why-we-love">

        <div class="why-we-love-label">
          KASODI NOTE
        </div>

        <div class="why-we-love-content">

          <h2>Why We Love It</h2>

          <p>
            Rommu is the kind of practical object we like to leave on display.
            The dark acacia wood gives it depth and warmth, while the ribbed
            base and rounded handles add enough detail to make the simple
            rectangular form feel distinctive.
          </p>

          <p>
            Use it for breakfast, drinks or relaxed entertaining, or style it
            permanently on a kitchen counter with a carafe, ceramics and linen.
            Because it is made from natural acacia wood, variations in grain
            and tone make every piece slightly different.
          </p>

        </div>
      </section>

      <!-- Care -->
      <section class="product-care">

        <p class="product-detail-eyebrow">CARE</p>

        <h2>Made for considered everyday use</h2>

        <p>
          Hand wash only. Keep away from direct heat and prolonged direct
          sunlight, and avoid abrasive cleaners, acetone, bleach and solvents
          that could damage the wooden surface.
        </p>

      </section>

      <!-- Styling Ideas -->
      <section class="styling-ideas">

        <div class="styling-heading">
          <p>KASODI STYLING</p>
          <h2>Style it with</h2>
        </div>

        <div class="styling-grid">

          <div class="styling-card">
            <span>01</span>
            <h3>Smoked Glass</h3>
            <p>
              Pair the deep brown acacia with a smoked-glass carafe and
              tumblers for a warm tonal composition.
            </p>
          </div>

          <div class="styling-card">
            <span>02</span>
            <h3>Natural Linen</h3>
            <p>
              Add softly folded linen napkins in cream, oat or muted olive to
              bring texture and lightness to the dark wood.
            </p>
          </div>

          <div class="styling-card">
            <span>03</span>
            <h3>Breakfast Ceramics</h3>
            <p>
              Use it with handmade-looking cups, small bowls and plates for an
              easy Mediterranean breakfast setting.
            </p>
          </div>

        </div>
      </section>

      <!-- Continue Exploring -->
      <section class="continue-exploring">

        <div class="continue-exploring-heading">
          <p>KASODI EDIT</p>
          <h2>Continue Exploring</h2>
        </div>

        <div class="continue-exploring-grid">

          <a
            href="/kitchen/nukha-acacia-toast-rack"
            class="continue-card"
          >
            <div class="continue-card-image">
              <img
                src="/images/kitchen/kave-home-nukha-acacia-toast-rack.png"
                alt="Nukha Acacia Toast Rack"
              />
            </div>

            <div class="continue-card-info">
              <span>KITCHEN</span>
              <h3>Nukha Acacia Toast Rack</h3>
              <p>Kave Home</p>
              <strong>Discover &rarr;</strong>
            </div>
          </a>

          <a
            href="/kitchen/cindea-green-marble-mortar-pestle"
            class="continue-card"
          >
            <div class="continue-card-image">
              <img
                src="/images/kitchen/kave-home-cindea-green-marble-mortar-pestle.png"
                alt="Cindea Green Marble Mortar and Pestle"
              />
            </div>

            <div class="continue-card-info">
              <span>KITCHEN</span>
              <h3>Cindea Green Marble Mortar &amp; Pestle</h3>
              <p>Kave Home</p>
              <strong>Discover &rarr;</strong>
            </div>
          </a>

          <a
            href="/kasodi-edit/botanical-vintage-pitcher"
            class="continue-card"
          >
            <div class="continue-card-image">
              <img
                src="/images/kasodi-edit/kasodi-edit-floral-ceramic-pitcher.png"
                alt="Botanical Vintage Pitcher"
              />
            </div>

            <div class="continue-card-info">
              <span>HOME DECOR</span>
              <h3>Botanical Vintage Pitcher</h3>
              <p>Ethereal Eves</p>
              <strong>Discover &rarr;</strong>
            </div>
          </a>

        </div>
      </section>

      <!-- Final CTA -->
      <section class="product-final-cta">

        <p class="product-detail-eyebrow">
          KASODI EDIT &middot; KITCHEN
        </p>

        <h2>Rommu Acacia Wood Serving Tray</h2>

        <a
          href="https://kavehome.com/es/en/p/rommu-tray-made-of-acacia-wood-fsc-100?utm_affaid=kasodi"
          target="_blank"
          rel="nofollow sponsored"
          class="product-shop-button"
        >
          Find It Here &rarr;
        </a>

        <p class="affiliate-note affiliate-note-light">
          Affiliate link &middot; KASODI may earn a commission at no extra cost to you.
        </p>

      </section>

    </main>

    <Footer />
  </body>
</html>