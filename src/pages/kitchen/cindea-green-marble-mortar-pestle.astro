---
import "../../styles/global.css";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
---

<html lang="en">
  <head>
    <!-- Google Consent Mode -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
        functionality_storage: "denied",
        personalization_storage: "denied",
        security_storage: "granted",
        wait_for_update: 2000
      });

      gtag("set", "ads_data_redaction", true);
      gtag("set", "url_passthrough", true);
    </script>

    <!-- Start cookieyes banner -->
    <script
      id="cookieyes"
      type="text/javascript"
      src="https://cdn-cookieyes.com/client_data/e9c032e34948c08e8ad6b9973971db36/script.js"
    ></script>
    <!-- End cookieyes banner -->

    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-LT2BEMKHKC"
    ></script>

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-LT2BEMKHKC');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Cindea Green Marble Mortar & Pestle | KASODI</title>

    <meta
      name="description"
      content="Discover the Cindea green marble mortar and pestle from Kave Home, selected by KASODI for its rich natural stone, sculptural form and table-worthy design."
    />
  </head>

  <body>

    <Header />


    <main class="product-detail-page">

      <div class="product-breadcrumb">
        <a href="/">Home</a>
        <span>&middot;</span>
        <a href="/kitchen">Kitchen</a>
        <span>&middot;</span>
        <span>Cindea Green Marble Mortar &amp; Pestle</span>
      </div>


      <section class="product-detail-hero">

        <div class="product-detail-image">
          <img
            src="/images/kitchen/kave-home-cindea-green-marble-mortar-pestle.png"
            alt="Cindea green marble mortar and pestle styled in a warm KASODI kitchen"
          />
        </div>


        <div class="product-detail-content">

          <p class="product-detail-eyebrow">
            KASODI EDIT &middot; KITCHEN
          </p>

          <h1>
            Cindea Green Marble Mortar &amp; Pestle
          </h1>

          <p class="product-detail-brand">
            Kave Home
          </p>

          <p class="product-detail-intro">
            A kitchen essential with enough character to live permanently on
            display. Cindea is carved from green marble, combining the natural
            variation of stone with a weighty, sculptural silhouette that moves
            easily from food preparation to the table.
          </p>


          <div class="product-detail-divider"></div>


          <div class="product-detail-meta">

            <div>
              <span>Material</span>
              <strong>100% marble</strong>
            </div>

            <div>
              <span>Colour</span>
              <strong>Green</strong>
            </div>

            <div>
              <span>Dimensions</span>
              <strong>12.5 &times; 12.5 &times; 13 cm</strong>
            </div>

            <div>
              <span>Weight</span>
              <strong>1.6 kg</strong>
            </div>

            <div>
              <span>Set</span>
              <strong>2 pieces</strong>
            </div>

            <div>
              <span>Use</span>
              <strong>Indoor &middot; Kitchen</strong>
            </div>

          </div>


          <div class="affiliate-action">

            <a
              href="https://kavehome.com/es/en/p/cindea-pestle-and-mortar-in-green-marble?utm_affaid=kasodi"
              target="_blank"
              rel="nofollow sponsored"
              class="product-shop-button"
            >
              Find It Here &rarr;
            </a>

            <p class="affiliate-note">
              Affiliate link &middot; KASODI may earn a commission at no extra cost to you.
            </p>

          </div>

        </div>

      </section>


      <section class="why-we-love">

        <div class="why-we-love-label">
          KASODI NOTE
        </div>

        <div class="why-we-love-content">

          <h2>Why we love it</h2>

          <p>
            Cindea turns one of the most traditional kitchen tools into an object
            worth leaving on the worktop. The deep green marble brings colour
            and natural variation, while the simple rounded form keeps it
            understated.
          </p>

          <p>
            We especially like that it can move straight from the kitchen to
            the table. Use it for sauces, herbs or salsa, then let the marble
            become part of the setting rather than hiding it away after cooking.
          </p>

        </div>

      </section>


      <section class="product-care">

        <p class="product-detail-eyebrow">
          CARE
        </p>

        <h2>Care for the natural marble</h2>

        <p>
          Hand wash only and dry carefully after cleaning. Do not place in the
          dishwasher or microwave. As marble is a natural material, variations
          in tone and veining are part of its individual character.
        </p>

      </section>


      <section class="styling-ideas">

        <div class="styling-heading">
          <p>KASODI STYLING</p>
          <h2>Style it with</h2>
        </div>


        <div class="styling-grid">

          <div class="styling-card">
            <span>01</span>
            <h3>Warm Wood</h3>
            <p>
              Pair the cool green marble with acacia or walnut boards for a
              warmer, more tactile kitchen arrangement.
            </p>
          </div>


          <div class="styling-card">
            <span>02</span>
            <h3>Amber Glass</h3>
            <p>
              Amber and olive-toned glassware brings out the darker veining in
              the marble and creates a rich Mediterranean palette.
            </p>
          </div>


          <div class="styling-card">
            <span>03</span>
            <h3>Natural Linen</h3>
            <p>
              Soft ivory or flax linen keeps the setting relaxed and allows the
              distinctive green stone to remain the focal point.
            </p>
          </div>

        </div>

      </section>


      <section class="continue-exploring">

        <div class="continue-exploring-heading">
          <p>KASODI EDIT</p>
          <h2>Continue Exploring</h2>
        </div>

        <div class="continue-exploring-grid">


          <a
            href="/tableware/talara-carved-glass-decanter"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/tableware/kave-home-talora-carved-glass-decanter.png"
                alt="Talora Carved Glass Decanter"
              />
            </div>

            <div class="continue-card-info">
              <span>TABLEWARE</span>
              <h3>Talora Carved Glass Decanter</h3>
              <p>Kave Home</p>
              <strong>Discover &rarr;</strong>
            </div>

          </a>


          <a
            href="/tableware/alori-amber-champagne-glass"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/tableware/kave-home-alori-amber-cava-glass.png"
                alt="Alori Amber Champagne Glass"
              />
            </div>

            <div class="continue-card-info">
              <span>GLASSWARE</span>
              <h3>Alori Amber Champagne Glass</h3>
              <p>Kave Home</p>
              <strong>Discover &rarr;</strong>
            </div>

          </a>


          <a
            href="/home-decor/lurea-sculptural-glass-centrepiece"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/home-decor/kave-home-lurea-sculptural-glass-centrepiece.png"
                alt="Lurea Sculptural Glass Centrepiece"
              />
            </div>

            <div class="continue-card-info">
              <span>DECORATIVE OBJECTS</span>
              <h3>Lurea Sculptural Glass Centrepiece</h3>
              <p>Kave Home</p>
              <strong>Discover &rarr;</strong>
            </div>

          </a>

        </div>

      </section>


      <section class="product-final-cta">

        <p class="product-detail-eyebrow">
          KAVE HOME &middot; CINDEA
        </p>

        <h2>
          Natural marble made for the kitchen and the table.
        </h2>

        <a
          href="https://kavehome.com/es/en/p/cindea-pestle-and-mortar-in-green-marble?utm_affaid=kasodi"
          target="_blank"
          rel="nofollow sponsored"
          class="product-shop-button"
        >
          Find It Here &rarr;
        </a>

        <p class="affiliate-note affiliate-note-light">
          Affiliate link &middot; KASODI may earn a commission at no extra cost to you.
        </p>

      </section>

    </main>


    <Footer />

  </body>
</html>