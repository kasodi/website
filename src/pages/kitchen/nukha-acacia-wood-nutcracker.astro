---
import "../../styles/global.css";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
---

<html lang="en">
  <head>
    <!-- Google Consent Mode -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];

      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("consent", "default", {
        ad_storage: "denied",
        analytics_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        functionality_storage: "granted",
        personalization_storage: "granted",
        security_storage: "granted",
        wait_for_update: 2000,
      });
    </script>

    <!-- CookieYes -->
    <script
      id="cookieyes"
      type="text/javascript"
      src="https://cdn-cookieyes.com/client_data/e9c032e34948c08e8ad6b9973971db36/script.js"
    ></script>

    <!-- Google Analytics -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-LT2BEMKHKC"
    ></script>

    <script is:inline>
      window.dataLayer = window.dataLayer || [];

      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("js", new Date());
      gtag("config", "G-LT2BEMKHKC");
    </script>

    <title>Nukha Acacia Wood Nutcracker | KASODI</title>

    <meta
      name="description"
      content="Discover the Nukha Acacia Wood Nutcracker by Kave Home, a sculptural kitchen accessory crafted from FSC 100% acacia wood with warm natural grain."
    />
  </head>

  <body>
    <Header />

    <main class="product-detail-page">

      <!-- Breadcrumbs -->
      <div class="product-breadcrumb">
        <a href="/">Home</a>
        <span>&middot;</span>
        <a href="/kitchen/kitchen-essentials">Kitchen Essentials</a>
        <span>&middot;</span>
        <span>NUKHA ACACIA WOOD NUTCRACKER</span>
      </div>

      <!-- Product Hero -->
      <section class="product-detail-hero">

        <div class="product-detail-image">
          <img
            src="/images/kitchen/kave-home-nukha-acacia-wood-nutcracker.png"
            alt="Nukha Acacia Wood Nutcracker by Kave Home"
          />
        </div>

        <div class="product-detail-content">

          <p class="product-detail-eyebrow">
            KASODI EDIT &middot; KITCHEN
          </p>

          <h1>Nukha Acacia Wood Nutcracker</h1>

          <p class="product-detail-brand">Kave Home</p>

          <p class="product-detail-intro">
            A beautifully sculptural take on an everyday kitchen tool.
            Crafted from solid acacia wood, the Nukha nutcracker combines
            rounded organic forms with the warmth and character of natural
            wood grain.
          </p>

          <div class="product-detail-divider"></div>

          <div class="product-detail-meta">

            <div>
              <span>Material</span>
              <strong>100% Acacia Wood</strong>
            </div>

            <div>
              <span>Dimensions</span>
              <strong>10.5 &times; 10.5 &times; 11.55 cm</strong>
            </div>

            <div>
              <span>Colour</span>
              <strong>Natural</strong>
            </div>

            <div>
              <span>Finish</span>
              <strong>Varnished</strong>
            </div>

            <div>
              <span>Certification</span>
              <strong>FSC&trade; 100%</strong>
            </div>

            <div>
              <span>Weight</span>
              <strong>0.21 kg</strong>
            </div>

          </div>

          <div class="affiliate-action">

            <a
              href="https://kavehome.com/es/en/p/nukha-nutcracker-in-fsc-100-acacia-wood?utm_affaid=kasodi"
              target="_blank"
              rel="nofollow sponsored"
              class="product-shop-button"
            >
              Find It Here &rarr;
            </a>

            <p class="affiliate-note">
              Affiliate link &middot; KASODI may earn a commission at no extra cost to you.
            </p>

          </div>

        </div>

      </section>


      <!-- Why We Love It -->
      <section class="why-we-love">

        <div class="why-we-love-label">
          KASODI NOTE
        </div>

        <div class="why-we-love-content">

          <h2>Why we love it</h2>

          <p>
            The Nukha nutcracker turns a simple kitchen utensil into an
            object worth leaving on display. Its rounded silhouette feels
            almost sculptural, while the rich acacia grain gives every
            piece its own natural variation and character.
          </p>

          <p>
            We especially like it styled on an open kitchen shelf or
            brought directly to the table with a bowl of walnuts. It is
            functional, tactile and decorative at the same time &mdash;
            exactly the kind of small detail that makes everyday rituals
            feel more considered.
          </p>

        </div>

      </section>


      <!-- Care -->
      <section class="product-care">

        <p class="product-detail-eyebrow">
          CARE
        </p>

        <h2>Keep the natural wood beautiful</h2>

        <p>
          Clean gently and avoid abrasive products or prolonged exposure
          to moisture. As acacia is a natural material, variations in tone
          and grain are part of the character of each piece.
        </p>

      </section>


      <!-- Styling Ideas -->
      <section class="styling-ideas">

        <div class="styling-heading">

          <p>KASODI STYLING</p>

          <h2>Style it with</h2>

        </div>

        <div class="styling-grid">

          <div class="styling-card">

            <span>01</span>

            <h3>Natural Stone</h3>

            <p>
              Place it on a warm stone or travertine surface to highlight
              the rich tones and organic grain of the acacia wood.
            </p>

          </div>

          <div class="styling-card">

            <span>02</span>

            <h3>Handmade Ceramics</h3>

            <p>
              Pair it with earthy ceramic bowls filled with walnuts for
              an effortless Mediterranean kitchen arrangement.
            </p>

          </div>

          <div class="styling-card">

            <span>03</span>

            <h3>Natural Linen</h3>

            <p>
              Add softly textured linen in cream or muted green to create
              a relaxed setting built around warm natural materials.
            </p>

          </div>

        </div>

      </section>


      <!-- Continue Exploring -->
      <section class="continue-exploring">

        <div class="continue-exploring-heading">

          <p>KASODI EDIT</p>

          <h2>Continue Exploring</h2>

        </div>

        <div class="continue-exploring-grid">

          <!-- Card 1 -->
          <a
            href="/kitchen/cindea-green-marble-mortar-pestle"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/kitchen/kave-home-cindea-green-marble-mortar-pestle.png"
                alt="Cindea Green Marble Mortar and Pestle"
              />
            </div>

            <div class="continue-card-info">

              <span>KITCHEN</span>

              <h3>Cindea Green Marble Mortar &amp; Pestle</h3>

              <p>Kave Home</p>

              <strong>Discover &rarr;</strong>

            </div>

          </a>


          <!-- Card 2 -->
          <a
            href="/kitchen/nukha-acacia-toast-rack"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/kitchen/kave-home-nukha-acacia-toast-rack.png"
                alt="Nukha Acacia Toast Rack"
              />
            </div>

            <div class="continue-card-info">

              <span>KITCHEN</span>

              <h3>Nukha Acacia Toast Rack</h3>

              <p>Kave Home</p>

              <strong>Discover &rarr;</strong>

            </div>

          </a>


          <!-- Card 3 -->
          <a
            href="/tableware/alori-amber-champagne-glass"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/tableware/kave-home-alori-amber-cava-glass.png"
                alt="Alori Amber Champagne Glass"
              />
            </div>

            <div class="continue-card-info">

              <span>TABLEWARE</span>

              <h3>Alori Amber Champagne Glass</h3>

              <p>Kave Home</p>

              <strong>Discover &rarr;</strong>

            </div>

          </a>

        </div>

      </section>


      <!-- Final CTA -->
      <section class="product-final-cta">

        <p class="product-detail-eyebrow">
          KASODI EDIT &middot; KITCHEN
        </p>

        <h2>A small kitchen object with natural character.</h2>

        <a
          href="https://kavehome.com/es/en/p/nukha-nutcracker-in-fsc-100-acacia-wood?utm_affaid=kasodi"
          target="_blank"
          rel="nofollow sponsored"
          class="product-shop-button"
        >
          Find It Here &rarr;
        </a>

        <p class="affiliate-note affiliate-note-light">
          Affiliate link &middot; KASODI may earn a commission at no extra cost to you.
        </p>

      </section>

    </main>

    <Footer />

  </body>
</html>