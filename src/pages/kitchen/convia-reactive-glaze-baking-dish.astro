---
import "../../styles/global.css";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
---

<html lang="en">
  <head>
    <!-- Google Consent Mode -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];

      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("consent", "default", {
        ad_storage: "denied",
        analytics_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        functionality_storage: "granted",
        personalization_storage: "granted",
        security_storage: "granted",
        wait_for_update: 2000,
      });
    </script>

    <!-- CookieYes -->
    <script
      id="cookieyes"
      type="text/javascript"
      src="https://cdn-cookieyes.com/client_data/e9c032e34948c08e8ad6b9973971db36/script.js"
    ></script>

    <!-- Google Analytics -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-LT2BEMKHKC"
    ></script>

    <script is:inline>
      window.dataLayer = window.dataLayer || [];

      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("js", new Date());
      gtag("config", "G-LT2BEMKHKC");
    </script>

    <title>Convia Reactive Glaze Baking Dish | KASODI</title>

    <meta
      name="description"
      content="Discover the Convia Reactive Glaze Baking Dish by Kave Home, a lidded ceramic baking dish made in Portugal with a distinctive white and brown reactive glaze."
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />

    <meta
      property="og:title"
      content="Convia Reactive Glaze Baking Dish | KASODI"
    />

    <meta
      property="og:description"
      content="A beautifully finished ceramic baking dish with a distinctive white and brown reactive glaze. Made in Portugal and selected for the KASODI Kitchen Edit."
    />

    <meta
      property="og:url"
      content="https://kasodi.com/kitchen/convia-reactive-glaze-baking-dish"
    />

    <meta
      property="og:image"
      content="https://kasodi.com/images/convia-reactive-glaze-baking-dish-facebook.png"
    />

    <meta
      property="og:image:alt"
      content="Convia Reactive Glaze Baking Dish selected by KASODI"
    />

    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter / Social -->
    <meta name="twitter:card" content="summary_large_image" />

    <meta
      name="twitter:title"
      content="Convia Reactive Glaze Baking Dish | KASODI"
    />

    <meta
      name="twitter:description"
      content="A beautifully finished ceramic baking dish with a distinctive white and brown reactive glaze. Made in Portugal and selected for the KASODI Kitchen Edit."
    />

    <meta
      name="twitter:image"
      content="https://kasodi.com/images/convia-reactive-glaze-baking-dish-facebook.png"
    />
  </head>

  <body>
    <Header />

    <main class="product-detail-page">

      <!-- Breadcrumbs -->
      <div class="product-breadcrumb">
        <a href="/">Home</a>
        <span>&middot;</span>
        <a href="/kitchen/kitchen-essentials">Kitchen Essentials</a>
        <span>&middot;</span>
        <span>CONVIA REACTIVE GLAZE BAKING DISH</span>
      </div>

      <!-- Product Hero -->
      <section class="product-detail-hero">

        <div class="product-detail-image">
          <img
            src="/images/kitchen/kave-home-convia-reactive-glaze-baking-dish.png"
            alt="Convia Reactive Glaze Baking Dish by Kave Home"
          />
        </div>

        <div class="product-detail-content">

          <p class="product-detail-eyebrow">
            KASODI EDIT &middot; KITCHEN
          </p>

          <h1>Convia Reactive Glaze Baking Dish</h1>

          <p class="product-detail-brand">Kave Home</p>

          <p class="product-detail-intro">
            A beautifully finished ceramic baking dish designed to move
            effortlessly from oven to table. Its soft white surface is
            scattered with warm brown markings created by reactive glazes,
            giving every piece its own subtle variations and character.
          </p>

          <div class="product-detail-divider"></div>

          <div class="product-detail-meta">

            <div>
              <span>Material</span>
              <strong>100% Ceramic</strong>
            </div>

            <div>
              <span>Capacity</span>
              <strong>1 L</strong>
            </div>

            <div>
              <span>Colour</span>
              <strong>White &middot; Brown</strong>
            </div>

            <div>
              <span>Finish</span>
              <strong>Reactive Glaze</strong>
            </div>

            <div>
              <span>Design</span>
              <strong>Round &middot; With Lid</strong>
            </div>

            <div>
              <span>Made in</span>
              <strong>Portugal</strong>
            </div>

          </div>

          <div class="affiliate-action">

            <a
              href="https://kavehome.com/es/en/p/convia-baking-dish-in-white-and-brown-ceramic-1-l?utm_affaid=kasodi"
              target="_blank"
              rel="nofollow sponsored"
              class="product-shop-button"
            >
              Find It Here &rarr;
            </a>

            <p class="affiliate-note">
              Affiliate link &middot; KASODI may earn a commission at no extra cost to you.
            </p>

          </div>

        </div>

      </section>


      <!-- Why We Love It -->
      <section class="why-we-love">

        <div class="why-we-love-label">
          KASODI NOTE
        </div>

        <div class="why-we-love-content">

          <h2>Why we love it</h2>

          <p>
            Convia is the kind of practical kitchen piece that deserves
            to stay in view. The softly mottled reactive glaze gives the
            ceramic depth and character, while the warm white and brown
            palette feels natural, understated and easy to combine with
            other tableware.
          </p>

          <p>
            Because the reactive glazing process creates subtle variations
            in shade and pattern, each piece has its own individual finish.
            We especially like the idea of bringing it straight to the
            table, where the covered form feels as decorative as it is
            functional.
          </p>

        </div>

      </section>


      <!-- Care -->
      <section class="product-care">

        <p class="product-detail-eyebrow">
          CARE
        </p>

        <h2>Care for the reactive glaze</h2>

        <p>
          Hand wash as recommended by the maker. Handle the ceramic with
          care and avoid abrasive cleaning products to help preserve the
          distinctive glazed surface.
        </p>

      </section>


      <!-- Styling Ideas -->
      <section class="styling-ideas">

        <div class="styling-heading">

          <p>KASODI STYLING</p>

          <h2>Style it with</h2>

        </div>

        <div class="styling-grid">

          <div class="styling-card">

            <span>01</span>

            <h3>Natural Linen</h3>

            <p>
              Pair the warm speckled ceramic with relaxed cream or
              olive-striped linen for an effortless Mediterranean table.
            </p>

          </div>

          <div class="styling-card">

            <span>02</span>

            <h3>Warm Wood</h3>

            <p>
              Serve it on a rustic wooden board or alongside acacia
              accessories to bring out the earthy brown tones in the glaze.
            </p>

          </div>

          <div class="styling-card">

            <span>03</span>

            <h3>Green Glass</h3>

            <p>
              Add textured green glassware for a richer table setting
              that contrasts beautifully with the soft neutral ceramic.
            </p>

          </div>

        </div>

      </section>


      <!-- Continue Exploring -->
      <section class="continue-exploring">

        <div class="continue-exploring-heading">

          <p>KASODI EDIT</p>

          <h2>Continue Exploring</h2>

        </div>

        <div class="continue-exploring-grid">

          <!-- Card 1 -->
          <a
            href="/kitchen/cindea-green-marble-mortar-pestle"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/kitchen/kave-home-cindea-green-marble-mortar-pestle.png"
                alt="Cindea Green Marble Mortar and Pestle"
              />
            </div>

            <div class="continue-card-info">

              <span>KITCHEN</span>

              <h3>Cindea Green Marble Mortar &amp; Pestle</h3>

              <p>Kave Home</p>

              <strong>Discover &rarr;</strong>

            </div>

          </a>


          <!-- Card 2 -->
          <a
            href="/kitchen/nukha-acacia-wood-nutcracker"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/kitchen/kave-home-nukha-acacia-wood-nutcracker.png"
                alt="Nukha Acacia Wood Nutcracker"
              />
            </div>

            <div class="continue-card-info">

              <span>KITCHEN</span>

              <h3>Nukha Acacia Wood Nutcracker</h3>

              <p>Kave Home</p>

              <strong>Discover &rarr;</strong>

            </div>

          </a>


          <!-- Card 3 -->
          <a
            href="/kitchen/nukha-acacia-toast-rack"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/kitchen/kave-home-nukha-acacia-toast-rack.png"
                alt="Nukha Acacia Toast Rack"
              />
            </div>

            <div class="continue-card-info">

              <span>KITCHEN</span>

              <h3>Nukha Acacia Toast Rack</h3>

              <p>Kave Home</p>

              <strong>Discover &rarr;</strong>

            </div>

          </a>

        </div>

      </section>


      <!-- Final CTA -->
      <section class="product-final-cta">

        <p class="product-detail-eyebrow">
          KASODI EDIT &middot; KITCHEN
        </p>

        <h2>Beautiful ceramic made for cooking and serving.</h2>

        <a
          href="https://kavehome.com/es/en/p/convia-baking-dish-in-white-and-brown-ceramic-1-l?utm_affaid=kasodi"
          target="_blank"
          rel="nofollow sponsored"
          class="product-shop-button"
        >
          Find It Here &rarr;
        </a>

        <p class="affiliate-note affiliate-note-light">
          Affiliate link &middot; KASODI may earn a commission at no extra cost to you.
        </p>

      </section>

    </main>

    <Footer />

  </body>
</html>