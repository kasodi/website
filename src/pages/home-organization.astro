    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>Home Organization | KASODI</title>

    <meta
      name="description"
      content="Discover KASODI's curated approach to home organization — beautiful storage, thoughtful organizers and practical pieces designed to bring calm and order to everyday spaces."
    />
  </head>

  <body>

    <!-- HEADER -->
    <Header />


    <main>

      <!-- BREADCRUMBS -->
      <div class="breadcrumbs">
        <a href="/">Home</a>
        <span>·</span>
        <span>Home Organization</span>
      </div>


      <!-- CATEGORY INTRO -->
      <section class="category-intro">

        <p class="eyebrow">
          KASODI · HOME ORGANIZATION
        </p>

        <h1>
          Beautiful Order<br />
          for Everyday Living
        </h1>

        <p class="category-description">
          Thoughtful storage and organization pieces chosen to bring
          a sense of calm to everyday spaces — practical enough to make
          life easier and beautiful enough to become part of the room.
        </p>

      </section>


      <!-- EDITORIAL INTRO -->
      <section class="organization-section">

        <div class="organization-grid">

          <div class="organization-item">
            <span>01</span>
            <h2>Beautiful Storage</h2>
            <p>
              Baskets, boxes and containers that help keep everyday
              essentials close without adding visual clutter.
            </p>
          </div>


          <div class="organization-item">
            <span>02</span>
            <h2>Thoughtful Details</h2>
            <p>
              Small organizers and useful objects selected for their
              materials, proportions and ability to work naturally
              within a beautiful interior.
            </p>
          </div>


          <div class="organization-item">
            <span>03</span>
            <h2>Everyday Calm</h2>
            <p>
              Simple solutions for kitchens, bathrooms, bedrooms and
              living spaces that make daily routines feel a little
              easier and more considered.
            </p>
          </div>

        </div>

      </section>


      <!-- EDITORIAL -->
      <section class="editorial-section">

        <div class="editorial-inner">

          <p class="eyebrow">
            THE KASODI APPROACH
          </p>

          <h2>
            Practical things deserve<br />
            to be beautiful too.
          </h2>

          <p>
            Organization should not make a home feel clinical. We look
            for useful pieces with warm materials, considered shapes and
            quiet details — objects that create order while still feeling
            like a natural part of the interior.
          </p>

        </div>

      </section>

    </main>


    <Footer />

  </body>
</html>


<style>

  :global(*) {
    box-sizing: border-box;
  }


  :global(body) {
    margin: 0;
    background: #f8f6f1;
    color: #29251f;
  }


  /* HEADER */

  .site-header {
    height: 96px;
    padding: 0 4%;

    display: flex;
    align-items: center;
    justify-content: space-between;

    border-bottom: 1px solid rgba(41, 37, 31, 0.09);
    background: #f8f6f1;
  }


  .logo {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 31px;
    letter-spacing: 0.17em;
    color: #29251f;
    text-decoration: none;
  }


  .main-nav {
    display: flex;
    align-items: center;
    gap: 38px;
  }


  .main-nav a {
    color: #29251f;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 11px;
  }


  /* BREADCRUMBS */

  .breadcrumbs {
    width: min(1400px, 92%);
    margin: 34px auto 0;

    display: flex;
    gap: 10px;
    align-items: center;

    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #887b6c;
  }


  .breadcrumbs a {
    color: inherit;
    text-decoration: none;
  }


  /* INTRO */

  .category-intro {
    width: min(1400px, 92%);
    padding: 95px 0 110px;
    margin: 0 auto;
    text-align: center;
  }


  .eyebrow {
    margin: 0 0 25px;
    color: #9a7654;

    font-size: 10px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }


  .category-intro h1 {
    max-width: 900px;
    margin: 0 auto 35px;

    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(48px, 6vw, 82px);
    font-weight: 400;
    line-height: 1.03;
    letter-spacing: -0.025em;
  }


  .category-description {
    max-width: 690px;
    margin: 0 auto;

    font-size: 16px;
    line-height: 1.8;
    color: #62594f;
  }


  /* ORGANIZATION INTRO */

  .organization-section {
    width: min(1400px, 92%);
    margin: 0 auto;
    padding: 0 0 130px;
  }


  .organization-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid rgba(41, 37, 31, 0.15);
    border-bottom: 1px solid rgba(41, 37, 31, 0.15);
  }


  .organization-item {
    padding: 50px 42px 55px;
  }


  .organization-item + .organization-item {
    border-left: 1px solid rgba(41, 37, 31, 0.15);
  }


  .organization-item > span {
    display: block;
    margin-bottom: 38px;

    color: #9a7654;
    font-size: 10px;
    letter-spacing: 0.2em;
  }


  .organization-item h2 {
    margin: 0 0 18px;

    font-family: Georgia, "Times New Roman", serif;
    font-size: 29px;
    line-height: 1.2;
    font-weight: 400;
  }


  .organization-item p {
    max-width: 330px;
    margin: 0;

    color: #62594f;
    font-size: 14px;
    line-height: 1.75;
  }


  /* EDITORIAL */

  .editorial-section {
    padding: 120px 5%;
    background: #e9e2d6;
  }


  .editorial-inner {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }


  .editorial-inner h2 {
    margin: 0 0 30px;

    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(38px, 5vw, 58px);
    line-height: 1.08;
    font-weight: 400;
  }


  .editorial-inner > p:last-child {
    max-width: 620px;
    margin: 0 auto;

    color: #62594f;
    font-size: 15px;
    line-height: 1.8;
  }


  /* RESPONSIVE */

  @media (max-width: 900px) {

    .organization-grid {
      grid-template-columns: 1fr;
    }


    .organization-item + .organization-item {
      border-left: none;
      border-top: 1px solid rgba(41, 37, 31, 0.15);
    }

  }


  @media (max-width: 760px) {

    .site-header {
      height: auto;
      padding: 25px 5%;
    }


    .main-nav {
      display: none;
    }


    .category-intro {
      padding: 70px 0 80px;
    }


    .category-intro h1 {
      font-size: 48px;
    }


    .organization-section {
      padding-bottom: 90px;
    }


    .organization-item {
      padding: 40px 20px;
    }


    .editorial-section {
      padding: 85px 7%;
    }

  }

</style>