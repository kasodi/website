---
import "../../styles/global.css";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <!-- Google Consent Mode -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}

      gtag('consent', 'default', {
        'analytics_storage': 'denied',
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'wait_for_update': 500
      });
    </script>

    <!-- CookieYes -->
    <script
      id="cookieyes"
      type="text/javascript"
      src="https://cdn-cookieyes.com/client_data/7b4b6d349a42e046975a63e4/script.js"
    ></script>

    <!-- Google Analytics -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-2VBVEW2NGJ"
    ></script>

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-2VBVEW2NGJ');
    </script>

    <title>Ovelin Burgundy Velvet Cushion Cover | KASODI</title>

    <meta
      name="description"
      content="Discover the Ovelin burgundy velvet cushion cover by Kave Home, selected by KASODI for its rich cotton velvet, contrasting trim and reversible two-tone design."
    />
     <style>
  .product-detail-hero {
    align-items: start;
    padding-bottom: 0;
  }

  .product-detail-image {
    overflow: hidden;
    background: #eee9e1;
    align-self: stretch;
  }

  .product-detail-image img {
  width: 100%;
  height: 100%;
  min-height: 720px;
  aspect-ratio: auto;
  object-fit: cover;
  object-position: center 68%;
  transform: scale(1.12);
  display: block;
  }
</style>
  </head>

  <body>
    <Header />

    <main class="product-detail-page">

      <div class="product-breadcrumb">
        <a href="/">HOME</a>
        <span>&middot;</span>
        <a href="/textiles-cozy">TEXTILES &amp; COZY</a>
        <span>&middot;</span>
        <span>OVELIN BURGUNDY VELVET CUSHION COVER</span>
      </div>

      <section class="product-detail-hero">

        <div class="product-detail-image">
          <img
            src="/images/textiles-cozy/kave-home-ovelin-burgundy-velvet-cushion-cover.png"
            alt="Ovelin burgundy velvet cushion cover by Kave Home"
          />
        </div>

        <div class="product-detail-content">

          <p class="product-detail-eyebrow">
            KASODI EDIT &middot; TEXTILES
          </p>

          <h1>Ovelin Burgundy Velvet Cushion Cover</h1>

          <p class="product-detail-brand">Kave Home</p>

          <p class="product-detail-intro">
            A richly coloured cotton velvet cushion cover with a soft,
            tactile finish and contrasting trim. Ovelin combines deep
            burgundy tones with a simple rectangular silhouette, bringing
            warmth and understated colour to sofas, armchairs and layered
            cushion arrangements.
          </p>

          <div class="product-detail-divider"></div>

          <div class="product-detail-meta">

            <div>
              <span>MATERIAL</span>
              <strong>100% Cotton Velvet</strong>
            </div>

            <div>
              <span>DIMENSIONS</span>
              <strong>30 &times; 50 cm</strong>
            </div>

            <div>
              <span>COLOUR</span>
              <strong>Burgundy &middot; Ecru</strong>
            </div>

            <div>
              <span>DETAIL</span>
              <strong>Contrast Piping</strong>
            </div>

            <div>
              <span>CLOSURE</span>
              <strong>Zipper</strong>
            </div>

            <div>
              <span>FILLING</span>
              <strong>Sold Separately</strong>
            </div>

          </div>

          <div class="affiliate-action">
            <a
              href="https://kavehome.com/es/en/p/ovelin-maroon-and-ecru-velvet-cushion-cover-30-x-50-cm?utm_affaid=kasodi"
              target="_blank"
              rel="nofollow sponsored"
              class="product-shop-button"
            >
              Find It Here &rarr;
            </a>

            <p class="affiliate-note">
              Affiliate link &middot; KASODI may earn a commission at no extra cost to you.
            </p>
          </div>

        </div>

      </section>


      <section class="why-we-love">

        <div class="why-we-love-label">
          KASODI NOTE
        </div>

        <div class="why-we-love-content">

          <h2>Why We Love It</h2>

          <p>
            Ovelin proves that a simple cushion can bring a surprising amount
            of character to a room. The deep burgundy cotton velvet feels rich
            and tactile, while the contrasting piping gives the rectangular
            silhouette a crisp, considered finish.
          </p>

          <p>
            We especially like its two-tone construction, with each side
            offering a different colour expression. The 30 &times; 50 cm format
            also makes it easy to layer with larger neutral cushions, adding
            depth and colour without overwhelming a sofa or armchair.
          </p>

        </div>

      </section>


      <section class="product-care">

        <p class="product-detail-eyebrow">
          CARE
        </p>

        <h2>Keep the velvet looking beautiful</h2>

        <p>
          Wash cold below 30&deg;C. Do not bleach or tumble dry. The cover can
          be ironed at medium temperature. Keep away from direct heat and
          prolonged direct sunlight, and avoid abrasive cleaning products.
          Cushion filling is sold separately.
        </p>

      </section>


      <section class="styling-ideas">

        <div class="styling-heading">
          <p>KASODI STYLING</p>
          <h2>Style it with</h2>
        </div>

        <div class="styling-grid">

          <div class="styling-card">
            <span>01</span>
            <h3>Natural Linen</h3>
            <p>
              Layer Ovelin against cream, oatmeal or warm beige linen cushions
              to let the burgundy velvet become the focal point.
            </p>
          </div>

          <div class="styling-card">
            <span>02</span>
            <h3>Dark Wood</h3>
            <p>
              Walnut and other warm dark woods echo the richness of the
              burgundy tone and create a more collected, intimate setting.
            </p>
          </div>

          <div class="styling-card">
            <span>03</span>
            <h3>Soft Textures</h3>
            <p>
              Add a cream wool or boucle throw to contrast with the smooth
              velvet and build a comfortable layered look.
            </p>
          </div>

        </div>

      </section>


      <section class="continue-exploring">

        <div class="continue-exploring-heading">
          <p>KASODI EDIT</p>
          <h2>Continue Exploring</h2>
        </div>

        <div class="continue-exploring-grid">

          <a
            href="/home-decor/drava-burgundy-ceramic-table-lamp"
            class="continue-card"
          >
            <div class="continue-card-image">
              <img
                src="/images/home-decor/kave-home-drava-burgundy-ceramic-table-lamp.png"
                alt="Drava Burgundy Ceramic Table Lamp"
              />
            </div>

            <div class="continue-card-info">
              <span>LIGHTING</span>
              <h3>Drava Burgundy Ceramic Table Lamp</h3>
              <p>Kave Home</p>
              <strong>Discover &rarr;</strong>
            </div>
          </a>


          <a
            href="/home-decor/lurea-sculptural-glass-centrepiece"
            class="continue-card"
          >
            <div class="continue-card-image">
              <img
                src="/images/home-decor/kave-home-lurea-sculptural-glass-centrepiece.png"
                alt="Lurea Sculptural Glass Centrepiece"
              />
            </div>

            <div class="continue-card-info">
              <span>DECORATIVE OBJECTS</span>
              <h3>Lurea Sculptural Glass Centrepiece</h3>
              <p>Kave Home</p>
              <strong>Discover &rarr;</strong>
            </div>
          </a>


          <a
            href="/candles-fragrance/walnut-candle-holder-set"
            class="continue-card"
          >
            <div class="continue-card-image">
              <img
                src="/images/candles-fragrance/sabaily-walnut-candle-holder-set.png"
                alt="Walnut Candle Holder Set"
              />
            </div>

            <div class="continue-card-info">
              <span>CANDLES &amp; FRAGRANCE</span>
              <h3>Walnut Candle Holder Set</h3>
              <p>Sabai'ly</p>
              <strong>Discover &rarr;</strong>
            </div>
          </a>

        </div>

      </section>


      <section class="product-final-cta">

        <p class="product-detail-eyebrow">
          KAVE HOME &middot; OVELIN
        </p>

        <h2>A rich layer of colour and softness.</h2>

        <a
          href="https://kavehome.com/es/en/p/ovelin-maroon-and-ecru-velvet-cushion-cover-30-x-50-cm?utm_affaid=kasodi"
          target="_blank"
          rel="nofollow sponsored"
          class="product-shop-button"
        >
          Find It Here &rarr;
        </a>

        <p class="affiliate-note affiliate-note-light">
          Affiliate link &middot; KASODI may earn a commission at no extra cost to you.
        </p>

      </section>

    </main>

    <Footer />
  </body>
</html>