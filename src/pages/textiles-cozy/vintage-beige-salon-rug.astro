---
import "../../styles/global.css";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
---

<html lang="en">
  <head>
    <!-- Google Consent Mode -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
        functionality_storage: "denied",
        personalization_storage: "denied",
        security_storage: "granted",
        wait_for_update: 2000
      });

      gtag("set", "ads_data_redaction", true);
      gtag("set", "url_passthrough", true);
    </script>

    <!-- Start cookieyes banner -->
    <script
      id="cookieyes"
      type="text/javascript"
      src="https://cdn-cookieyes.com/client_data/e9c032e34948c08e8ad6b9973971db36/script.js"
    ></script>
    <!-- End cookieyes banner -->

    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-LT2BEMKHKC"
    ></script>

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-LT2BEMKHKC');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Vintage Beige Salon Rug | KASODI</title>

    <meta
      name="description"
      content="Discover the Vintage Beige Salon Rug by PureCozy, a low-pile washable area rug with a softly distressed oriental-inspired pattern selected by KASODI."
    />
  </head>

  <body>

    <Header />

    <main class="product-detail-page">

      <div class="product-breadcrumb">
        <a href="/">Home</a>
        <span>·</span>
        <a href="/textiles-cozy">Textiles & Cozy</a>
        <span>·</span>
        <span>Vintage Beige Salon Rug</span>
      </div>


      <section class="product-detail-hero">

        <div class="product-detail-image">
          <img
            src="/images/textiles-cozy/vintage-beige-salon-rug.png"
            alt="Vintage beige salon rug by PureCozy styled by KASODI"
          />
        </div>


        <div class="product-detail-content">

          <p class="product-detail-eyebrow">
            KASODI FIND · RUGS
          </p>

          <h1>
            Vintage Beige Salon Rug
          </h1>

          <p class="product-detail-brand">
            PureCozy
          </p>

          <p class="product-detail-intro">
            A softly distressed beige area rug with a vintage floral pattern and
            understated oriental character. Its neutral palette brings warmth
            and texture to a room while remaining calm enough to work with both
            traditional and contemporary interiors.
          </p>


          <div class="product-detail-divider"></div>


          <div class="product-detail-meta">

            <div>
              <span>Size</span>
              <strong>200 × 300 cm</strong>
            </div>

            <div>
              <span>Colour</span>
              <strong>Accent Beige</strong>
            </div>

            <div>
              <span>Pile</span>
              <strong>Low Pile</strong>
            </div>

            <div>
              <span>Thickness</span>
              <strong>Approx. 0.5 cm</strong>
            </div>

            <div>
              <span>Pattern</span>
              <strong>Vintage Floral</strong>
            </div>

            <div>
              <span>Style</span>
              <strong>Oriental · Vintage</strong>
            </div>

          </div>


          <div class="affiliate-action">

            <a
              href="https://amzn.to/4Ab8Q3h"
              target="_blank"
              rel="nofollow sponsored"
              class="product-shop-button"
            >
              Find It Here →
            </a>

            <p class="affiliate-note">
              Affiliate link · KASODI may earn a commission at no extra cost to you.
            </p>

          </div>

        </div>

      </section>


      <section class="why-we-love">

        <div class="why-we-love-label">
          KASODI NOTE
        </div>

        <div class="why-we-love-content">

          <h2>Why we love it</h2>

          <p>
            This rug has the kind of soft, faded pattern that makes a room feel
            more layered without making it look busy. The warm beige tones and
            distressed floral detailing give it a collected, lived-in character
            that works especially well with natural wood, stone and soft neutral
            upholstery.
          </p>

          <p>
            We also like how practical it is for everyday spaces. The low pile
            keeps the profile clean and easy to place beneath sofas, beds or
            dining furniture, while the understated colour makes it easy to
            combine with patterned cushions, textured throws and decorative
            objects in warmer tones.
          </p>

        </div>

      </section>


      <section class="product-care">

        <p class="product-detail-eyebrow">
          CARE
        </p>

        <h2>Designed for everyday living</h2>

        <p>
          The product listing describes the rug as machine washable and stain
          resistant. For regular maintenance, shake out loose debris, vacuum
          gently and spot-clean spills promptly. Avoid excessive heat and harsh
          cleaning products to help preserve the colour and surface over time.
        </p>

      </section>


      <section class="styling-ideas">

        <div class="styling-heading">
          <p>KASODI STYLING</p>
          <h2>Style it with</h2>
        </div>


        <div class="styling-grid">

          <div class="styling-card">
            <span>01</span>
            <h3>Warm Wood</h3>
            <p>
              Oak, walnut or aged wood brings out the warmer beige tones and
              strengthens the rug's relaxed vintage character.
            </p>
          </div>


          <div class="styling-card">
            <span>02</span>
            <h3>Textured Throws</h3>
            <p>
              Soft knitted or woven throws add another layer of texture without
              competing with the subtle pattern of the rug.
            </p>
          </div>


          <div class="styling-card">
            <span>03</span>
            <h3>Neutral Ceramics</h3>
            <p>
              Cream, stone and softly speckled ceramics echo the quiet palette
              and keep the room feeling cohesive and collected.
            </p>
          </div>

        </div>

      </section>


      <section class="continue-exploring">

        <div class="continue-exploring-heading">
          <p>TEXTILES & COZY</p>
          <h2>Continue Exploring</h2>
        </div>

        <div class="continue-exploring-grid">


          <a
            href="/textiles-cozy/cream-tassel-table-runner"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/textiles-cozy/cream-tassel-table-runner.png"
                alt="Cream Tassel Table Runner"
              />
            </div>

            <div class="continue-card-info">
              <span>TABLE LINEN</span>
              <h3>Cream Tassel Table Runner</h3>
              <p>Artoid Mode</p>
              <strong>Discover →</strong>
            </div>

          </a>


          <a
            href="/kasodi-edit/embroidered-garden-cushions"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/kasodi-edit/kasodi-edit-embroidered-green-cushions.png"
                alt="Embroidered Garden Cushions"
              />
            </div>

            <div class="continue-card-info">
              <span>CUSHIONS</span>
              <h3>Embroidered Garden Cushions</h3>
              <p>Running Elephant</p>
              <strong>Discover →</strong>
            </div>

          </a>


          <a
            href="/new-finds/vintage-botanical-duvet-cover-set"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/new-finds/vintage-botanical-duvet-cover-set.png"
                alt="Vintage Botanical Duvet Cover Set"
              />
            </div>

            <div class="continue-card-info">
              <span>BEDDING</span>
              <h3>Vintage Botanical Duvet Cover Set</h3>
              <p>Fashionbedding</p>
              <strong>Discover →</strong>
            </div>

          </a>

        </div>

      </section>


      <section class="product-final-cta">

        <p class="product-detail-eyebrow">
          PURECOZY · VINTAGE AREA RUG
        </p>

        <h2>
          A quiet vintage foundation for a warmer room.
        </h2>

        <a
          href="https://amzn.to/4Ab8Q3h"
          target="_blank"
          rel="nofollow sponsored"
          class="product-shop-button"
        >
          Find It Here →
        </a>

        <p class="affiliate-note affiliate-note-light">
          Affiliate link · KASODI may earn a commission at no extra cost to you.
        </p>

      </section>

    </main>

    <Footer />

  </body>
</html>