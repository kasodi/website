---
import "../../styles/global.css";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
---

<html lang="en">
  <head>
    <!-- Google Consent Mode -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization_storage: "denied",
        analytics_storage: "denied",
        functionality_storage: "denied",
        personalization_storage: "denied",
        security_storage: "granted",
        wait_for_update: 2000
      });

      gtag("set", "ads_data_redaction", true);
      gtag("set", "url_passthrough", true);
    </script>

    <!-- Start cookieyes banner -->
    <script
      id="cookieyes"
      type="text/javascript"
      src="https://cdn-cookieyes.com/client_data/e9c032e34948c08e8ad6b9973971db36/script.js"
    ></script>
    <!-- End cookieyes banner -->

    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-LT2BEMKHKC"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-LT2BEMKHKC');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Cream Tassel Table Runner | KASODI</title>

    <meta
      name="description"
      content="Discover the Cream Tassel Table Runner by Artoid Mode, a softly textured table runner with decorative stitched detailing and tassel fringe selected by KASODI."
    />
  </head>

  <body>

    <Header />

    <main class="product-detail-page">

      <div class="product-breadcrumb">
        <a href="/">Home</a>
        <span>·</span>
        <a href="/textiles-cozy">Textiles & Cozy</a>
        <span>·</span>
        <span>Cream Tassel Table Runner</span>
      </div>


      <section class="product-detail-hero">

        <div class="product-detail-image">
          <img
            src="/images/textiles-cozy/cream-tassel-table-runner.png"
            alt="Cream tassel table runner by Artoid Mode styled by KASODI"
          />
        </div>


        <div class="product-detail-content">

          <p class="product-detail-eyebrow">
            KASODI FIND · TABLE LINEN
          </p>

          <h1>
            Cream Tassel Table Runner
          </h1>

          <p class="product-detail-brand">
            Artoid Mode
          </p>

          <p class="product-detail-intro">
            A softly textured cream table runner finished with decorative
            stitched detailing and tassel fringe. Its warm neutral tone brings
            an easy, relaxed character to the table and works beautifully with
            ceramics, coloured glassware and natural materials.
          </p>


          <div class="product-detail-divider"></div>


          <div class="product-detail-meta">

            <div>
              <span>Material</span>
              <strong>Textile</strong>
            </div>

            <div>
              <span>Dimensions</span>
              <strong>33 × 143 cm</strong>
            </div>

            <div>
              <span>Colour</span>
              <strong>Cream</strong>
            </div>

            <div>
              <span>Weight</span>
              <strong>Approx. 130 g</strong>
            </div>

            <div>
              <span>Details</span>
              <strong>Stitched Texture · Tassel Fringe</strong>
            </div>

            <div>
              <span>Style</span>
              <strong>Natural · Farmhouse · Mediterranean</strong>
            </div>

          </div>


          <div class="affiliate-action">

            <a
              href="https://amzn.to/3UDngJk"
              target="_blank"
              rel="nofollow sponsored"
              class="product-shop-button"
            >
              Find It Here →
            </a>

            <p class="affiliate-note">
              Affiliate link · KASODI may earn a commission at no extra cost to you.
            </p>

          </div>

        </div>

      </section>


      <section class="why-we-love">

        <div class="why-we-love-label">
          KASODI NOTE
        </div>

        <div class="why-we-love-content">

          <h2>Why we love it</h2>

          <p>
            The beauty of this runner is in its simplicity. The soft cream colour
            creates a calm foundation for a table setting, while the woven
            texture, stitched detailing and tasselled ends keep it from feeling
            plain.
          </p>

          <p>
            We especially like it paired with patterned ceramics, green glass and
            warm natural wood. It is an easy way to make an everyday table feel
            more layered and considered without introducing too much colour or
            formality.
          </p>

        </div>

      </section>


      <section class="product-care">

        <p class="product-detail-eyebrow">
          CARE
        </p>

        <h2>Easy care for everyday use</h2>

        <p>
          The product listing describes the runner as machine washable. Lay it
          flat to dry after washing to help preserve the shape and tassel fringe.
          Avoid harsh bleach or high heat where possible to keep the cream tone
          and textured finish looking fresh.
        </p>

      </section>


      <section class="styling-ideas">

        <div class="styling-heading">
          <p>KASODI STYLING</p>
          <h2>Style it with</h2>
        </div>


        <div class="styling-grid">

          <div class="styling-card">
            <span>01</span>
            <h3>Patterned Ceramics</h3>
            <p>
              Floral or fruit-patterned plates stand out beautifully against the
              calm cream background without making the table feel too busy.
            </p>
          </div>


          <div class="styling-card">
            <span>02</span>
            <h3>Green Glassware</h3>
            <p>
              Olive or emerald-toned glasses bring soft colour to the neutral
              runner and create a warm Mediterranean-inspired table.
            </p>
          </div>


          <div class="styling-card">
            <span>03</span>
            <h3>Natural Wood</h3>
            <p>
              Rustic or warm-toned wooden tables highlight the woven texture and
              keep the overall setting relaxed and inviting.
            </p>
          </div>

        </div>

      </section>


      <section class="continue-exploring">

        <div class="continue-exploring-heading">
          <p>TEXTILES & COZY</p>
          <h2>Continue Exploring</h2>
        </div>

        <div class="continue-exploring-grid">


          <a
            href="/tableware/villeroy-boch-french-garden-fleurence-dinner-plate"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/tableware/villeroy-boch-french-garden-fleurence-dinner-plate.png"
                alt="French Garden Fleurence Dinner Plate"
              />
            </div>

            <div class="continue-card-info">
              <span>TABLEWARE</span>
              <h3>French Garden Fleurence Dinner Plate</h3>
              <p>Villeroy & Boch</p>
              <strong>Discover →</strong>
            </div>

          </a>


          <a
            href="/kasodi-edit/boston-green-wine-glass"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/kasodi-edit/kasodi-edit-villeroy-boch-boston-green-glass.png"
                alt="Boston Green Wine Glass"
              />
            </div>

            <div class="continue-card-info">
              <span>GLASSWARE</span>
              <h3>Boston Green Wine Glass</h3>
              <p>Villeroy & Boch</p>
              <strong>Discover →</strong>
            </div>

          </a>


          <a
            href="/tableware/pink-floral-tea-cup-saucer"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/tableware/pink-floral-tea-cup-saucer.png"
                alt="Pink Floral Tea Cup & Saucer"
              />
            </div>

            <div class="continue-card-info">
              <span>TABLEWARE</span>
              <h3>Pink Floral Tea Cup & Saucer</h3>
              <p>fanquare</p>
              <strong>Discover →</strong>
            </div>

          </a>

        </div>

      </section>


      <section class="product-final-cta">

        <p class="product-detail-eyebrow">
          ARTOID MODE · TABLE LINEN
        </p>

        <h2>
          A soft neutral layer for a warmer everyday table.
        </h2>

        <a
          href="https://amzn.to/3UDngJk"
          target="_blank"
          rel="nofollow sponsored"
          class="product-shop-button"
        >
          Find It Here →
        </a>

        <p class="affiliate-note affiliate-note-light">
          Affiliate link · KASODI may earn a commission at no extra cost to you.
        </p>

      </section>

    </main>

    <Footer />

  </body>
</html>