---
import "../../styles/global.css";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
---

<html lang="en">
  <head>
    <!-- Google Consent Mode -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
        functionality_storage: "denied",
        personalization_storage: "denied",
        security_storage: "granted",
        wait_for_update: 2000
      });

      gtag("set", "ads_data_redaction", true);
      gtag("set", "url_passthrough", true);
    </script>

    <!-- Start cookieyes banner -->
    <script
      id="cookieyes"
      type="text/javascript"
      src="https://cdn-cookieyes.com/client_data/e9c032e34948c08e8ad6b9973971db36/script.js"
    ></script>
    <!-- End cookieyes banner -->

    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-LT2BEMKHKC"
    ></script>

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-LT2BEMKHKC');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Textured Oval Organizer Tray | KASODI</title>

    <meta
      name="description"
      content="Discover the Textured Oval Organizer Tray by Blissilk, selected by KASODI for its warm beige tone, sculptural oval form and practical textured resin finish."
    />
  </head>

  <body>

    <Header />


    <main class="product-detail-page">

      <div class="product-breadcrumb">
        <a href="/">Home</a>
        <span>·</span>
        <a href="/home-organization">Home Organization</a>
        <span>·</span>
        <span>Textured Oval Organizer Tray</span>
      </div>


      <section class="product-detail-hero">

        <div class="product-detail-image">
          <img
            src="/images/home-organization/blissilk-textured-oval-organizer-tray.png"
            alt="Textured Oval Organizer Tray by Blissilk styled by KASODI"
          />
        </div>


        <div class="product-detail-content">

          <p class="product-detail-eyebrow">
            KASODI EDIT · HOME ORGANIZATION
          </p>

          <h1>
            Textured Oval Organizer Tray
          </h1>

          <p class="product-detail-brand">
            Blissilk
          </p>

          <p class="product-detail-intro">
            A softly sculpted oval tray designed to bring order to the small
            objects we use every day. Its warm beige finish and subtly textured
            surface give a practical organizer the presence of a decorative
            object, making it an easy addition to a vanity, bathroom counter,
            console or bedside table.
          </p>


          <div class="product-detail-divider"></div>


          <div class="product-detail-meta">

            <div>
              <span>Material</span>
              <strong>Textured resin</strong>
            </div>

            <div>
              <span>Size</span>
              <strong>26 × 11 × 2.3 cm</strong>
            </div>

            <div>
              <span>Weight</span>
              <strong>Approx. 610 g</strong>
            </div>

            <div>
              <span>Colour</span>
              <strong>Warm beige</strong>
            </div>

            <div>
              <span>Shape</span>
              <strong>Oval</strong>
            </div>

            <div>
              <span>Finish</span>
              <strong>Textured · Matte</strong>
            </div>

          </div>


          <div class="affiliate-action">

            <a
              href="https://amzn.to/3TrJ6PA"
              target="_blank"
              rel="nofollow sponsored"
              class="product-shop-button"
            >
              Find It Here →
            </a>

            <p class="affiliate-note">
              Affiliate link · KASODI may earn a commission at no extra cost to you.
            </p>

          </div>

        </div>

      </section>


      <section class="why-we-love">

        <div class="why-we-love-label">
          KASODI NOTE
        </div>

        <div class="why-we-love-content">

          <h2>Why we love it</h2>

          <p>
            Good organization does not have to look utilitarian. We like this
            tray because its elongated oval silhouette and layered, textured
            edge make it feel closer to a decorative stone object than a
            conventional bathroom organizer. The soft beige tone also works
            beautifully with warm woods, linen, ceramics and natural stone.
          </p>

          <p>
            Its compact proportions make it especially useful for gathering
            the small things that can quickly create visual clutter — perfume,
            jewellery, skincare, keys or other everyday essentials. The
            textured surface helps keep objects in place, while the resin
            construction makes it practical for bathrooms, vanities, consoles
            and bedside tables.
          </p>

        </div>

      </section>


      <section class="product-care">

        <p class="product-detail-eyebrow">
          CARE
        </p>

        <h2>Simple everyday care</h2>

        <p>
          Wipe clean with a soft damp cloth and mild soap when needed.
          Avoid abrasive cleaners or rough sponges to help preserve the
          textured matte finish.
        </p>

      </section>


      <section class="styling-ideas">

        <div class="styling-heading">
          <p>KASODI STYLING</p>
          <h2>Style it with</h2>
        </div>


        <div class="styling-grid">

          <div class="styling-card">
            <span>01</span>
            <h3>Amber Glass</h3>
            <p>
              Pair the warm beige surface with amber perfume bottles,
              apothecary jars or small glass vessels for deeper,
              honey-toned contrast.
            </p>
          </div>


          <div class="styling-card">
            <span>02</span>
            <h3>Natural Linen</h3>
            <p>
              Soft linen towels or relaxed woven textiles reinforce the
              understated, tactile character of the tray.
            </p>
          </div>


          <div class="styling-card">
            <span>03</span>
            <h3>Warm Metals</h3>
            <p>
              A few pieces of gold or aged-brass jewellery add just enough
              warmth without overwhelming the neutral palette.
            </p>
          </div>

        </div>

      </section>


      <section class="continue-exploring">

        <div class="continue-exploring-heading">
          <p>KASODI EDIT</p>
          <h2>Continue Exploring</h2>
        </div>

        <div class="continue-exploring-grid">


          <a
            href="/bathroom/amber-glass-apothecary-jars"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/bathroom/kuishi-amber-glass-apothecary-jars.png"
                alt="Amber Glass Apothecary Jars"
              />
            </div>

            <div class="continue-card-info">
              <span>BATHROOM</span>
              <h3>Amber Glass Apothecary Jars</h3>
              <p>Kuishi</p>
              <strong>Discover →</strong>
            </div>

          </a>


          <a
            href="/candles-fragrance/walnut-candle-holder-set"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/candles-fragrance/sabaily-walnut-candle-holder-set.png"
                alt="Walnut Candle Holder Set"
              />
            </div>

            <div class="continue-card-info">
              <span>CANDLE HOLDERS</span>
              <h3>Walnut Candle Holder Set</h3>
              <p>Sabai'ly</p>
              <strong>Discover →</strong>
            </div>

          </a>


          <a
            href="/candles-fragrance/lena-sculptural-flower-candle"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/candles-fragrance/serentique-lena-sculptural-flower-candle.png"
                alt="Lena Sculptural Flower Candle"
              />
            </div>

            <div class="continue-card-info">
              <span>CANDLES</span>
              <h3>Lena Sculptural Flower Candle</h3>
              <p>Serentique</p>
              <strong>Discover →</strong>
            </div>

          </a>

        </div>

      </section>


      <section class="product-final-cta">

        <p class="product-detail-eyebrow">
          BLISSILK · TEXTURED ORGANIZER TRAY
        </p>

        <h2>
          A quieter place for everyday essentials.
        </h2>

        <a
          href="https://amzn.to/3TrJ6PA"
          target="_blank"
          rel="nofollow sponsored"
          class="product-shop-button"
        >
          Find It Here →
        </a>

        <p class="affiliate-note affiliate-note-light">
          Affiliate link · KASODI may earn a commission at no extra cost to you.
        </p>

      </section>

    </main>


    <Footer />

  </body>
</html>