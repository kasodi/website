
---
const destination = "/home/organization/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <meta name="robots" content="noindex, follow" />
    <link
      rel="canonical"
      href={`https://kasodi.com${destination}`}
    />
    <title>Redirecting | KASODI</title>
  </head>
  <body>
    <p>
      Redirecting to
      <a href={destination}>Home Organization</a>.
    </p>
  </body>
</html>
