---
import "../../styles/global.css";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
---

<html lang="en">
  <head>
    <!-- Google Consent Mode -->
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
        functionality_storage: "denied",
        personalization_storage: "denied",
        security_storage: "granted",
        wait_for_update: 2000
      });

      gtag("set", "ads_data_redaction", true);
      gtag("set", "url_passthrough", true);
    </script>

    <!-- Start cookieyes banner -->
    <script
      id="cookieyes"
      type="text/javascript"
      src="https://cdn-cookieyes.com/client_data/e9c032e34948c08e8ad6b9973971db36/script.js"
    ></script>
    <!-- End cookieyes banner -->

    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-LT2BEMKHKC"
    ></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-LT2BEMKHKC');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Lady Diamond Wine Glasses | KASODI</title>

    <meta
      name="description"
      content="Discover the Lady Diamond Wine Glasses by Cristal D'Arques, a set of six French crystal glasses selected by KASODI for their elegant faceted design and timeless Art Deco character."
    />
  </head>

  <body>

    <Header />


    <main class="product-detail-page">

      <div class="product-breadcrumb">
        <a href="/">Home</a>
        <span>·</span>
        <a href="/tableware">Tableware</a>
        <span>·</span>
        <span>Lady Diamond Wine Glasses</span>
      </div>


      <section class="product-detail-hero">

        <div class="product-detail-image">
          <img
            src="/images/tableware/cristal-darques-lady-diamond-wine-glasses.png"
            alt="Lady Diamond faceted crystal wine glasses by Cristal D'Arques styled by KASODI"
          />
        </div>


        <div class="product-detail-content">

          <p class="product-detail-eyebrow">
            KASODI FIND · GLASSWARE
          </p>

          <h1>
            Lady Diamond Wine Glasses
          </h1>

          <p class="product-detail-brand">
            Cristal D'Arques
          </p>

          <p class="product-detail-intro">
            A set of six elegant French crystal wine glasses with a striking
            faceted design inspired by Art Deco. Their tall silhouette,
            transparent glass and geometric texture bring light and refinement
            to both everyday tables and special occasions.
          </p>


          <div class="product-detail-divider"></div>


          <div class="product-detail-meta">

            <div>
              <span>Material</span>
              <strong>Lead-Free Crystal Glass</strong>
            </div>

            <div>
              <span>Set</span>
              <strong>6 Wine Glasses</strong>
            </div>

            <div>
              <span>Capacity</span>
              <strong>6 × 27 cl</strong>
            </div>

            <div>
              <span>Dimensions</span>
              <strong>Approx. 8.9 × 21.2 cm</strong>
            </div>

            <div>
              <span>Colour</span>
              <strong>Clear</strong>
            </div>

            <div>
              <span>Made in</span>
              <strong>France</strong>
            </div>

          </div>


          <div class="affiliate-action">

            <a
              href="https://amzn.to/3ULOZaL"
              target="_blank"
              rel="nofollow sponsored"
              class="product-shop-button"
            >
              Find It Here →
            </a>

            <p class="affiliate-note">
              Affiliate link · KASODI may earn a commission at no extra cost to you.
            </p>

          </div>

        </div>

      </section>


      <section class="why-we-love">

        <div class="why-we-love-label">
          KASODI NOTE
        </div>

        <div class="why-we-love-content">

          <h2>Why we love it</h2>

          <p>
            These glasses have the kind of decorative detail that catches the
            light without feeling overly formal. The geometric faceting gives
            them a subtle Art Deco character, while the clear crystal keeps the
            overall look elegant and easy to style with different tableware.
          </p>

          <p>
            We especially like them for dinner parties, celebratory tables and
            relaxed evenings when you want the glassware itself to add a little
            sparkle. They pair beautifully with simple porcelain, warm metallic
            details and natural linen, making them versatile enough for both
            classic and more contemporary settings.
          </p>

        </div>

      </section>


      <section class="product-care">

        <p class="product-detail-eyebrow">
          CARE
        </p>

        <h2>Made for beautiful everyday use</h2>

        <p>
          The product information lists the glasses as dishwasher safe. To help
          preserve their clarity and brilliance, place them securely in the
          dishwasher or wash gently by hand with a soft sponge and mild
          detergent. Avoid abrasive cleaners that may dull the surface.
        </p>

      </section>


      <section class="styling-ideas">

        <div class="styling-heading">
          <p>KASODI STYLING</p>
          <h2>Style it with</h2>
        </div>


        <div class="styling-grid">

          <div class="styling-card">
            <span>01</span>
            <h3>Natural Linen</h3>
            <p>
              Ivory, flax or soft beige linen gives the clear crystal a warm
              backdrop and keeps the table feeling relaxed.
            </p>
          </div>


          <div class="styling-card">
            <span>02</span>
            <h3>Decorative Porcelain</h3>
            <p>
              Floral or softly patterned plates balance the geometric glass
              texture and create a collected, layered table.
            </p>
          </div>


          <div class="styling-card">
            <span>03</span>
            <h3>Warm Metallic Details</h3>
            <p>
              Brass or brushed-gold cutlery brings warmth to the clear crystal
              and enhances the elegant Art Deco feeling.
            </p>
          </div>

        </div>

      </section>


      <section class="continue-exploring">

        <div class="continue-exploring-heading">
          <p>TABLEWARE</p>
          <h2>Continue Exploring</h2>
        </div>

        <div class="continue-exploring-grid">


          <a
            href="/tableware/vintage-multicolour-dinnerware-set"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/tableware/vintage-multicolour-dinnerware-set.png"
                alt="Vintage Multicolour Dinnerware Set"
              />
            </div>

            <div class="continue-card-info">
              <span>TABLEWARE</span>
              <h3>Vintage Multicolour Dinnerware Set</h3>
              <p>Moritz & Moritz</p>
              <strong>Discover →</strong>
            </div>

          </a>


          <a
            href="/tableware/blue-floral-porcelain-tea-set"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/tableware/blue-floral-porcelain-tea-set.png"
                alt="Blue Floral Porcelain Tea Set"
              />
            </div>

            <div class="continue-card-info">
              <span>TABLEWARE</span>
              <h3>Blue Floral Porcelain Tea Set</h3>
              <p>fanquare</p>
              <strong>Discover →</strong>
            </div>

          </a>


          <a
            href="/kasodi-edit/boston-green-wine-glass"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/kasodi-edit/kasodi-edit-villeroy-boch-boston-green-glass.png"
                alt="Boston Green Wine Glass"
              />
            </div>

            <div class="continue-card-info">
              <span>GLASSWARE</span>
              <h3>Boston Green Wine Glass</h3>
              <p>Villeroy & Boch</p>
              <strong>Discover →</strong>
            </div>

          </a>

        </div>

      </section>


      <section class="product-final-cta">

        <p class="product-detail-eyebrow">
          CRISTAL D'ARQUES · LADY DIAMOND
        </p>

        <h2>
          Crystal that catches the light beautifully.
        </h2>

        <a
          href="https://amzn.to/3ULOZaL"
          target="_blank"
          rel="nofollow sponsored"
          class="product-shop-button"
        >
          Find It Here →
        </a>

        <p class="affiliate-note affiliate-note-light">
          Affiliate link · KASODI may earn a commission at no extra cost to you.
        </p>

      </section>

    </main>


    <Footer />

  </body>
</html>