---
const newUrl = "/kitchen/tableware/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${newUrl}`} />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href="https://kasodi.com/kitchen/tableware/" />
    <title>Redirecting to Tableware | KASODI</title>
    <script is:inline>
      window.location.replace("/kitchen/tableware/");
    </script>
  </head>
  <body>
    <p>
      The Tableware collection has moved.
      <a href={newUrl}>View the Tableware collection</a>.
    </p>
  </body>
</html>