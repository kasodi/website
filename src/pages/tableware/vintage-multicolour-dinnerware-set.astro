---
import "../../styles/global.css";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
---

<html lang="en">
  <head>
    <!-- Google Consent Mode -->
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
        functionality_storage: "denied",
        personalization_storage: "denied",
        security_storage: "granted",
        wait_for_update: 2000
      });

      gtag("set", "ads_data_redaction", true);
      gtag("set", "url_passthrough", true);
    </script>

    <!-- Start cookieyes banner -->
    <script
      id="cookieyes"
      type="text/javascript"
      src="https://cdn-cookieyes.com/client_data/e9c032e34948c08e8ad6b9973971db36/script.js"
    ></script>
    <!-- End cookieyes banner -->

    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-LT2BEMKHKC"
    ></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-LT2BEMKHKC');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Vintage Multicolour Dinnerware Set | KASODI</title>

    <meta
      name="description"
      content="Discover the Vintage Multicolour Dinnerware Set by Moritz & Moritz, an 18-piece porcelain tableware set in warm olive, ochre and earthy vintage tones, selected by KASODI."
    />
  </head>

  <body>

    <Header />


    <main class="product-detail-page">

      <div class="product-breadcrumb">
        <a href="/">Home</a>
        <span>·</span>
        <a href="/tableware">Tableware</a>
        <span>·</span>
        <span>Vintage Multicolour Dinnerware Set</span>
      </div>


      <section class="product-detail-hero">

        <div class="product-detail-image">
          <img
            src="/images/tableware/vintage-multicolour-dinnerware-set.png"
            alt="Vintage multicolour porcelain dinnerware set by Moritz & Moritz styled by KASODI"
          />
        </div>


        <div class="product-detail-content">

          <p class="product-detail-eyebrow">
            KASODI FIND · TABLEWARE
          </p>

          <h1>
            Vintage Multicolour Dinnerware Set
          </h1>

          <p class="product-detail-brand">
            Moritz & Moritz
          </p>

          <p class="product-detail-intro">
            An expressive 18-piece porcelain dinnerware set for six, combining
            warm olive green, ochre and earthy brown tones with a softly
            speckled vintage finish. A characterful everyday set designed to
            bring warmth and depth to a relaxed table.
          </p>


          <div class="product-detail-divider"></div>


          <div class="product-detail-meta">

            <div>
              <span>Material</span>
              <strong>Porcelain</strong>
            </div>

            <div>
              <span>Set</span>
              <strong>18 Pieces · Service for 6</strong>
            </div>

            <div>
              <span>Dinner Plates</span>
              <strong>6 × 27 cm</strong>
            </div>

            <div>
              <span>Dessert Plates</span>
              <strong>6 × 20.5 cm</strong>
            </div>

            <div>
              <span>Soup Bowls</span>
              <strong>6 × 19 cm</strong>
            </div>

            <div>
              <span>Colour</span>
              <strong>Olive · Ochre · Earthy Brown</strong>
            </div>

          </div>


          <div class="affiliate-action">

            <a
              href="https://amzn.to/4d92GGW"
              target="_blank"
              rel="nofollow sponsored"
              class="product-shop-button"
            >
              Find It Here →
            </a>

            <p class="affiliate-note">
              Affiliate link · KASODI may earn a commission at no extra cost to you.
            </p>

          </div>

        </div>

      </section>


      <section class="why-we-love">

        <div class="why-we-love-label">
          KASODI NOTE
        </div>

        <div class="why-we-love-content">

          <h2>Why we love it</h2>

          <p>
            What makes this set interesting is the colour combination. Instead
            of matching every piece in a single shade, it layers olive green,
            warm ochre and earthy brown into one coordinated collection. The
            softly mottled surface gives the porcelain a more artisanal,
            collected feeling and makes even a simple everyday table look
            considered.
          </p>

          <p>
            We especially like it for relaxed lunches, autumn dinners and
            Mediterranean-inspired tables where natural materials and warm
            colours do most of the styling. The darker edges add definition,
            while the different tones make the individual pieces easy to mix
            with linen, wood, woven placemats and simple glassware.
          </p>

        </div>

      </section>


      <section class="product-care">

        <p class="product-detail-eyebrow">
          CARE
        </p>

        <h2>Made for everyday tables</h2>

        <p>
          The product information lists the porcelain pieces as dishwasher and
          microwave safe, making the set practical for regular use. Stack the
          pieces carefully to help protect the glazed surfaces and avoid
          abrasive cleaners or rough scouring pads that may dull the finish
          over time.
        </p>

      </section>


      <section class="styling-ideas">

        <div class="styling-heading">
          <p>KASODI STYLING</p>
          <h2>Style it with</h2>
        </div>


        <div class="styling-grid">

          <div class="styling-card">
            <span>01</span>
            <h3>Natural Linen</h3>
            <p>
              Oatmeal, flax or warm beige linen lets the olive and ochre tones
              stand out while keeping the table relaxed and understated.
            </p>
          </div>


          <div class="styling-card">
            <span>02</span>
            <h3>Woven Textures</h3>
            <p>
              Rattan or natural-fibre placemats complement the earthy palette
              and reinforce the warm, Mediterranean character of the set.
            </p>
          </div>


          <div class="styling-card">
            <span>03</span>
            <h3>Warm Glassware</h3>
            <p>
              Amber, olive or softly tinted glasses work beautifully with the
              layered colours and make the table feel rich without becoming
              overly formal.
            </p>
          </div>

        </div>

      </section>


      <section class="continue-exploring">

        <div class="continue-exploring-heading">
          <p>TABLEWARE</p>
          <h2>Continue Exploring</h2>
        </div>

        <div class="continue-exploring-grid">


          <a
            href="/tableware/blue-floral-porcelain-tea-set"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/tableware/blue-floral-porcelain-tea-set.png"
                alt="Blue Floral Porcelain Tea Set"
              />
            </div>

            <div class="continue-card-info">
              <span>TABLEWARE</span>
              <h3>Blue Floral Porcelain Tea Set</h3>
              <p>fanquare</p>
              <strong>Discover →</strong>
            </div>

          </a>


          <a
            href="/tableware/vintage-gold-cake-serving-set"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/tableware/vintage-gold-cake-serving-set.png"
                alt="Vintage Gold Cake Serving Set"
              />
            </div>

            <div class="continue-card-info">
              <span>TABLEWARE</span>
              <h3>Vintage Gold Cake Serving Set</h3>
              <p>XINCHEN Kitchen</p>
              <strong>Discover →</strong>
            </div>

          </a>


          <a
            href="/kasodi-edit/boston-green-wine-glass"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/kasodi-edit/kasodi-edit-villeroy-boch-boston-green-glass.png"
                alt="Boston Green Wine Glass"
              />
            </div>

            <div class="continue-card-info">
              <span>GLASSWARE</span>
              <h3>Boston Green Wine Glass</h3>
              <p>Villeroy & Boch</p>
              <strong>Discover →</strong>
            </div>

          </a>

        </div>

      </section>


      <section class="product-final-cta">

        <p class="product-detail-eyebrow">
          MORITZ & MORITZ · VINTAGE DINNERWARE
        </p>

        <h2>
          Warm colour and character for the everyday table.
        </h2>

        <a
          href="https://amzn.to/4d92GGW"
          target="_blank"
          rel="nofollow sponsored"
          class="product-shop-button"
        >
          Find It Here →
        </a>

        <p class="affiliate-note affiliate-note-light">
          Affiliate link · KASODI may earn a commission at no extra cost to you.
        </p>

      </section>

    </main>


    <Footer />

  </body>
</html>