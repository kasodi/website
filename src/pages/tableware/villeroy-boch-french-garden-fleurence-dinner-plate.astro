---
import "../../styles/global.css";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
---

<html lang="en">
  <head>
    <!-- Google Consent Mode -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
        functionality_storage: "denied",
        personalization_storage: "denied",
        security_storage: "granted",
        wait_for_update: 2000
      });

      gtag("set", "ads_data_redaction", true);
      gtag("set", "url_passthrough", true);
    </script>

    <!-- Start cookieyes banner -->
    <script
      id="cookieyes"
      type="text/javascript"
      src="https://cdn-cookieyes.com/client_data/e9c032e34948c08e8ad6b9973971db36/script.js"
    ></script>
    <!-- End cookieyes banner -->

    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-LT2BEMKHKC"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-LT2BEMKHKC');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>French Garden Fleurence Dinner Plate | KASODI</title>

    <meta
      name="description"
      content="Discover the Villeroy & Boch French Garden Fleurence Dinner Plate, a 26 cm premium porcelain plate with botanical fruit motifs and a green scalloped border, selected by KASODI."
    />
  </head>

  <body>

    <Header />


    <main class="product-detail-page">

      <div class="product-breadcrumb">
        <a href="/">Home</a>
        <span>·</span>
        <a href="/tableware">Tableware</a>
        <span>·</span>
        <span>French Garden Fleurence Dinner Plate</span>
      </div>


      <section class="product-detail-hero">

        <div class="product-detail-image">
          <img
            src="/images/tableware/villeroy-boch-french-garden-fleurence-dinner-plate.png"
            alt="Villeroy & Boch French Garden Fleurence dinner plate styled by KASODI"
          />
        </div>


        <div class="product-detail-content">

          <p class="product-detail-eyebrow">
            KASODI FIND · TABLEWARE
          </p>

          <h1>
            French Garden Fleurence Dinner Plate
          </h1>

          <p class="product-detail-brand">
            Villeroy & Boch
          </p>

          <p class="product-detail-intro">
            A charming 26 cm dinner plate from the French Garden Fleurence
            collection, combining a soft yellow centre with green borders and
            delicate fruit and botanical motifs. Its scalloped shape gives the
            plate a traditional garden-inspired character while keeping it
            practical enough for everyday use.
          </p>


          <div class="product-detail-divider"></div>


          <div class="product-detail-meta">

            <div>
              <span>Material</span>
              <strong>Premium Porcelain</strong>
            </div>

            <div>
              <span>Diameter</span>
              <strong>26 cm</strong>
            </div>

            <div>
              <span>Colour</span>
              <strong>White · Green · Yellow · Multicolour</strong>
            </div>

            <div>
              <span>Collection</span>
              <strong>French Garden Fleurence</strong>
            </div>

            <div>
              <span>Finish</span>
              <strong>Glossy</strong>
            </div>

            <div>
              <span>Made in</span>
              <strong>Germany</strong>
            </div>

          </div>


          <div class="affiliate-action">

            <a
              href="https://amzn.to/4xgp5cN"
              target="_blank"
              rel="nofollow sponsored"
              class="product-shop-button"
            >
              Find It Here →
            </a>

            <p class="affiliate-note">
              Affiliate link · KASODI may earn a commission at no extra cost to you.
            </p>

          </div>

        </div>

      </section>


      <section class="why-we-love">

        <div class="why-we-love-label">
          KASODI NOTE
        </div>

        <div class="why-we-love-content">

          <h2>Why we love it</h2>

          <p>
            This plate has exactly the kind of decorative character we look for
            in everyday tableware. The soft yellow centre, fresh green edging
            and small fruit motifs bring colour to the table without making the
            setting feel overly formal or coordinated.
          </p>

          <p>
            The scalloped edge gives it a slightly traditional French-country
            feel, while the clean porcelain keeps it easy to mix with simple
            linen, clear or green glassware and warmer natural materials. It is
            the kind of piece that can make an ordinary lunch feel a little more
            considered.
          </p>

        </div>

      </section>


      <section class="product-care">

        <p class="product-detail-eyebrow">
          CARE
        </p>

        <h2>Made for everyday tables</h2>

        <p>
          The plate is listed as dishwasher and microwave safe. Stack carefully
          to protect the glazed surface and decorative rim, and avoid abrasive
          cleaners or rough scouring pads that could dull the finish over time.
        </p>

      </section>


      <section class="styling-ideas">

        <div class="styling-heading">
          <p>KASODI STYLING</p>
          <h2>Style it with</h2>
        </div>


        <div class="styling-grid">

          <div class="styling-card">
            <span>01</span>
            <h3>Green Glassware</h3>
            <p>
              Soft olive or clear green glasses echo the border and bring the
              garden-inspired palette together without making it feel too
              matched.
            </p>
          </div>


          <div class="styling-card">
            <span>02</span>
            <h3>Natural Linen</h3>
            <p>
              Oatmeal, ivory or warm beige linen gives the colourful porcelain
              a relaxed Mediterranean backdrop.
            </p>
          </div>


          <div class="styling-card">
            <span>03</span>
            <h3>Fresh Citrus</h3>
            <p>
              Lemons, cherries or simple garden greenery naturally pick up the
              fruit motifs and make the table feel fresh and seasonal.
            </p>
          </div>

        </div>

      </section>


      <section class="continue-exploring">

        <div class="continue-exploring-heading">
          <p>TABLEWARE</p>
          <h2>Continue Exploring</h2>
        </div>

        <div class="continue-exploring-grid">


          <a
            href="/kasodi-edit/boston-green-wine-glass"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/kasodi-edit/kasodi-edit-villeroy-boch-boston-green-glass.png"
                alt="Boston Green Wine Glass"
              />
            </div>

            <div class="continue-card-info">
              <span>GLASSWARE</span>
              <h3>Boston Green Wine Glass</h3>
              <p>Villeroy & Boch</p>
              <strong>Discover →</strong>
            </div>

          </a>


          <a
            href="/tableware/blue-floral-porcelain-tea-set"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/tableware/blue-floral-porcelain-tea-set.png"
                alt="Blue Floral Porcelain Tea Set"
              />
            </div>

            <div class="continue-card-info">
              <span>TABLEWARE</span>
              <h3>Blue Floral Porcelain Tea Set</h3>
              <p>fanquare</p>
              <strong>Discover →</strong>
            </div>

          </a>


          <a
            href="/tableware/pink-floral-tea-cup-saucer"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/tableware/pink-floral-tea-cup-saucer.png"
                alt="Pink Floral Tea Cup & Saucer"
              />
            </div>

            <div class="continue-card-info">
              <span>TABLEWARE</span>
              <h3>Pink Floral Tea Cup & Saucer</h3>
              <p>fanquare</p>
              <strong>Discover →</strong>
            </div>

          </a>

        </div>

      </section>


      <section class="product-final-cta">

        <p class="product-detail-eyebrow">
          VILLEROY & BOCH · FRENCH GARDEN FLEURENCE
        </p>

        <h2>
          A little garden colour for the everyday table.
        </h2>

        <a
          href="https://amzn.to/4xgp5cN"
          target="_blank"
          rel="nofollow sponsored"
          class="product-shop-button"
        >
          Find It Here →
        </a>

        <p class="affiliate-note affiliate-note-light">
          Affiliate link · KASODI may earn a commission at no extra cost to you.
        </p>

      </section>

    </main>


    <Footer />

  </body>
</html>