---
import "../../styles/global.css";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
---

<html lang="en">
  <head>
    <!-- Google Consent Mode -->
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization_storage: "denied",
        analytics_storage: "denied",
        functionality_storage: "denied",
        personalization_storage: "denied",
        security_storage: "granted",
        wait_for_update: 2000
      });

      gtag("set", "ads_data_redaction", true);
      gtag("set", "url_passthrough", true);
    </script>

    <!-- Start cookieyes banner -->
    <script
      id="cookieyes"
      type="text/javascript"
      src="https://cdn-cookieyes.com/client_data/e9c032e34948c08e8ad6b9973971db36/script.js"
    ></script>
    <!-- End cookieyes banner -->

    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-LT2BEMKHKC"
    ></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-LT2BEMKHKC');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Pink Floral Tea Cup & Saucer | KASODI</title>

    <meta
      name="description"
      content="Discover the Pink Floral Tea Cup & Saucer by fanquare, a romantic porcelain cup with vintage rose decoration and gold trim, selected by KASODI."
    />
  </head>

  <body>

    <Header />


    <main class="product-detail-page">

      <div class="product-breadcrumb">
        <a href="/">Home</a>
        <span>·</span>
        <a href="/tableware">Tableware</a>
        <span>·</span>
        <span>Pink Floral Tea Cup & Saucer</span>
      </div>


      <section class="product-detail-hero">

        <div class="product-detail-image">
          <img
            src="/images/tableware/pink-floral-tea-cup-saucer.png"
            alt="Pink floral porcelain tea cup and saucer by fanquare styled by KASODI"
          />
        </div>


        <div class="product-detail-content">

          <p class="product-detail-eyebrow">
            KASODI FIND · TABLEWARE
          </p>

          <h1>
            Pink Floral Tea Cup & Saucer
          </h1>

          <p class="product-detail-brand">
            fanquare
          </p>

          <p class="product-detail-intro">
            A romantic porcelain cup and saucer decorated with soft pink roses,
            muted green leaves and a delicate gold-tone rim. Its vintage-inspired
            shape and floral pattern make it a beautiful choice for tea, coffee
            and slow afternoon moments.
          </p>


          <div class="product-detail-divider"></div>


          <div class="product-detail-meta">

            <div>
              <span>Material</span>
              <strong>Porcelain</strong>
            </div>

            <div>
              <span>Set</span>
              <strong>1 Cup · 1 Saucer</strong>
            </div>

            <div>
              <span>Capacity</span>
              <strong>200 ml</strong>
            </div>

            <div>
              <span>Cup Size</span>
              <strong>Approx. 9.3 × 7.6 cm</strong>
            </div>

            <div>
              <span>Saucer</span>
              <strong>Approx. 15 cm</strong>
            </div>

            <div>
              <span>Finish</span>
              <strong>Pink Floral · Gold Trim</strong>
            </div>

          </div>


          <div class="affiliate-action">

            <a
              href="https://amzn.to/3TjSzIG"
              target="_blank"
              rel="nofollow sponsored"
              class="product-shop-button"
            >
              Find It Here →
            </a>

            <p class="affiliate-note">
              Affiliate link · KASODI may earn a commission at no extra cost to you.
            </p>

          </div>

        </div>

      </section>


      <section class="why-we-love">

        <div class="why-we-love-label">
          KASODI NOTE
        </div>

        <div class="why-we-love-content">

          <h2>Why we love it</h2>

          <p>
            This is the kind of piece that makes a small everyday ritual feel
            more special. The soft pink roses bring a romantic, vintage mood,
            while the thin gold-tone edging adds just enough polish without
            making the cup feel overly formal.
          </p>

          <p>
            We especially like it for afternoon tea, a quiet coffee moment or a
            beautifully styled breakfast tray. Because the palette is soft and
            classic, it pairs easily with ivory linen, simple pastries, fresh
            flowers and other floral porcelain without looking too coordinated.
          </p>

        </div>

      </section>


      <section class="product-care">

        <p class="product-detail-eyebrow">
          CARE
        </p>

        <h2>Handle decorative porcelain with care</h2>

        <p>
          The product information recommends hand washing and notes that the cup
          is not microwave safe. Use a soft sponge and mild detergent, avoid
          abrasive cleaners and dry carefully to help preserve the floral finish
          and delicate gold-tone rim.
        </p>

      </section>


      <section class="styling-ideas">

        <div class="styling-heading">
          <p>KASODI STYLING</p>
          <h2>Style it with</h2>
        </div>


        <div class="styling-grid">

          <div class="styling-card">
            <span>01</span>
            <h3>Soft Linen</h3>
            <p>
              Ivory, blush or warm beige linen creates a gentle backdrop and
              lets the floral pattern remain the focus.
            </p>
          </div>


          <div class="styling-card">
            <span>02</span>
            <h3>Fresh Flowers</h3>
            <p>
              Peonies, garden roses or small white flowers echo the romantic
              character of the cup without overwhelming the table.
            </p>
          </div>


          <div class="styling-card">
            <span>03</span>
            <h3>Warm Gold Details</h3>
            <p>
              A small gold-tone spoon or subtle metallic accent complements the
              rim and gives the setting a more considered finish.
            </p>
          </div>

        </div>

      </section>


      <section class="continue-exploring">

        <div class="continue-exploring-heading">
          <p>TABLEWARE</p>
          <h2>Continue Exploring</h2>
        </div>

        <div class="continue-exploring-grid">


          <a
            href="/tableware/blue-floral-porcelain-tea-set"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/tableware/blue-floral-porcelain-tea-set.png"
                alt="Blue Floral Porcelain Tea Set"
              />
            </div>

            <div class="continue-card-info">
              <span>TABLEWARE</span>
              <h3>Blue Floral Porcelain Tea Set</h3>
              <p>fanquare</p>
              <strong>Discover →</strong>
            </div>

          </a>


          <a
            href="/tableware/cristal-darques-lady-diamond-wine-glasses"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/tableware/cristal-darques-lady-diamond-wine-glasses.png"
                alt="Lady Diamond Wine Glasses"
              />
            </div>

            <div class="continue-card-info">
              <span>GLASSWARE</span>
              <h3>Lady Diamond Wine Glasses</h3>
              <p>Cristal D'Arques</p>
              <strong>Discover →</strong>
            </div>

          </a>


          <a
            href="/tableware/vintage-gold-cake-serving-set"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/tableware/vintage-gold-cake-serving-set.png"
                alt="Vintage Gold Cake Serving Set"
              />
            </div>

            <div class="continue-card-info">
              <span>TABLEWARE</span>
              <h3>Vintage Gold Cake Serving Set</h3>
              <p>XINCHEN Kitchen</p>
              <strong>Discover →</strong>
            </div>

          </a>

        </div>

      </section>


      <section class="product-final-cta">

        <p class="product-detail-eyebrow">
          FANQUARE · PINK FLORAL PORCELAIN
        </p>

        <h2>
          A romantic detail for a slower tea moment.
        </h2>

        <a
          href="https://amzn.to/3TjSzIG"
          target="_blank"
          rel="nofollow sponsored"
          class="product-shop-button"
        >
          Find It Here →
        </a>

        <p class="affiliate-note affiliate-note-light">
          Affiliate link · KASODI may earn a commission at no extra cost to you.
        </p>

      </section>

    </main>


    <Footer />

  </body>
</html>