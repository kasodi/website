---
import "../../styles/global.css";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
---

<html lang="en">
  <head><!-- Start cookieyes banner --> <script id="cookieyes" type="text/javascript" src="https://cdn-cookieyes.com/client_data/e9c032e34948c08e8ad6b9973971db36/script.js"></script> <!-- End cookieyes banner -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Blue Floral Dessert Plates | KASODI</title>

    <meta
      name="description"
      content="Discover the blue floral porcelain dessert plates by fanquare, selected by KASODI for their soft blue palette, delicate floral pattern and elegant scalloped edges."
    />
  </head>

  <body>

    <Header />


    <main class="product-detail-page">

      <div class="product-breadcrumb">
        <a href="/">Home</a>
        <span>·</span>
        <a href="/new-finds">New Finds</a>
        <span>·</span>
        <span>Blue Floral Dessert Plates</span>
      </div>


      <section class="product-detail-hero">

        <div class="product-detail-image">
          <img
            src="/images/new-finds/fanquare-blue-floral-dessert-plates.png"
            alt="Blue floral porcelain dessert plates by fanquare styled by KASODI"
          />
        </div>


        <div class="product-detail-content">

          <p class="product-detail-eyebrow">
            NEW FINDS · TABLEWARE
          </p>

          <h1>
            Blue Floral Dessert Plates
          </h1>

          <p class="product-detail-brand">
            fanquare
          </p>

          <p class="product-detail-intro">
            A set of four porcelain dessert plates combining a soft powder-blue
            border with delicate floral detailing and gently scalloped edges.
            Their romantic pattern brings character to the table while the
            restrained palette keeps them easy to mix with simple white,
            cream and natural tableware.
          </p>


          <div class="product-detail-divider"></div>


          <div class="product-detail-meta">

            <div>
              <span>Material</span>
              <strong>Porcelain</strong>
            </div>

            <div>
              <span>Set</span>
              <strong>4 plates</strong>
            </div>

            <div>
              <span>Diameter</span>
              <strong>Approx. 20.8 cm</strong>
            </div>

            <div>
              <span>Colour</span>
              <strong>Powder blue · White</strong>
            </div>

            <div>
              <span>Pattern</span>
              <strong>Floral</strong>
            </div>

            <div>
              <span>Care</span>
              <strong>Dishwasher & microwave safe</strong>
            </div>

          </div>


          <div class="affiliate-action">

            <a
              href="https://amzn.to/3UvCqQA"
              target="_blank"
              rel="nofollow sponsored"
              class="product-shop-button"
            >
              Find It Here →
            </a>

            <p class="affiliate-note">
              Affiliate link · KASODI may earn a commission at no extra cost to you.
            </p>

          </div>

        </div>

      </section>


      <section class="why-we-love">

        <div class="why-we-love-label">
          KASODI NOTE
        </div>

        <div class="why-we-love-content">

          <h2>Why we love it</h2>

          <p>
            These plates have the charm of vintage floral china without feeling
            overly formal. The combination of powder blue, white and fine blue
            flowers gives them a delicate character, while the scalloped rim adds
            just enough decorative detail.
          </p>

          <p>
            We especially like them for breakfast, desserts, cakes and relaxed
            afternoon tables. Because the colour palette is so soft, they can be
            styled with simple linen, clear or coloured glassware and warmer
            metallic accents without making the table feel too coordinated.
          </p>

        </div>

      </section>


      <section class="product-care">

        <p class="product-detail-eyebrow">
          CARE
        </p>

        <h2>Made for everyday tables</h2>

        <p>
          The plates are listed as dishwasher and microwave safe. For everyday
          use, stack them carefully and avoid abrasive cleaning products that
          could dull the decorative surface over time.
        </p>

      </section>


      <section class="styling-ideas">

        <div class="styling-heading">
          <p>KASODI STYLING</p>
          <h2>Style it with</h2>
        </div>


        <div class="styling-grid">

          <div class="styling-card">
            <span>01</span>
            <h3>Natural Linen</h3>
            <p>
              Warm ivory, oatmeal or pale beige linen softens the blue palette
              and keeps the setting relaxed.
            </p>
          </div>


          <div class="styling-card">
            <span>02</span>
            <h3>Green Glassware</h3>
            <p>
              Muted green or clear textured glasses introduce another layer of
              colour without competing with the floral pattern.
            </p>
          </div>


          <div class="styling-card">
            <span>03</span>
            <h3>Warm Gold</h3>
            <p>
              Brushed-gold or brass cutlery brings warmth to the cool blue tones
              and makes the plates feel more collected.
            </p>
          </div>

        </div>

      </section>


      <section class="continue-exploring">

        <div class="continue-exploring-heading">
          <p>NEW FINDS</p>
          <h2>Continue Exploring</h2>
        </div>

        <div class="continue-exploring-grid">


          <a
            href="/new-finds/joeyan-green-champagne-glasses"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/new-finds/joeyan-green-champagne-glasses.png"
                alt="Vintage Green Champagne Glasses"
              />
            </div>

            <div class="continue-card-info">
              <span>GLASSWARE</span>
              <h3>Vintage Green Champagne Glasses</h3>
              <p>Joeyan</p>
              <strong>Discover →</strong>
            </div>

          </a>


          <a
            href="/kasodi-edit/boston-green-wine-glass"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/kasodi-edit/kasodi-edit-villeroy-boch-boston-green-glass.png"
                alt="Boston Green Wine Glass"
              />
            </div>

            <div class="continue-card-info">
              <span>GLASSWARE</span>
              <h3>Boston Green Wine Glass</h3>
              <p>Villeroy & Boch</p>
              <strong>Discover →</strong>
            </div>

          </a>


          <a
            href="/kasodi-edit/botanical-vintage-pitcher"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/kasodi-edit/kasodi-edit-floral-ceramic-pitcher.png"
                alt="Botanical Vintage Pitcher"
              />
            </div>

            <div class="continue-card-info">
              <span>HOME DECOR</span>
              <h3>Botanical Vintage Pitcher</h3>
              <p>Ethereal Eves</p>
              <strong>Discover →</strong>
            </div>

          </a>

        </div>

      </section>


      <section class="product-final-cta">

        <p class="product-detail-eyebrow">
          FANQUARE · FLORAL PORCELAIN
        </p>

        <h2>
          A little blue for a table with character.
        </h2>

        <a
          href="https://amzn.to/3UvCqQA"
          target="_blank"
          rel="nofollow sponsored"
          class="product-shop-button"
        >
          Find It Here →
        </a>

        <p class="affiliate-note affiliate-note-light">
          Affiliate link · KASODI may earn a commission at no extra cost to you.
        </p>

      </section>

    </main>


    <Footer />

  </body>
</html>