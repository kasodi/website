---
import "../../styles/global.css";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Vintage Butterfly Photo Frame | KASODI</title>

    <meta
      name="description"
      content="Discover the Vintage Butterfly Photo Frame by LEYI DECOR, selected by KASODI for its antique-inspired metalwork, turquoise detailing and jewel-like character."
    />
  </head>

  <body>

    <Header />

    <main class="product-detail-page">

      <div class="product-breadcrumb">
        <a href="/">Home</a>
        <span>·</span>
        <a href="/new-finds">New Finds</a>
        <span>·</span>
        <span>Vintage Butterfly Photo Frame</span>
      </div>


      <section class="product-detail-hero">

        <div class="product-detail-image">
          <img
            src="/images/new-finds/vintage-butterfly-photo-frame.png"
            alt="Vintage butterfly photo frame by LEYI DECOR styled by KASODI"
          />
        </div>


        <div class="product-detail-content">

          <p class="product-detail-eyebrow">
            NEW FINDS · DECORATIVE OBJECTS
          </p>

          <h1>
            Vintage Butterfly Photo Frame
          </h1>

          <p class="product-detail-brand">
            LEYI DECOR
          </p>

          <p class="product-detail-intro">
            A small decorative photo frame shaped like an ornate butterfly,
            combining antique-inspired metalwork with turquoise and ivory
            detailing. Crystal-like accents give it the character of a
            vintage jewellery-box find, turning a favourite photograph into
            a decorative object in its own right.
          </p>


          <div class="product-detail-divider"></div>


          <div class="product-detail-meta">

            <div>
              <span>Material</span>
              <strong>Metal</strong>
            </div>

            <div>
              <span>Size</span>
              <strong>Approx. 11 × 9 cm</strong>
            </div>

            <div>
              <span>Colour</span>
              <strong>Antique gold · Turquoise · Ivory</strong>
            </div>

            <div>
              <span>Style</span>
              <strong>Vintage inspired</strong>
            </div>

            <div>
              <span>Orientation</span>
              <strong>Vertical</strong>
            </div>

            <div>
              <span>Ideal for</span>
              <strong>Photos · Shelf styling · Bedside tables</strong>
            </div>

          </div>


          <div class="affiliate-action">

            <a
              href="https://temu.to/k/eg0axfs3rb1"
              target="_blank"
              rel="nofollow sponsored"
              class="product-shop-button"
            >
              Find It Here →
            </a>

            <p class="affiliate-note">
              Affiliate link · KASODI may earn a commission at no extra cost to you.
            </p>

          </div>

        </div>

      </section>


      <section class="why-we-love">

        <div class="why-we-love-label">
          KASODI NOTE
        </div>

        <div class="why-we-love-content">

          <h2>Why we love it</h2>

          <p>
            This is the kind of small decorative object that can give a shelf,
            bedside table or dressing table personality. Rather than disappearing
            into the background, the butterfly silhouette turns the frame itself
            into part of the display.
          </p>

          <p>
            We especially like the combination of aged gold tones, turquoise
            detailing and crystal-like accents. It has the character of a vintage
            market find and works beautifully among books, ceramics, flowers and
            other collected objects. At approximately 11 × 9 cm, it is small
            enough to add detail without overwhelming a composition.
          </p>

        </div>

      </section>


      <section class="product-care">

        <p class="product-detail-eyebrow">
          CARE
        </p>

        <h2>A little object to treasure</h2>

        <p>
          Dust gently with a soft, dry cloth and avoid abrasive cleaners that
          could damage the painted finish or decorative details. Keep the frame
          away from prolonged moisture and handle the embellished areas with
          care when changing the photograph.
        </p>

      </section>


      <section class="styling-ideas">

        <div class="styling-heading">
          <p>KASODI STYLING</p>
          <h2>Style it with</h2>
        </div>


        <div class="styling-grid">

          <div class="styling-card">
            <span>01</span>
            <h3>Old Books</h3>
            <p>
              Place it beside a small stack of vintage or linen-bound books
              to create a layered, collected display.
            </p>
          </div>


          <div class="styling-card">
            <span>02</span>
            <h3>Soft Florals</h3>
            <p>
              Cream, blush or faded garden flowers soften the ornate metalwork
              and complement its romantic character.
            </p>
          </div>


          <div class="styling-card">
            <span>03</span>
            <h3>Warm Wood</h3>
            <p>
              Style it on a wooden console, bedside table or shelf to bring
              warmth to the antique-gold and turquoise details.
            </p>
          </div>

        </div>

      </section>


      <section class="continue-exploring">

        <div class="continue-exploring-heading">
          <p>NEW FINDS</p>
          <h2>Continue Exploring</h2>
        </div>

        <div class="continue-exploring-grid">


          <a
            href="/new-finds/joeyan-green-champagne-glasses"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/new-finds/joeyan-green-champagne-glasses.png"
                alt="Vintage Green Champagne Glasses"
              />
            </div>

            <div class="continue-card-info">
              <span>GLASSWARE</span>
              <h3>Vintage Green Champagne Glasses</h3>
              <p>Joeyan</p>
              <strong>Discover →</strong>
            </div>

          </a>


          <a
            href="/new-finds/fanquare-blue-floral-dessert-plates"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/new-finds/fanquare-blue-floral-dessert-plates.png"
                alt="Blue Floral Dessert Plates"
              />
            </div>

            <div class="continue-card-info">
              <span>TABLEWARE</span>
              <h3>Blue Floral Dessert Plates</h3>
              <p>fanquare</p>
              <strong>Discover →</strong>
            </div>

          </a>


          <a
            href="/kasodi-edit/botanical-vintage-pitcher"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/kasodi-edit/kasodi-edit-floral-ceramic-pitcher.png"
                alt="Botanical Vintage Pitcher"
              />
            </div>

            <div class="continue-card-info">
              <span>HOME DECOR</span>
              <h3>Botanical Vintage Pitcher</h3>
              <p>Ethereal Eves</p>
              <strong>Discover →</strong>
            </div>

          </a>

        </div>

      </section>


      <section class="product-final-cta">

        <p class="product-detail-eyebrow">
          LEYI DECOR · VINTAGE DETAILS
        </p>

        <h2>
          A little treasure for a favourite memory.
        </h2>

        <a
          href="https://temu.to/k/eg0axfs3rb1"
          target="_blank"
          rel="nofollow sponsored"
          class="product-shop-button"
        >
          Find It Here →
        </a>

        <p class="affiliate-note affiliate-note-light">
          Affiliate link · KASODI may earn a commission at no extra cost to you.
        </p>

      </section>

    </main>


    <Footer />

  </body>
</html>