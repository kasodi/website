---
import "../../styles/global.css";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
---

<html lang="en">
  <head><!-- Google Consent Mode -->
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }

  gtag("consent", "default", {
    ad_storage: "denied",
    ad_user_data: "denied",
    ad_personalization: "denied",
    analytics_storage: "denied",
    functionality_storage: "denied",
    personalization_storage: "denied",
    security_storage: "granted",
    wait_for_update: 2000
  });

  gtag("set", "ads_data_redaction", true);
  gtag("set", "url_passthrough", true);
</script>

<!-- Start cookieyes banner -->
<script id="cookieyes" type="text/javascript" src="https://cdn-cookieyes.com/client_data/e9c032e34948c08e8ad6b9973971db36/script.js"></script>
<!-- End cookieyes banner -->

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-LT2BEMKHKC"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-LT2BEMKHKC');
</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>New Finds | KASODI</title>

    <meta
      name="description"
      content="Explore the latest KASODI finds for the home — curated tableware, decorative objects, textiles and distinctive pieces selected for beauty, character and everyday living."
    />
  </head>

  <body>

    <Header />


    <main class="new-finds-page">

      <div class="product-breadcrumb">
        <a href="/">Home</a>
        <span>·</span>
        <span>New Finds</span>
      </div>


      <section class="new-finds-page-hero">

        <p class="product-detail-eyebrow">
          NEW FINDS
        </p>

        <h1>
          Fresh Finds for the Home
        </h1>

        <p class="new-finds-page-intro">
          A growing collection of pieces worth discovering — selected for
          beauty, character, usefulness and the way they can make everyday
          spaces feel more personal.
        </p>

      </section>


      <section class="new-finds-catalog">

        <div class="new-finds-catalog-grid">


          <!-- 01 BLUE FLORAL DESSERT PLATES -->

          <article class="new-find-card">

            <img
              src="/images/new-finds/fanquare-blue-floral-dessert-plates.png"
              alt="Blue floral porcelain dessert plates by fanquare"
            />

            <p class="new-find-category">
              TABLEWARE
            </p>

            <h2>
              Blue Floral Dessert Plates
            </h2>

            <p class="new-find-price">
              fanquare
            </p>

            <a href="/new-finds/fanquare-blue-floral-dessert-plates">
              Discover →
            </a>

          </article>


          <!-- 02 VINTAGE BUTTERFLY PHOTO FRAME -->

          <article class="new-find-card">

            <img
              src="/images/new-finds/vintage-butterfly-photo-frame.png"
              alt="Vintage butterfly photo frame by LEVI DECOR"
            />

            <p class="new-find-category">
              DECORATIVE OBJECTS
            </p>

            <h2>
              Vintage Butterfly Photo Frame
            </h2>

            <p class="new-find-price">
              LEVI DECOR
            </p>

            <a href="/new-finds/vintage-butterfly-photo-frame">
              Discover →
            </a>

          </article>


          <!-- 03 VINTAGE BOTANICAL JEWELRY BOX -->

          <article class="new-find-card">

            <img
              src="/images/new-finds/vintage-botanical-jewelry-box.png"
              alt="Vintage botanical ceramic jewelry box by Tila Home"
            />

            <p class="new-find-category">
              DECORATIVE OBJECTS
            </p>

            <h2>
              Vintage Botanical Jewelry Box
            </h2>

            <p class="new-find-price">
              Tila Home
            </p>

            <a href="/new-finds/vintage-botanical-jewelry-box">
              Discover →
            </a>

          </article>


          <!-- 04 VINTAGE BOTANICAL DUVET COVER SET -->

          <article class="new-find-card">

            <img
              src="/images/new-finds/vintage-botanical-duvet-cover-set.png"
              alt="Vintage botanical duvet cover set by Fashionbedding"
            />

            <p class="new-find-category">
              HOME TEXTILES
            </p>

            <h2>
              Vintage Botanical Duvet Cover Set
            </h2>

            <p class="new-find-price">
              Fashionbedding
            </p>

            <a href="/new-finds/vintage-botanical-duvet-cover-set">
              Discover →
            </a>

          </article>


          <!-- 05 VINTAGE GREEN CHAMPAGNE GLASSES -->

          <article class="new-find-card">

            <img
              src="/images/new-finds/joeyan-green-champagne-glasses.png"
              alt="Vintage green champagne glasses by Joeyan"
            />

            <p class="new-find-category">
              GLASSWARE
            </p>

            <h2>
              Vintage Green Champagne Glasses
            </h2>

            <p class="new-find-price">
              Joeyan
            </p>

            <a href="/new-finds/joeyan-green-champagne-glasses">
              Discover →
            </a>

          </article>


        </div>

      </section>


      <section class="product-final-cta">

        <p class="product-detail-eyebrow">
          KASODI · NEW FINDS
        </p>

        <h2>
          Pieces with character,
          chosen one find at a time.
        </h2>

        <a
          href="/#new-finds"
          class="product-shop-button"
        >
          Back to Home →
        </a>

      </section>

    </main>


    <Footer />

  </body>
</html>