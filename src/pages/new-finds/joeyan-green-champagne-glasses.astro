---
import "../../styles/global.css";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Vintage Green Champagne Glasses | KASODI</title>

    <meta
      name="description"
      content="Discover vintage-inspired green champagne glasses by Joeyan, selected by KASODI for their textured glass, sculptural stems and distinctive colour."
    />
  </head>

  <body>

    <Header />


    <main class="product-detail-page">

      <!-- BREADCRUMBS -->

      <div class="product-breadcrumb">
        <a href="/">Home</a>
        <span>·</span>
        <a href="/new-finds">New Finds</a>
        <span>·</span>
        <span>Vintage Green Champagne Glasses</span>
      </div>


      <!-- PRODUCT HERO -->

      <section class="product-detail-hero">

        <div class="product-detail-image">
          <img
            src="/images/new-finds/joeyan-green-champagne-glasses.png"
            alt="Joeyan vintage green champagne glasses styled by KASODI"
          />
        </div>


        <div class="product-detail-content">

          <p class="product-detail-eyebrow">
            NEW FINDS · GLASSWARE
          </p>

          <h1>
            Vintage Green Champagne Glasses
          </h1>

          <p class="product-detail-brand">
            Joeyan
          </p>

          <p class="product-detail-intro">
            A set of four vintage-inspired champagne glasses in a soft
            olive-green tone, finished with a delicate raised texture and
            sculptural stems. Their distinctive silhouette brings colour and
            character to everyday tables while still feeling elegant enough
            for celebrations.
          </p>


          <div class="product-detail-divider"></div>


          <div class="product-detail-meta">

            <div>
              <span>Material</span>
              <strong>Lead-free glass</strong>
            </div>

            <div>
              <span>Set</span>
              <strong>4 glasses</strong>
            </div>

            <div>
              <span>Capacity</span>
              <strong>150 ml each</strong>
            </div>

            <div>
              <span>Height</span>
              <strong>Approx. 20 cm</strong>
            </div>

            <div>
              <span>Colour</span>
              <strong>Olive green</strong>
            </div>

            <div>
              <span>Care</span>
              <strong>Dishwasher safe</strong>
            </div>

          </div>


          <div class="affiliate-action">

            <a
              href="https://amzn.to/3SIoXEy"
              target="_blank"
              rel="nofollow sponsored"
              class="product-shop-button"
            >
              Find It Here →
            </a>

            <p class="affiliate-note">
              Affiliate link · KASODI may earn a commission at no extra cost to you.
            </p>

          </div>

        </div>

      </section>


      <!-- WHY WE LOVE IT -->

      <section class="why-we-love">

        <div class="why-we-love-label">
          KASODI NOTE
        </div>

        <div class="why-we-love-content">

          <h2>Why we love it</h2>

          <p>
            These glasses have exactly the kind of detail that can make a table
            feel considered without making it formal. The muted green colour is
            distinctive but easy to combine with ivory ceramics, natural linen,
            wood and warm metallic accents.
          </p>

          <p>
            We especially like the combination of the raised texture and
            sculptural stem. It gives them a vintage character while the simple
            cylindrical bowl keeps the overall look fresh. Sold as a set of four,
            they are an easy way to introduce colour and personality to a table.
          </p>

        </div>

      </section>


      <!-- CARE -->

      <section class="product-care">

        <p class="product-detail-eyebrow">
          CARE
        </p>

        <h2>Made for celebrating</h2>

        <p>
          The glasses are listed as dishwasher safe, making them suitable for
          both everyday use and special occasions. For lasting clarity and shine,
          place them securely in the dishwasher so they do not knock against
          other glassware during the wash cycle.
        </p>

      </section>


      <!-- STYLE IT WITH -->

      <section class="styling-ideas">

        <div class="styling-heading">
          <p>KASODI STYLING</p>
          <h2>Style it with</h2>
        </div>


        <div class="styling-grid">

          <div class="styling-card">
            <span>01</span>

            <h3>Natural Linen</h3>

            <p>
              Ivory, oatmeal or warm beige linen lets the soft green glass
              become the colour accent on the table.
            </p>
          </div>


          <div class="styling-card">
            <span>02</span>

            <h3>Warm Ceramics</h3>

            <p>
              Pair the glasses with cream, stone or softly aged ceramics
              for a relaxed and collected table setting.
            </p>
          </div>


          <div class="styling-card">
            <span>03</span>

            <h3>Brushed Gold</h3>

            <p>
              Brass or brushed-gold cutlery adds warmth and complements
              the vintage-inspired green stems beautifully.
            </p>
          </div>

        </div>

      </section>


      <!-- CONTINUE EXPLORING -->

      <section class="continue-exploring">

        <div class="continue-exploring-heading">
          <p>KASODI EDIT</p>
          <h2>Continue Exploring</h2>
        </div>


        <div class="continue-exploring-grid">


          <!-- BOSTON -->

          <a
            href="/kasodi-edit/boston-green-wine-glass"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/kasodi-edit/kasodi-edit-villeroy-boch-boston-green-glass.png"
                alt="Boston Green Wine Glass by Villeroy & Boch"
              />
            </div>

            <div class="continue-card-info">
              <span>GLASSWARE</span>
              <h3>Boston Green Wine Glass</h3>
              <p>Villeroy & Boch</p>
              <strong>Discover →</strong>
            </div>

          </a>


          <!-- PITCHER -->

          <a
            href="/kasodi-edit/botanical-vintage-pitcher"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/kasodi-edit/kasodi-edit-floral-ceramic-pitcher.png"
                alt="Botanical Vintage Pitcher by Ethereal Eves"
              />
            </div>

            <div class="continue-card-info">
              <span>HOME DECOR</span>
              <h3>Botanical Vintage Pitcher</h3>
              <p>Ethereal Eves</p>
              <strong>Discover →</strong>
            </div>

          </a>


          <!-- CUSHIONS -->

          <a
            href="/kasodi-edit/embroidered-garden-cushions"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/kasodi-edit/kasodi-edit-embroidered-green-cushions.png"
                alt="Embroidered Garden Cushions by Running Elephant"
              />
            </div>

            <div class="continue-card-info">
              <span>TEXTILES & COZY</span>
              <h3>Embroidered Garden Cushions</h3>
              <p>Running Elephant</p>
              <strong>Discover →</strong>
            </div>

          </a>

        </div>

      </section>


      <!-- FINAL CTA -->

      <section class="product-final-cta">

        <p class="product-detail-eyebrow">
          JOEYAN · VINTAGE GLASSWARE
        </p>

        <h2>
          A vintage touch for the everyday table.
        </h2>

        <a
          href="https://amzn.to/3SIoXEy"
          target="_blank"
          rel="nofollow sponsored"
          class="product-shop-button"
        >
          Find It Here →
        </a>

        <p class="affiliate-note affiliate-note-light">
          Affiliate link · KASODI may earn a commission at no extra cost to you.
        </p>

      </section>

    </main>


    <!-- FOOTER -->

   <Footer />

  </body>
</html>