---
import "../../styles/global.css";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Embroidered Garden Cushions | KASODI</title>

    <meta
      name="description"
      content="Discover Embroidered Garden Cushion Covers by Running Elephant, a set of two vintage-inspired floral chenille covers selected by KASODI for their rich colour and decorative embroidery."
    />
  </head>

  <body>

    <Header />


    <main class="product-detail-page">

      <div class="product-breadcrumb">
        <a href="/">Home</a>
        <span>·</span>
        <a href="/kasodi-edit">KASODI Edit</a>
        <span>·</span>
        <span>EMBROIDERED GARDEN CUSHIONS</span>
      </div>


      <section class="product-detail-hero">

        <div class="product-detail-image">
          <img
            src="/images/kasodi-edit/kasodi-edit-embroidered-green-cushions.png"
            alt="Embroidered Garden Cushion Covers by Running Elephant"
          />
        </div>


        <div class="product-detail-content">

          <p class="product-detail-eyebrow">
            KASODI EDIT · TEXTILES & COZY
          </p>

          <h1>
            Embroidered Garden Cushions
          </h1>

          <p class="product-detail-brand">
            Running Elephant
          </p>

          <p class="product-detail-intro">
            A set of two decorative chenille cushion covers with richly
            embroidered florals and a softly vintage character. The deep
            fern-green ground, multicoloured botanical motif and striped
            edging give them the feeling of collected textile pieces,
            bringing colour and detail to sofas, beds and reading corners.
          </p>


          <div class="product-detail-divider"></div>


          <div class="product-detail-meta">

            <div>
              <span>Material</span>
              <strong>Chenille · Polyester</strong>
            </div>

            <div>
              <span>Set</span>
              <strong>2 cushion covers</strong>
            </div>

            <div>
              <span>Dimensions</span>
              <strong>Approx. 46 × 46 cm</strong>
            </div>

            <div>
              <span>Fits</span>
              <strong>45 × 45 cm insert</strong>
            </div>

            <div>
              <span>Closure</span>
              <strong>Zipper</strong>
            </div>

            <div>
              <span>Detail</span>
              <strong>Floral embroidery</strong>
            </div>

          </div>


          <div class="affiliate-action">

            <a
              href="https://temu.to/k/eyyvr13i1bk"
              target="_blank"
              rel="nofollow sponsored"
              class="product-shop-button"
            >
              Find It Here →
            </a>

            <p class="affiliate-note">
              Affiliate link · KASODI may earn a commission at no extra cost to you.
            </p>

          </div>

        </div>

      </section>


      <section class="why-we-love">

        <div class="why-we-love-label">
          KASODI NOTE
        </div>

        <div class="why-we-love-content">

          <h2>Why we love it</h2>

          <p>
            These cushion covers bring together the richness of traditional
            floral textiles with a colour palette that feels surprisingly
            easy to style. The embroidered botanical motif gives the surface
            depth and detail, while the muted fern-green background keeps the
            overall look elegant rather than overly decorative.
          </p>

          <p>
            We especially like them as an accent on a neutral sofa or layered
            with plain linen and velvet cushions. Used as a pair, they can
            instantly make a simple seating area feel more collected,
            comfortable and personal.
          </p>

        </div>

      </section>


      <section class="product-care">

        <p class="product-detail-eyebrow">
          CARE
        </p>

        <h2>Made for everyday living</h2>

        <p>
          The product listing specifies that the covers are machine washable.
          Close the zipper before washing and treat the embroidered surface
          gently to help preserve its texture and decorative detail over time.
        </p>

      </section>


      <section class="styling-ideas">

        <div class="styling-heading">
          <p>KASODI STYLING</p>
          <h2>Style it with</h2>
        </div>


        <div class="styling-grid">

          <div class="styling-card">
            <span>01</span>
            <h3>Warm Neutrals</h3>
            <p>
              Let the embroidery stand out against ivory, oatmeal or warm
              beige upholstery for a balanced and quietly elegant look.
            </p>
          </div>

          <div class="styling-card">
            <span>02</span>
            <h3>Soft Velvet</h3>
            <p>
              Layer them with plain olive, burgundy or muted rose velvet
              cushions to pick up the deeper colours in the floral pattern.
            </p>
          </div>

          <div class="styling-card">
            <span>03</span>
            <h3>Antique Brass</h3>
            <p>
              Pair the cushions with warm brass lighting, aged frames or
              small metallic accents to echo their vintage-inspired character.
            </p>
          </div>

        </div>

      </section>


      <section class="continue-exploring">

        <div class="continue-exploring-heading">
          <p>KASODI EDIT</p>
          <h2>Continue Exploring</h2>
        </div>


        <div class="continue-exploring-grid">


          <a
            href="/kasodi-edit/boston-green-wine-glass"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/kasodi-edit/kasodi-edit-villeroy-boch-boston-green-glass.png"
                alt="Boston Green Wine Glass by Villeroy & Boch"
              />
            </div>

            <div class="continue-card-info">
              <span>GLASSWARE</span>
              <h3>Boston Green Wine Glass</h3>
              <p>Villeroy & Boch</p>
              <strong>Discover →</strong>
            </div>

          </a>


          <a
            href="/kasodi-edit/botanical-vintage-pitcher"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/kasodi-edit/kasodi-edit-floral-ceramic-pitcher.png"
                alt="Botanical Vintage Pitcher by Ethereal Eves"
              />
            </div>

            <div class="continue-card-info">
              <span>HOME DECOR</span>
              <h3>Botanical Vintage Pitcher</h3>
              <p>Ethereal Eves</p>
              <strong>Discover →</strong>
            </div>

          </a>


          <a
            href="/kasodi-edit/sculptural-ivory-candles"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/kasodi-edit/kasodi-edit-sculptural-ivory-candles.png"
                alt="Sculptural Ivory Candles by ALMA DE LLAMA"
              />
            </div>

            <div class="continue-card-info">
              <span>CANDLES & FRAGRANCE</span>
              <h3>Sculptural Ivory Candles</h3>
              <p>ALMA DE LLAMA</p>
              <strong>Discover →</strong>
            </div>

          </a>


        </div>

      </section>


      <section class="product-final-cta">

        <p class="product-detail-eyebrow">
          RUNNING ELEPHANT · EMBROIDERED GARDEN
        </p>

        <h2>
          A little pattern can change the whole room.
        </h2>

        <a
          href="https://temu.to/k/eyyvr13i1bk"
          target="_blank"
          rel="nofollow sponsored"
          class="product-shop-button"
        >
          Find It Here →
        </a>

        <p class="affiliate-note affiliate-note-light">
          Affiliate link · KASODI may earn a commission at no extra cost to you.
        </p>

      </section>

    </main>


    <Footer />

  </body>
</html>