    <strong>15 × 18 cm</strong>
  </div>

  <div>
    <span>Colour</span>
    <strong>Ivory · Green · Ochre</strong>
  </div>

  <div>
    <span>Style</span>
    <strong>Botanical · Vintage</strong>
  </div>

  <div>
    <span>Finish</span>
    <strong>Crackle glaze</strong>
  </div>

  <div>
    <span>Ideal for</span>
    <strong>Flowers · Table · Shelf styling</strong>
  </div>

</div>


          <div class="affiliate-action">

            <a
              href="https://temu.to/k/en5769vhsjq"
              target="_blank"
              rel="nofollow sponsored"
              class="product-shop-button"
            >
              Find It Here →
