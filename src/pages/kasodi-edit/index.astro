---
import "../../styles/global.css";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
---

<html lang="en">
  <head><!-- Google Consent Mode -->
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }

  gtag("consent", "default", {
    ad_storage: "denied",
    ad_user_data: "denied",
    ad_personalization: "denied",
    analytics_storage: "denied",
    functionality_storage: "denied",
    personalization_storage: "denied",
    security_storage: "granted",
    wait_for_update: 2000
  });

  gtag("set", "ads_data_redaction", true);
  gtag("set", "url_passthrough", true);
</script>

<!-- Start cookieyes banner -->
<script id="cookieyes" type="text/javascript" src="https://cdn-cookieyes.com/client_data/e9c032e34948c08e8ad6b9973971db36/script.js"></script>
<!-- End cookieyes banner -->

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-LT2BEMKHKC"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-LT2BEMKHKC');
</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>KASODI Edit | KASODI</title>

    <meta
      name="description"
      content="Explore the KASODI Edit — a curated selection of distinctive tableware, home decor, textiles and beautiful objects chosen for character, beauty and everyday living."
    />
  </head>

  <body>

    <Header />


    <main class="new-finds-page">

      <div class="product-breadcrumb">
        <a href="/">Home</a>
        <span>·</span>
        <span>KASODI Edit</span>
      </div>


      <section class="new-finds-page-hero">

        <p class="product-detail-eyebrow">
          KASODI · CURATED EDIT
        </p>

        <h1>
          Beautiful Things, Thoughtfully Chosen
        </h1>

        <p class="new-finds-page-intro">
          A considered selection of objects we love for their beauty,
          character and ability to make everyday spaces feel more personal.
          From distinctive tableware to decorative details, every piece is
          chosen with the KASODI point of view.
        </p>

      </section>


      <section class="new-finds-catalog">

        <div class="new-finds-catalog-grid">


          <!-- 01 BOSTON GREEN WINE GLASS -->

          <article class="new-find-card">

            <img
              src="/images/kasodi-edit/kasodi-edit-villeroy-boch-boston-green-glass.png"
              alt="Boston green wine glass by Villeroy and Boch"
            />

            <p class="new-find-category">
              TABLEWARE
            </p>

            <h2>
              Boston Green Wine Glass
            </h2>

            <p class="new-find-price">
              Villeroy & Boch
            </p>

            <a href="/kasodi-edit/boston-green-wine-glass">
              Discover →
            </a>

          </article>


          <!-- 02 BOTANICAL VINTAGE PITCHER -->

          <article class="new-find-card">

            <img
              src="/images/kasodi-edit/kasodi-edit-floral-ceramic-pitcher.png"
              alt="Botanical vintage ceramic pitcher by Ethereal Eves"
            />

            <p class="new-find-category">
              HOME DECOR
            </p>

            <h2>
              Botanical Vintage Pitcher
            </h2>

            <p class="new-find-price">
              Ethereal Eves
            </p>

            <a href="/kasodi-edit/botanical-vintage-pitcher">
              Discover →
            </a>

          </article>


          <!-- 03 SCULPTURAL IVORY CANDLES -->

          <article class="new-find-card">

            <img
              src="/images/kasodi-edit/kasodi-edit-sculptural-ivory-candles.png"
              alt="Sculptural ivory candles by ALMA DE LLAMA"
            />

            <p class="new-find-category">
              CANDLES
            </p>

            <h2>
              Sculptural Ivory Candles
            </h2>

            <p class="new-find-price">
              ALMA DE LLAMA
            </p>

            <a href="/kasodi-edit/sculptural-ivory-candles">
              Discover →
            </a>

          </article>


          <!-- 04 EMBROIDERED GARDEN CUSHIONS -->

          <article class="new-find-card">

            <img
              src="/images/kasodi-edit/kasodi-edit-embroidered-green-cushions.png"
              alt="Embroidered garden cushions by Running Elephant"
            />

            <p class="new-find-category">
              HOME TEXTILES
            </p>

            <h2>
              Embroidered Garden Cushions
            </h2>

            <p class="new-find-price">
              Running Elephant
            </p>

            <a href="/kasodi-edit/embroidered-garden-cushions">
              Discover →
            </a>

          </article>


        </div>

      </section>


      <section class="product-final-cta">

        <p class="product-detail-eyebrow">
          KASODI · CURATED EDIT
        </p>

        <h2>
          Not more things.
          Better chosen ones.
        </h2>

        <a
          href="/"
          class="product-shop-button"
        >
          Back to Home →
        </a>

      </section>

    </main>


    <Footer />

  </body>
</html>