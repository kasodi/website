---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
---

<html lang="en">
  <head><!-- Start cookieyes banner --> <script id="cookieyes" type="text/javascript" src="https://cdn-cookieyes.com/client_data/e9c032e34948c08e8ad6b9973971db36/script.js"></script> <!-- End cookieyes banner -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Affiliate Disclosure | KASODI</title>

    <meta
      name="description"
      content="Learn how KASODI uses affiliate links and works with selected retailers, brands and affiliate networks."
    />
  </head>

  <body>

   <Header />


    <main class="policy-page">

      <section class="policy-hero">

        <p class="policy-eyebrow">
          TRANSPARENCY
        </p>

        <h1>
          Affiliate Disclosure
        </h1>

        <p class="policy-intro">
          Transparency matters to us. This page explains how affiliate links
          work on KASODI and how they support our independent curation.
        </p>

        <p class="policy-updated">
          Last updated: August 2026
        </p>

      </section>


      <section class="policy-content">

        <div class="policy-section">

          <span class="policy-number">01</span>

          <div>
            <h2>How affiliate links work</h2>

            <p>
              KASODI is an independent home and lifestyle curation platform
              based in Spain and created for readers in Spain and across Europe.
              Some of the links on this website are affiliate links.
            </p>

            <p>
              This means that if you click an affiliate link and make a
              qualifying purchase, KASODI may receive a commission from the
              retailer, brand or affiliate network. This does not add any
              additional cost to you.
            </p>
          </div>

        </div>


        <div class="policy-section">

          <span class="policy-number">02</span>

          <div>
            <h2>Our affiliate partners</h2>

            <p>
              KASODI participates in affiliate programs with selected
              retailers, brands, marketplaces and affiliate networks whose
              products may be relevant to our audience.
            </p>

            <p>
              Our current affiliate relationships include Amazon.es through
              the Amazon Associates Program and the Temu Affiliate Program.
              KASODI may also participate in additional affiliate programs
              and networks as our collection and partnerships develop.
            </p>
          </div>

        </div>


        <div class="policy-section">

          <span class="policy-number">03</span>

          <div>
            <h2>Amazon Associates disclosure</h2>

            <p>
              KASODI participates in the Amazon EU Associates Programme, an
              affiliate advertising programme designed to provide a means for
              websites to earn advertising fees by linking to Amazon.es and
              affiliated websites.
            </p>

            <p>
              As an Amazon Associate, KASODI earns from qualifying purchases.
            </p>
          </div>

        </div>


        <div class="policy-section">

          <span class="policy-number">04</span>

          <div>
            <h2>Temu affiliate links</h2>

            <p>
              KASODI also participates in the Temu Affiliate Program. Some
              links to Temu products may therefore be affiliate links, and
              KASODI may receive a commission when an eligible purchase is
              made through those links.
            </p>

            <p>
              Using an affiliate link does not increase the price paid by
              the customer.
            </p>
          </div>

        </div>


        <div class="policy-section">

          <span class="policy-number">05</span>

          <div>
            <h2>How we choose products</h2>

            <p>
              Affiliate relationships do not automatically determine which
              products appear on KASODI.
            </p>

            <p>
              We select products based on factors such as design, usefulness,
              materials, value, distinctive details and their overall fit with
              the KASODI point of view.
            </p>

            <p>
              Some products may come from affiliate partners, while others may
              be featured simply because we believe they are worth discovering.
            </p>
          </div>

        </div>


        <div class="policy-section">

          <span class="policy-number">06</span>

          <div>
            <h2>Prices and product information</h2>

            <p>
              Product prices, availability, specifications and retailer
              information may change after an item has been featured on
              KASODI.
            </p>

            <p>
              The retailer's website should always be considered the current
              source for final pricing, availability, delivery terms and
              product details before making a purchase.
            </p>
          </div>

        </div>


        <div class="policy-section">

          <span class="policy-number">07</span>

          <div>
            <h2>Questions</h2>

            <p>
              If you have questions about our affiliate relationships or this
              disclosure, you can contact KASODI at:
            </p>

            <a
              class="policy-email"
              href="mailto:kasodi.info@gmail.com"
            >
              kasodi.info@gmail.com
            </a>
          </div>

        </div>

      </section>


      <section class="policy-final">

        <p class="policy-eyebrow">
          KASODI
        </p>

        <h2>
          Thoughtfully selected. Transparently shared.
        </h2>

        <a href="/#collections" class="product-shop-button">
          Explore the Collection →
        </a>

      </section>

    </main>


    <Footer />

  </body>
</html>


<style>

  .policy-page {
    background: #f8f5ef;
    color: #29251f;
  }


  .policy-hero {
    max-width: 1000px;
    margin: 0 auto;
    padding: 110px 40px 100px;
    text-align: center;
  }


  .policy-eyebrow {
    margin: 0 0 25px;
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #917552;
  }


  .policy-hero h1 {
    margin: 0 auto 35px;
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
    font-size: clamp(48px, 6vw, 78px);
    line-height: 1.05;
  }


  .policy-intro {
    max-width: 720px;
    margin: 0 auto;
    font-size: 19px;
    line-height: 1.75;
    color: #5e574d;
  }


  .policy-updated {
    margin: 30px 0 0;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: #8b8378;
  }


  .policy-content {
    max-width: 1080px;
    margin: 0 auto;
    padding: 20px 40px 120px;
  }


  .policy-section {
    padding: 60px 0;
    border-top: 1px solid rgba(41, 37, 31, 0.15);

    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 45px;
  }


  .policy-number {
    font-size: 11px;
    letter-spacing: 0.18em;
    color: #917552;
  }


  .policy-section > div {
    max-width: 760px;
  }


  .policy-section h2 {
    margin: 0 0 25px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 32px;
    line-height: 1.2;
    font-weight: 400;
  }


  .policy-section p {
    margin: 0 0 20px;
    font-size: 16px;
    line-height: 1.85;
    color: #5d564c;
  }


  .policy-email {
    display: inline-block;
    margin-top: 5px;
    color: #29251f;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 24px;
    text-decoration: none;
    border-bottom: 1px solid rgba(41, 37, 31, 0.35);
  }


  .policy-email:hover {
    opacity: 0.65;
  }


  .policy-final {
    padding: 110px 40px;
    text-align: center;
    background: #29251f;
    color: #f8f5ef;
  }


  .policy-final h2 {
    max-width: 800px;
    margin: 0 auto 35px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(36px, 4vw, 55px);
    line-height: 1.15;
    font-weight: 400;
  }


  .policy-final .product-shop-button {
    display: inline-block;
  }


  @media (max-width: 700px) {

    .policy-hero,
    .policy-content,
    .policy-final {
      padding-left: 22px;
      padding-right: 22px;
    }


    .policy-section {
      grid-template-columns: 1fr;
      gap: 18px;
      padding: 45px 0;
    }


    .policy-hero {
      padding-top: 70px;
      padding-bottom: 70px;
    }


    .policy-email {
      font-size: 20px;
    }

  }

</style>