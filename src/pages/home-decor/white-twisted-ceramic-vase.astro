---
import "../../styles/global.css";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
---

<html lang="en">
  <head>
    <!-- Google Consent Mode -->
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
        functionality_storage: "denied",
        personalization_storage: "denied",
        security_storage: "granted",
        wait_for_update: 2000
      });

      gtag("set", "ads_data_redaction", true);
      gtag("set", "url_passthrough", true);
    </script>

    <!-- Start cookieyes banner -->
    <script
      id="cookieyes"
      type="text/javascript"
      src="https://cdn-cookieyes.com/client_data/e9c032e34948c08e8ad6b9973971db36/script.js"
    ></script>
    <!-- End cookieyes banner -->

    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-LT2BEMKHKC"
    ></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-LT2BEMKHKC');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>White Twisted Ceramic Vase | KASODI</title>

    <meta
      name="description"
      content="Discover the White Twisted Ceramic Vase by Rundago, a sculptural white ceramic vase with a softly twisted texture selected by KASODI for elegant home styling."
    />
  </head>

  <body>

    <Header />


    <main class="product-detail-page">

      <div class="product-breadcrumb">
        <a href="/">Home</a>
        <span>·</span>
        <a href="/home-decor">Home Decor</a>
        <span>·</span>
        <span>White Twisted Ceramic Vase</span>
      </div>


      <section class="product-detail-hero">

        <div class="product-detail-image">
          <img
            src="/images/home-decor/white-twisted-ceramic-vase.png"
            alt="White twisted ceramic vase by Rundago styled by KASODI"
          />
        </div>


        <div class="product-detail-content">

          <p class="product-detail-eyebrow">
            KASODI FIND · HOME DECOR
          </p>

          <h1>
            White Twisted Ceramic Vase
          </h1>

          <p class="product-detail-brand">
            Rundago
          </p>

          <p class="product-detail-intro">
            A sculptural white ceramic vase with a softly twisted silhouette
            and subtle ribbed texture. Its clean colour and organic form give it
            enough character to stand on its own, while keeping the overall look
            calm, contemporary and easy to style.
          </p>


          <div class="product-detail-divider"></div>


          <div class="product-detail-meta">

            <div>
              <span>Material</span>
              <strong>Ceramic</strong>
            </div>

            <div>
              <span>Dimensions</span>
              <strong>Approx. 11.2 × 11.2 × 20.6 cm</strong>
            </div>

            <div>
              <span>Colour</span>
              <strong>White</strong>
            </div>

            <div>
              <span>Weight</span>
              <strong>Approx. 700 g</strong>
            </div>

            <div>
              <span>Pattern</span>
              <strong>Twisted · Ribbed</strong>
            </div>

            <div>
              <span>Style</span>
              <strong>Minimalist · Sculptural</strong>
            </div>

          </div>


          <div class="affiliate-action">

            <a
              href="https://amzn.to/4Af2csX"
              target="_blank"
              rel="nofollow sponsored"
              class="product-shop-button"
            >
              Find It Here →
            </a>

            <p class="affiliate-note">
              Affiliate link · KASODI may earn a commission at no extra cost to you.
            </p>

          </div>

        </div>

      </section>


      <section class="why-we-love">

        <div class="why-we-love-label">
          KASODI NOTE
        </div>

        <div class="why-we-love-content">

          <h2>Why we love it</h2>

          <p>
            What makes this vase interesting is the shape rather than the colour.
            The flowing twisted form creates movement and texture, while the simple
            white ceramic keeps it understated enough to work in many different
            interiors.
          </p>

          <p>
            We especially like it filled with loose peonies, hydrangeas or olive
            branches, but its sculptural silhouette also works beautifully without
            flowers. Styled on a console, bedside table or dining table, it adds
            detail without making the space feel busy.
          </p>

        </div>

      </section>


      <section class="product-care">

        <p class="product-detail-eyebrow">
          CARE
        </p>

        <h2>Keep the white ceramic looking fresh</h2>

        <p>
          Clean gently with a soft damp cloth or sponge and mild detergent.
          Avoid abrasive cleaners or rough scouring pads that may mark the
          glazed surface. Dry carefully after cleaning and handle with care
          when moving or arranging flowers.
        </p>

      </section>


      <section class="styling-ideas">

        <div class="styling-heading">
          <p>KASODI STYLING</p>
          <h2>Style it with</h2>
        </div>


        <div class="styling-grid">

          <div class="styling-card">
            <span>01</span>
            <h3>Pink Peonies</h3>
            <p>
              Soft blush, rose and deeper pink peonies bring colour to the clean
              white ceramic while keeping the overall look romantic and refined.
            </p>
          </div>


          <div class="styling-card">
            <span>02</span>
            <h3>Natural Stone</h3>
            <p>
              Travertine, limestone or warm stone surfaces echo the sculptural
              character of the vase and give it a more organic setting.
            </p>
          </div>


          <div class="styling-card">
            <span>03</span>
            <h3>Warm Linen</h3>
            <p>
              Ivory, oatmeal or soft beige linen adds warmth and prevents the
              white ceramic from feeling too stark or formal.
            </p>
          </div>

        </div>

      </section>


      <section class="continue-exploring">

        <div class="continue-exploring-heading">
          <p>HOME DECOR</p>
          <h2>Continue Exploring</h2>
        </div>

        <div class="continue-exploring-grid">


          <a
            href="/home-decor/blue-floral-ceramic-pitcher"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/home-decor/blue-floral-ceramic-pitcher.png"
                alt="Blue Floral Ceramic Pitcher"
              />
            </div>

            <div class="continue-card-info">
              <span>HOME DECOR</span>
              <h3>Blue Floral Ceramic Pitcher</h3>
              <p>Temu Find</p>
              <strong>Discover →</strong>
            </div>

          </a>


          <a
            href="/kasodi-edit/botanical-vintage-pitcher"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/kasodi-edit/kasodi-edit-floral-ceramic-pitcher.png"
                alt="Botanical Vintage Pitcher"
              />
            </div>

            <div class="continue-card-info">
              <span>HOME DECOR</span>
              <h3>Botanical Vintage Pitcher</h3>
              <p>Ethereal Eves</p>
              <strong>Discover →</strong>
            </div>

          </a>


          <a
            href="/new-finds/vintage-botanical-jewelry-box"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/new-finds/vintage-botanical-jewelry-box.png"
                alt="Vintage Botanical Jewelry Box"
              />
            </div>

            <div class="continue-card-info">
              <span>HOME DECOR</span>
              <h3>Vintage Botanical Jewelry Box</h3>
              <p>Tila Home</p>
              <strong>Discover →</strong>
            </div>

          </a>

        </div>

      </section>


      <section class="product-final-cta">

        <p class="product-detail-eyebrow">
          RUNDAGO · SCULPTURAL CERAMIC
        </p>

        <h2>
          A simple white form with just enough movement.
        </h2>

        <a
          href="https://amzn.to/4Af2csX"
          target="_blank"
          rel="nofollow sponsored"
          class="product-shop-button"
        >
          Find It Here →
        </a>

        <p class="affiliate-note affiliate-note-light">
          Affiliate link · KASODI may earn a commission at no extra cost to you.
        </p>

      </section>

    </main>


    <Footer />

  </body>
</html>