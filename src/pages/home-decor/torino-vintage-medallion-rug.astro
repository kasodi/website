---
import "../../styles/global.css";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
---

<html lang="en">
  <head>
    <!-- Google Consent Mode -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
        functionality_storage: "denied",
        personalization_storage: "denied",
        security_storage: "granted",
        wait_for_update: 2000
      });

      gtag("set", "ads_data_redaction", true);
      gtag("set", "url_passthrough", true);
    </script>

    <!-- Start cookieyes banner -->
    <script
      id="cookieyes"
      type="text/javascript"
      src="https://cdn-cookieyes.com/client_data/e9c032e34948c08e8ad6b9973971db36/script.js"
    ></script>
    <!-- End cookieyes banner -->

    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-LT2BEMKHKC"
    ></script>

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-LT2BEMKHKC');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Torino Vintage Medallion Rug | KASODI</title>

    <meta
      name="description"
      content="Discover the Torino vintage medallion rug from Alfombra.es, selected by KASODI for its faded blue palette, ornamental floral pattern and relaxed outdoor character."
    />
  </head>

  <body>

    <Header />


    <main class="product-detail-page">

      <div class="product-breadcrumb">
        <a href="/">Home</a>
        <span>&middot;</span>
        <a href="/home-decor">Home Decor</a>
        <span>&middot;</span>
        <span>Torino Vintage Medallion Rug</span>
      </div>


      <section class="product-detail-hero">

        <div class="product-detail-image">
          <img
            src="/images/home-decor/alfombra-torino-vintage-medallion-rug.png"
            alt="Torino blue vintage medallion rug styled on a warm Mediterranean terrace"
          />
        </div>


        <div class="product-detail-content">

          <p class="product-detail-eyebrow">
            KASODI EDIT &middot; RUGS
          </p>

          <h1>
            Torino Vintage Medallion Rug
          </h1>

          <p class="product-detail-brand">
            Alfombra.es
          </p>

          <p class="product-detail-intro">
            A richly patterned outdoor rug with the relaxed character of a
            vintage textile. Torino combines a faded blue ground with a
            decorative floral medallion, bringing colour and ornament to
            terraces, balconies and other outdoor spaces.
          </p>


          <div class="product-detail-divider"></div>


          <div class="product-detail-meta">

            <div>
              <span>Material</span>
              <strong>100% Polypropylene</strong>
            </div>

            <div>
              <span>Dimensions</span>
              <strong>60 &times; 100 cm</strong>
            </div>

            <div>
              <span>Colour</span>
              <strong>Blue</strong>
            </div>

            <div>
              <span>Height</span>
              <strong>6 mm</strong>
            </div>

            <div>
              <span>Style</span>
              <strong>Vintage &middot; Ornamental</strong>
            </div>

            <div>
              <span>Use</span>
              <strong>Outdoor</strong>
            </div>

          </div>


          <div class="affiliate-action">

            <a
              href="https://tidd.ly/4y31Zrj"
              target="_blank"
              rel="nofollow sponsored"
              class="product-shop-button"
            >
              Find It Here &rarr;
            </a>

            <p class="affiliate-note">
              Affiliate link &middot; KASODI may earn a commission at no extra cost to you.
            </p>

          </div>

        </div>

      </section>


      <section class="why-we-love">

        <div class="why-we-love-label">
          KASODI NOTE
        </div>

        <div class="why-we-love-content">

          <h2>Why we love it</h2>

          <p>
            Torino brings the decorative richness of a traditional rug into
            a much more relaxed setting. The large central medallion gives it
            presence, while the distressed blue background keeps the overall
            effect soft rather than formal.
          </p>

          <p>
            We like it particularly against warm stone, aged terracotta and
            natural wood. Those earthy materials balance the cooler blue tones
            beautifully and make the rug feel at home on a Mediterranean
            terrace or sheltered balcony.
          </p>

        </div>

      </section>


      <section class="product-care">

        <p class="product-detail-eyebrow">
          CARE
        </p>

        <h2>Keep its faded character looking fresh</h2>

        <p>
          Hand cleaning is recommended. Remove surface dirt regularly and
          treat spills promptly. For longer-lasting outdoor use, allow the rug
          to dry thoroughly after wet weather and follow the retailer's
          specific care instructions.
        </p>

      </section>


      <section class="styling-ideas">

        <div class="styling-heading">
          <p>KASODI STYLING</p>
          <h2>Style it with</h2>
        </div>


        <div class="styling-grid">

          <div class="styling-card">
            <span>01</span>
            <h3>Aged Terracotta</h3>
            <p>
              Weathered terracotta pots introduce warm earthy tones that
              contrast beautifully with Torino's faded blue palette.
            </p>
          </div>


          <div class="styling-card">
            <span>02</span>
            <h3>Natural Wood</h3>
            <p>
              Rustic tables, benches and woven furniture soften the ornamental
              pattern and give the setting an easy outdoor character.
            </p>
          </div>


          <div class="styling-card">
            <span>03</span>
            <h3>Cream Linen</h3>
            <p>
              Soft neutral cushions and throws keep the surrounding palette
              quiet, allowing the decorative medallion to become the focus.
            </p>
          </div>

        </div>

      </section>


      <section class="continue-exploring">

        <div class="continue-exploring-heading">
          <p>KASODI EDIT</p>
          <h2>Continue Exploring</h2>
        </div>

        <div class="continue-exploring-grid">


          <a
            href="/home-decor/artino-vintage-outdoor-rug"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/home-decor/alfombra-artino-vintage-outdoor-rug.png"
                alt="Artino Vintage Outdoor Rug"
              />
            </div>

            <div class="continue-card-info">
              <span>RUGS</span>
              <h3>Artino Vintage Outdoor Rug</h3>
              <p>Alfombra.es</p>
              <strong>Discover &rarr;</strong>
            </div>

          </a>


          <a
            href="/home-decor/tokko-sculptural-round-rug"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/home-decor/alfombra-tokko-sculptural-round-rug.png"
                alt="Tokko Sculptural Round Rug"
              />
            </div>

            <div class="continue-card-info">
              <span>RUGS</span>
              <h3>Tokko Sculptural Round Rug</h3>
              <p>Alfombra.es</p>
              <strong>Discover &rarr;</strong>
            </div>

          </a>


          <a
            href="/home-decor/alura-teak-wood-floor-mirror"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/home-decor/kave-home-alura-teak-wood-floor-mirror.png"
                alt="Alura Teak Wood Floor Mirror"
              />
            </div>

            <div class="continue-card-info">
              <span>MIRRORS</span>
              <h3>Alura Teak Wood Floor Mirror</h3>
              <p>Kave Home</p>
              <strong>Discover &rarr;</strong>
            </div>

          </a>

        </div>

      </section>


      <section class="product-final-cta">

        <p class="product-detail-eyebrow">
          ALFOMBRA.ES &middot; TORINO
        </p>

        <h2>
          Vintage pattern and faded blue for relaxed outdoor living.
        </h2>

        <a
          href="https://tidd.ly/4y31Zrj"
          target="_blank"
          rel="nofollow sponsored"
          class="product-shop-button"
        >
          Find It Here &rarr;
        </a>

        <p class="affiliate-note affiliate-note-light">
          Affiliate link &middot; KASODI may earn a commission at no extra cost to you.
        </p>

      </section>

    </main>


    <Footer />

  </body>
</html>