
---
import "../../styles/global.css";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";

const affiliateUrl =
  "https://kavehome.com/es/en/p/mercadal-ceramic-table-lamp-in-a-black-finish?utm_affcid=11111111&utm_medium=affiliate&utm_source=kasodi&utm_affaid=kasodi";
---

<html lang="en">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Google Consent Mode -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }

    gtag("consent", "default", {
      ad_storage: "denied",
      ad_user_data: "denied",
      ad_personalization: "denied",
      analytics_storage: "denied",
      functionality_storage: "denied",
      personalization_storage: "denied",
      security_storage: "granted",
      wait_for_update: 2000
    });

    gtag("set", "ads_data_redaction", true);
    gtag("set", "url_passthrough", true);
  </script>

  <!-- Start cookieyes banner -->
  <script
    id="cookieyes"
    type="text/javascript"
    src="https://cdn-cookieyes.com/client_data/e9c032e34948c08e8ad6b9973971db36/script.js"
  ></script>
  <!-- End cookieyes banner -->

  <!-- Google tag (gtag.js) -->
  <script
    async
    src="https://www.googletagmanager.com/gtag/js?id=G-LT2BEMKHKC"
  ></script>

  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-LT2BEMKHKC');
  </script>

  <title>Mercadal Black Ceramic Table Lamp | KASODI</title>

  <meta
    name="description"
    content="Discover Mercadal by Kave Home, a black ceramic table lamp with a natural linen shade. A timeless accent for warm, considered interiors."
  />

  <link
    rel="canonical"
    href="https://kasodi.com/home-decor/mercadal-black-ceramic-table-lamp/"
  />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="KASODI" />

  <meta
    property="og:title"
    content="Mercadal Black Ceramic Table Lamp | KASODI"
  />

  <meta
    property="og:description"
    content="Discover Mercadal by Kave Home, a black ceramic table lamp with a natural linen shade. Timeless design for warm, considered interiors."
  />

  <meta
    property="og:url"
    content="https://kasodi.com/home-decor/mercadal-black-ceramic-table-lamp/"
  />

  <meta
    property="og:image"
    content="https://kasodi.com/images/home-decor/kave-home-mercadal-black-ceramic-table-lamp.png"
  />

  <meta
    property="og:image:alt"
    content="Mercadal black ceramic table lamp with a natural linen shade by Kave Home"
  />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
</head>


<!-- Product structured data -->
<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Mercadal Black Ceramic Table Lamp",
  "description": "An elegant table lamp by Kave Home featuring a softly rounded black ceramic base and a natural linen shade, curated by KASODI.",
  "image": "https://kasodi.com/images/home-decor/kave-home-mercadal-black-ceramic-table-lamp.png",
  "brand": {
    "@type": "Brand",
    "name": "Kave Home"
  },
  "category": "Table Lamps",
  "material": "Ceramic and natural linen",
  "color": "Black and natural",
  "height": {
    "@type": "QuantitativeValue",
    "value": 60,
    "unitCode": "CMT"
  },
  "width": {
    "@type": "QuantitativeValue",
    "value": 45,
    "unitCode": "CMT"
  },
  "url": "https://kasodi.com/home-decor/mercadal-black-ceramic-table-lamp/"
}
</script>


  <body>
    <Header />

    <main class="product-detail-page">

      <!-- BREADCRUMBS -->
      <div class="product-breadcrumb">
        <a href="/">Home</a>
        <span>&middot;</span>
        <a href="/home-decor/">Decor</a>
        <span>&middot;</span>
        <span>Mercadal Black Ceramic Table Lamp</span>
      </div>

      <!-- PRODUCT HERO -->
      <section class="product-detail-hero mercadal-detail-hero">

        <figure class="product-detail-image product-photo-with-credit">
          <img
            src="/images/home-decor/kave-home-mercadal-black-ceramic-table-lamp.png"
            alt="Mercadal black ceramic table lamp with a natural linen shade in a warm Mediterranean interior"
          />
          <figcaption class="product-photo-credit">
            AI-assisted visual &middot; Product: Kave Home
          </figcaption>
        </figure>

        <div class="product-detail-content">

          <p class="product-detail-eyebrow">
            KASODI EDIT &middot; LIGHTING
          </p>

          <h1>Mercadal Black Ceramic Table Lamp</h1>

          <p class="product-detail-brand">Kave Home</p>

          <p class="product-detail-intro">
            A timeless balance of natural texture and sculptural form.
            Mercadal pairs a beautifully rounded black ceramic base
            with a softly tapered linen shade, bringing warmth,
            depth and understated elegance to a considered interior.
          </p>

          <div class="product-detail-divider"></div>

          <div class="product-detail-meta">

            <div>
              <span>Material</span>
              <strong>Ceramic &middot; Natural linen</strong>
            </div>

            <div>
              <span>Dimensions</span>
              <strong>60 cm high &middot; 45 cm wide</strong>
            </div>

            <div>
              <span>Colour</span>
              <strong>Black &middot; Natural</strong>
            </div>
            <div>
              <span>Bulb</span>
              <strong>E27 &middot; Max. 40 W &middot; Sold separately</strong>
            </div>

            <div>
              <span>Weight</span>
              <strong>3.24 kg</strong>
            </div>

            <div>
              <span>Cable</span>
              <strong>160 cm</strong>
            </div>

            <div>
              <span>Measurement tolerance</span>
              <strong>&plusmn; 2 cm</strong>
            </div>

            <div>
              <span>Use</span>
              <strong>Indoors only</strong>
            </div>

          </div>

          <div class="affiliate-action">
            <a
              href={affiliateUrl}
              target="_blank"
              rel="nofollow sponsored noopener noreferrer"
              class="product-shop-button"
            >
              Find It Here &rarr;
            </a>

            <p class="affiliate-note">
              Affiliate link &middot; KASODI may earn a commission at no extra cost to you.
            </p>
          </div>

        </div>

      </section>

      <!-- WHY WE LOVE IT -->
      <section class="why-we-love">

        <div class="why-we-love-label">
          KASODI NOTE
        </div>

        <div class="why-we-love-content">

          <h2>Why we love it</h2>

          <p>
            Mercadal celebrates the quiet beauty of contrast.
            Its dark ceramic base has a softly rounded,
            almost artisanal silhouette, while the natural
            linen shade introduces lightness and texture.
            Together, they create a timeless piece that feels
            both grounded and effortlessly elegant.
          </p>

          <p>
            We especially love how Mercadal works with warm
            wood, textured plaster and sun-washed neutral tones.
            At 60 cm high, it makes a beautiful statement on
            a generous bedside table, a living room console
            or a thoughtfully styled reading corner.
          </p>

        </div>

      </section>

      <!-- CARE -->
      <section class="product-care">

        <p class="product-detail-eyebrow">CARE</p>

        <h2>Caring for the ceramic</h2>

        <p>
          Gently remove dust with a soft duster.
          Keep the lamp away from direct heat and prolonged
          sunlight. Avoid abrasive products, solvents and
          harsh cleaning agents, as these may damage the
          ceramic finish. Disconnect the lamp before cleaning.
        </p>

      </section>

      <!-- STYLE IT WITH -->
      <section class="styling-ideas">

        <div class="styling-heading">
          <p>KASODI STYLING</p>
          <h2>Style it with</h2>
        </div>

        <div class="styling-grid">

          <div class="styling-card">
            <span>01</span>
            <h3>Warm Natural Wood</h3>
            <p>
              Place Mercadal on an oak or walnut side table.
              The natural warmth of the wood softens the
              dark ceramic base and creates a beautifully
              balanced composition.
            </p>
          </div>

          <div class="styling-card">
            <span>02</span>
            <h3>Textured Neutrals</h3>
            <p>
              Pair the lamp with linen upholstery, woven
              textiles and softly textured walls. Layers
              of cream, sand and taupe allow its sculptural
              silhouette to stand out naturally.
            </p>
          </div>

          <div class="styling-card">
            <span>03</span>
            <h3>Mediterranean Simplicity</h3>
            <p>
              Add a handmade ceramic bowl, an olive branch
              or a few collected natural objects. Keep
              the arrangement simple and let Mercadal
              become the quiet focal point.
            </p>
          </div>

        </div>

      </section>

      <!-- CONTINUE EXPLORING -->
<section class="continue-exploring">

  <div class="continue-exploring-heading">
    <p>KASODI EDIT</p>
    <h2>Continue Exploring</h2>
  </div>

  <div class="continue-exploring-grid">

    <a
      href="/home-decor/drava-burgundy-ceramic-table-lamp"
      class="continue-card"
    >
      <div class="continue-card-image">
        <img
          src="/images/home-decor/kave-home-drava-burgundy-ceramic-table-lamp.webp"
          alt="Drava Burgundy Ceramic Table Lamp"
          loading="lazy"
        />
      </div>

      <div class="continue-card-info">
        <span>LIGHTING</span>
        <h3>Drava Burgundy Ceramic Table Lamp</h3>
        <p>Kave Home</p>
        <strong>Discover &rarr;</strong>
      </div>
    </a>

    <a
      href="/textiles-cozy/ovelin-burgundy-velvet-cushion-cover"
      class="continue-card"
    >
      <div class="continue-card-image">
        <img
          src="/images/textiles-cozy/kave-home-ovelin-burgundy-velvet-cushion-cover-card.png"
          alt="Ovelin Burgundy Velvet Cushion Cover"
          loading="lazy"
        />
      </div>

      <div class="continue-card-info">
        <span>TEXTILES &amp; COZY</span>
        <h3>Ovelin Burgundy Velvet Cushion Cover</h3>
        <p>Kave Home</p>
        <strong>Discover &rarr;</strong>
      </div>
    </a>

    <a
      href="/kitchen/glassware/talora-carved-glass-decanter"
      class="continue-card"
    >
      <div class="continue-card-image">
        <img
          src="/images/tableware/kave-home-talora-carved-glass-decanter-card.png"
          alt="Talora Carved Glass Decanter"
          loading="lazy"
        />
      </div>

      <div class="continue-card-info">
        <span>GLASSWARE</span>
        <h3>Talora Carved Glass Decanter</h3>
        <p>Kave Home</p>
        <strong>Discover &rarr;</strong>
      </div>
    </a>

  </div>

</section>

      <!-- FINAL CTA -->
      <section class="product-final-cta">

        <p class="product-detail-eyebrow">
          KAVE HOME &middot; MERCADAL
        </p>

        <h2>Quiet elegance, beautifully grounded.</h2>

        <a
          href={affiliateUrl}
          target="_blank"
          rel="nofollow sponsored noopener noreferrer"
          class="product-shop-button"
        >
          Find It Here &rarr;
        </a>

        <p class="affiliate-note affiliate-note-light">
          Affiliate link &middot; KASODI may earn a commission at no extra cost to you.
        </p>

      </section>

    </main>

    <Footer />
  </body>
</html>
