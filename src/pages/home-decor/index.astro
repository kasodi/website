
---
const destination = "/home/decor/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={`https://kasodi.com${destination}`} />
    <title>Redirecting | KASODI</title>
  </head>
  <body>
    <p>
      Redirecting to <a href={destination}>Home Decor</a>.
    </p>
  </body>
</html>
