---
import "../../styles/global.css";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
---

<html lang="en">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Google Consent Mode -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }

    gtag("consent", "default", {
      ad_storage: "denied",
      ad_user_data: "denied",
      ad_personalization: "denied",
      analytics_storage: "denied",
      functionality_storage: "denied",
      personalization_storage: "denied",
      security_storage: "granted",
      wait_for_update: 2000
    });

    gtag("set", "ads_data_redaction", true);
    gtag("set", "url_passthrough", true);
  </script>

  <!-- Start cookieyes banner -->
  <script
    id="cookieyes"
    type="text/javascript"
    src="https://cdn-cookieyes.com/client_data/e9c032e34948c08e8ad6b9973971db36/script.js"
  ></script>
  <!-- End cookieyes banner -->

  <!-- Google tag (gtag.js) -->
  <script
    async
    src="https://www.googletagmanager.com/gtag/js?id=G-LT2BEMKHKC"
  ></script>

  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-LT2BEMKHKC');
  </script>

  <title>Tandy Brown Terracotta Table Lamp | KASODI</title>

  <meta
    name="description"
    content="Discover Tandy by Kave Home, a compact brown terracotta table lamp with a gently tapered shade and rounded base."
  />

  <link
    rel="canonical"
    href="https://kasodi.com/home-decor/tandy-brown-terracotta-table-lamp/"
  />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="KASODI" />
  <meta property="og:title" content="Tandy Brown Terracotta Table Lamp | KASODI" />

  <meta
    property="og:description"
    content="Discover the Tandy brown terracotta table lamp by Kave Home. A sculptural accent for warm, considered interiors."
  />

  <meta
    property="og:url"
    content="https://kasodi.com/home-decor/tandy-brown-terracotta-table-lamp/"
  />

  <meta
    property="og:image"
    content="https://kasodi.com/images/home-decor/kave-home-tandy-brown-terracotta-table-lamp.png"
  />

  <meta
    property="og:image:alt"
    content="Tandy brown terracotta table lamp by Kave Home"
  />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
</head>

<!-- Product structured data -->
<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Tandy Brown Terracotta Table Lamp",
  "description": "A compact brown terracotta table lamp with a gently tapered shade and rounded base, curated by KASODI.",
  "image": "https://kasodi.com/images/home-decor/kave-home-tandy-brown-terracotta-table-lamp.png",
  "brand": {
    "@type": "Brand",
    "name": "Kave Home"
  },
  "category": "Table Lamps",
  "material": "Natural terracotta",
  "color": "Brown",
  "url": "https://kasodi.com/home-decor/tandy-brown-terracotta-table-lamp/"
}
</script>


  <body>
    <Header />

    <main class="product-detail-page">

      <!-- BREADCRUMBS -->
      <div class="product-breadcrumb">
  <a href="/">Home</a>
  <span>&middot;</span>
  <a href="/home-decor/">Decor</a>
  <span>&middot;</span>
  <span>Tandy Brown Terracotta Table Lamp</span>
</div>

      <!-- PRODUCT HERO -->
      <section class="product-detail-hero tandy-detail-hero">

        <figure class="product-detail-image product-photo-with-credit">
          <img
            src="/images/home-decor/kave-home-tandy-brown-terracotta-table-lamp.png"
            alt="Tandy brown terracotta table lamp lit on a wooden bedside table"
          />
          <figcaption class="product-photo-credit">Image: Kave Home</figcaption>
        </figure>

        <div class="product-detail-content">

          <p class="product-detail-eyebrow">
            KASODI EDIT &middot; LIGHTING
          </p>

          <h1>Tandy Brown Terracotta Table Lamp</h1>

          <p class="product-detail-brand">Kave Home</p>

          <p class="product-detail-intro">
            A compact lamp in brown terracotta, with a gently tapered shade
            and a rounded base. Subtle variations in tone and texture give
            each piece its own character.
          </p>

          <div class="product-detail-divider"></div>

          <div class="product-detail-meta">

            <div>
              <span>Material</span>
              <strong>Natural terracotta</strong>
            </div>

            <div>
              <span>Dimensions</span>
              <strong>30 cm high &middot; &Oslash; 16 cm max.</strong>
            </div>

            <div>
              <span>Colour</span>
              <strong>Brown</strong>
            </div>

             <div>
              <span>Bulb</span>
              <strong>E27 LED globe &middot; Max. 25 W &middot; Sold separately</strong>
            </div>

            <div>
              <span>SKU</span>
              <strong>L0300119RR86</strong>
            </div>

            <div>
              <span>Power supply</span>
              <strong>Type C plug &middot; 230 V / 50 Hz</strong>
            </div>

            <div>
              <span>Protection</span>
              <strong>IP20 &middot; Class II</strong>
            </div>

            <div>
              <span>Use</span>
              <strong>Indoors only</strong>
            </div>

            <div>
              <span>Switch and adjustment</span>
              <strong>Hand switch &middot; Fixed height and angle</strong>
            </div>

          </div>

          <div class="affiliate-action">
            <a
              href="https://kavehome.com/es/en/p/tandy-brown-terracotta-table-lamp?utm_affcid=11111111&utm_medium=affiliate&utm_source=kasodi&utm_affaid=kasodi&utm_affcid=11111111"
              target="_blank"
              rel="nofollow sponsored"
              class="product-shop-button"
            >
              Find It Here &rarr;
            </a>

            <p class="affiliate-note">
              Affiliate link &middot; KASODI may earn a commission at no extra cost to you.
            </p>
          </div>

        </div>

      </section>


      <!-- WHY WE LOVE IT -->
      <section class="why-we-love">

        <div class="why-we-love-label">
          KASODI NOTE
        </div>

        <div class="why-we-love-content">

          <h2>Why we love it</h2>

          <p>
            The matching terracotta makes the shade and base read as one piece.
            In daylight, the gently tapered profile draws attention to the
            grain and tonal variations in the clay.
          </p>

          <p>
            At 30 cm high, Tandy leaves room for a book and a glass of water on
            a small bedside table. In the evening, a warm globe bulb brings
            out the depth of the brown finish.
          </p>

        </div>

      </section>


      <!-- CARE -->
      <section class="product-care">

        <p class="product-detail-eyebrow">CARE</p>

        <h2>Caring for the terracotta</h2>

        <p>
          Gently dust the terracotta with a soft, dry brush. Avoid abrasive
          cleaners and solvents.
        </p>

      </section>


      <!-- STYLE IT WITH -->
      <section class="styling-ideas">

        <div class="styling-heading">
          <p>KASODI STYLING</p>
          <h2>Style it with</h2>
        </div>

        <div class="styling-grid">

          <div class="styling-card">
            <span>01</span>
            <h3>Warm Wood</h3>
            <p>
              Set Tandy on a rounded oak or walnut bedside table. The grain
              of the wood picks up the warmth of the terracotta.
            </p>
          </div>

          <div class="styling-card">
            <span>02</span>
            <h3>Soft Neutrals</h3>
            <p>
              Pair it with cream linen or a warm plaster wall to give the
              dark silhouette a clear outline.
            </p>
          </div>

          <div class="styling-card">
            <span>03</span>
            <h3>Muted Olive</h3>
            <p>
              Try a muted olive cushion or a small glazed dish beside the
              lamp to bring a little colour to the bedside.
            </p>
          </div>

        </div>

      </section>


     <!-- CONTINUE EXPLORING -->
<section class="continue-exploring">

  <div class="continue-exploring-heading">
    <p>KASODI EDIT</p>
    <h2>Continue Exploring</h2>
  </div>

  <div class="continue-exploring-grid">

    <a
      href="/textiles-cozy/vintage-beige-salon-rug"
      class="continue-card"
    >
      <div class="continue-card-image">
        <img
          src="/images/textiles-cozy/vintage-beige-salon-rug-card.png"
          alt="Vintage Beige Salon Rug"
        />
      </div>

      <div class="continue-card-info">
        <span>RUGS</span>
        <h3>Vintage Beige Salon Rug</h3>
        <p>Vintage Collection</p>
        <strong>Discover &rarr;</strong>
      </div>
    </a>


    <a
      href="/kitchen/glassware/talora-carved-glass-decanter"
      class="continue-card"
    >
      <div class="continue-card-image">
        <img
          src="/images/tableware/kave-home-talora-carved-glass-decanter-card.png"
          alt="Talora Carved Glass Decanter"
        />
      </div>

      <div class="continue-card-info">
        <span>GLASSWARE</span>
        <h3>Talora Carved Glass Decanter</h3>
        <p>Kave Home</p>
        <strong>Discover &rarr;</strong>
      </div>
    </a>


    <a
      href="/kitchen/cindea-green-marble-mortar-pestle"
      class="continue-card"
    >
      <div class="continue-card-image">
        <img
          src="/images/kitchen/kave-home-cindea-green-marble-mortar-pestle-card.png"
          alt="Cindea Green Marble Mortar &amp; Pestle"
        />
      </div>

      <div class="continue-card-info">
        <span>KITCHEN ESSENTIALS</span>
        <h3>Cindea Green Marble Mortar &amp; Pestle</h3>
        <p>Kave Home</p>
        <strong>Discover &rarr;</strong>
      </div>
    </a>

  </div>

</section>
      <!-- FINAL CTA -->
      <section class="product-final-cta">

        <p class="product-detail-eyebrow">
          KAVE HOME &middot; TANDY
        </p>

        <h2>A quiet pool of light beside the bed.</h2>

        <a
          href="https://kavehome.com/es/en/p/tandy-brown-terracotta-table-lamp?utm_affcid=11111111&utm_medium=affiliate&utm_source=kasodi&utm_affaid=kasodi&utm_affcid=11111111"
          target="_blank"
          rel="nofollow sponsored"
          class="product-shop-button"
        >
          Find It Here &rarr;
        </a>

        <p class="affiliate-note affiliate-note-light">
          Affiliate link &middot; KASODI may earn a commission at no extra cost to you.
        </p>

      </section>

    </main>

    <Footer />
  </body>
</html>
