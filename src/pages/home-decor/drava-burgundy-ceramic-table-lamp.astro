---
import "../../styles/global.css";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
---

<html lang="en">
  <head>
    <!-- Google Consent Mode -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}

      gtag('consent', 'default', {
        'ad_storage': 'denied',
        'analytics_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied'
      });
    </script>

    <!-- CookieYes banner -->
    <script
      id="cookieyes"
      type="text/javascript"
      src="https://cdn-cookieyes.com/client_data/YOUR_COOKIEYES_ID/script.js"
    ></script>

    <!-- Google Analytics -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=YOUR_GA_ID"
    ></script>

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'YOUR_GA_ID');
    </script>

    <title>Drava Burgundy Ceramic Table Lamp | KASODI</title>

    <meta
      name="description"
      content="Discover the Drava burgundy ceramic table lamp by Kave Home, selected by KASODI for its richly glazed textured base, warm colour and softly diffused light."
    />
  </head>

  <body>
    <Header />

    <main class="product-detail-page">

      <!-- BREADCRUMBS -->
      <div class="product-breadcrumb">
        <a href="/">Home</a>
        <span>&middot;</span>
        <a href="/home-decor">Home Decor</a>
        <span>&middot;</span>
        <span>Drava Burgundy Ceramic Table Lamp</span>
      </div>

      <!-- PRODUCT HERO -->
      <section class="product-detail-hero">

        <div class="product-detail-image">
          <img
            src="/images/home-decor/kave-home-drava-burgundy-ceramic-table-lamp.png"
            alt="Drava burgundy ceramic table lamp by Kave Home"
          />
        </div>

        <div class="product-detail-content">

          <p class="product-detail-eyebrow">
            KASODI EDIT &middot; LIGHTING
          </p>

          <h1>Drava Burgundy Ceramic Table Lamp</h1>

          <p class="product-detail-brand">Kave Home</p>

          <p class="product-detail-intro">
            A richly coloured table lamp pairing a tall glazed ceramic base
            with a simple light fabric shade. The deep burgundy finish and
            subtly textured surface give Drava a warm decorative presence,
            while its clean silhouette keeps the overall look refined.
          </p>

          <div class="product-detail-divider"></div>

          <div class="product-detail-meta">

            <div>
              <span>Material</span>
              <strong>Ceramic &middot; Fabric</strong>
            </div>

            <div>
              <span>Dimensions</span>
              <strong>49 &times; 33 &times; 33 cm</strong>
            </div>

            <div>
              <span>Colour</span>
              <strong>Burgundy &middot; Cream</strong>
            </div>

            <div>
              <span>Finish</span>
              <strong>Glazed &middot; Textured</strong>
            </div>

            <div>
              <span>Bulb</span>
              <strong>E27 &middot; Max. 40 W</strong>
            </div>

            <div>
              <span>Weight</span>
              <strong>2.08 kg</strong>
            </div>

          </div>

          <div class="affiliate-action">
            <a
              href="https://kavehome.com/es/en/p/drava-table-lamp-in-burgundy-ceramic-with-cotton-shade?utm_affaid=kasodi"
              target="_blank"
              rel="nofollow sponsored"
              class="product-shop-button"
            >
              Find It Here &rarr;
            </a>

            <p class="affiliate-note">
              Affiliate link &middot; KASODI may earn a commission at no extra cost to you.
            </p>
          </div>

        </div>

      </section>


      <!-- WHY WE LOVE IT -->
      <section class="why-we-love">

        <div class="why-we-love-label">
          KASODI NOTE
        </div>

        <div class="why-we-love-content">

          <h2>Why we love it</h2>

          <p>
            Drava brings colour into a room without feeling overly decorative.
            The deep burgundy ceramic base has a glossy, irregular texture that
            catches the light beautifully, giving the lamp more character than
            a conventional neutral design.
          </p>

          <p>
            We especially like the contrast between the saturated ceramic and
            the simple pale shade. At 49 cm high, it has enough presence for a
            console, bedside table or living room side table, where it can work
            as both a source of soft light and a decorative object.
          </p>

        </div>

      </section>


      <!-- CARE -->
      <section class="product-care">

        <p class="product-detail-eyebrow">CARE</p>

        <h2>Keep the glazed finish looking beautiful</h2>

        <p>
          Dust the ceramic base and shade regularly with a soft, dry cloth.
          Avoid abrasive cleaners on the glazed surface. Drava is designed for
          indoor use and requires one E27 bulb up to 40 W, which is sold
          separately.
        </p>

      </section>


      <!-- STYLE IT WITH -->
      <section class="styling-ideas">

        <div class="styling-heading">
          <p>KASODI STYLING</p>
          <h2>Style it with</h2>
        </div>

        <div class="styling-grid">

          <div class="styling-card">
            <span>01</span>
            <h3>Dark Wood</h3>
            <p>
              Place Drava on walnut, dark oak or another warm-toned wood to
              bring out the depth of its burgundy glaze.
            </p>
          </div>

          <div class="styling-card">
            <span>02</span>
            <h3>Soft Neutrals</h3>
            <p>
              Pair it with cream linen, warm beige walls and natural textiles
              so the coloured ceramic becomes the quiet focal point.
            </p>
          </div>

          <div class="styling-card">
            <span>03</span>
            <h3>Antique Brass</h3>
            <p>
              Small brass frames, trays or decorative details complement the
              warm garnet tone and give the setting a collected feel.
            </p>
          </div>

        </div>

      </section>


      <!-- CONTINUE EXPLORING -->
      <section class="continue-exploring">

        <div class="continue-exploring-heading">
          <p>KASODI EDIT</p>
          <h2>Continue Exploring</h2>
        </div>

        <div class="continue-exploring-grid">

          <a
            href="/home-decor/lurea-sculptural-glass-centrepiece"
            class="continue-card"
          >
            <div class="continue-card-image">
              <img
                src="/images/home-decor/kave-home-lurea-sculptural-glass-centrepiece.png"
                alt="Lurea Sculptural Glass Centrepiece"
              />
            </div>

            <div class="continue-card-info">
              <span>DECORATIVE OBJECTS</span>
              <h3>Lurea Sculptural Glass Centrepiece</h3>
              <p>Kave Home</p>
              <strong>Discover &rarr;</strong>
            </div>
          </a>


          <a
            href="/kasodi-edit/botanical-vintage-pitcher"
            class="continue-card"
          >
            <div class="continue-card-image">
              <img
                src="/images/kasodi-edit/kasodi-edit-floral-ceramic-pitcher.png"
                alt="Botanical Vintage Pitcher"
              />
            </div>

            <div class="continue-card-info">
              <span>HOME DECOR</span>
              <h3>Botanical Vintage Pitcher</h3>
              <p>Ethereal Eves</p>
              <strong>Discover &rarr;</strong>
            </div>
          </a>


          <a
            href="/candles-fragrance/walnut-candle-holder-set"
            class="continue-card"
          >
            <div class="continue-card-image">
              <img
                src="/images/candles-fragrance/sabaily-walnut-candle-holder-set.png"
                alt="Walnut Candle Holder Set"
              />
            </div>

            <div class="continue-card-info">
              <span>CANDLES &amp; FRAGRANCE</span>
              <h3>Walnut Candle Holder Set</h3>
              <p>Sabai'ly</p>
              <strong>Discover &rarr;</strong>
            </div>
          </a>

        </div>

      </section>


      <!-- FINAL CTA -->
      <section class="product-final-cta">

        <p class="product-detail-eyebrow">
          KAVE HOME &middot; DRAVA
        </p>

        <h2>A warm glow with a richer shade of colour.</h2>

        <a
          href="https://kavehome.com/es/en/p/drava-table-lamp-in-burgundy-ceramic-with-cotton-shade?utm_affaid=kasodi"
          target="_blank"
          rel="nofollow sponsored"
          class="product-shop-button"
        >
          Find It Here &rarr;
        </a>

        <p class="affiliate-note affiliate-note-light">
          Affiliate link &middot; KASODI may earn a commission at no extra cost to you.
        </p>

      </section>

    </main>

    <Footer />
  </body>
</html>