
---
import "../../styles/global.css";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
---

<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Google Consent Mode -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }

    gtag("consent", "default", {
      ad_storage: "denied",
      ad_user_data: "denied",
      ad_personalization: "denied",
      analytics_storage: "denied",
      functionality_storage: "denied",
      personalization_storage: "denied",
      security_storage: "granted",
      wait_for_update: 2000
    });

    gtag("set", "ads_data_redaction", true);
    gtag("set", "url_passthrough", true);
  </script>

  <!-- Start cookieyes banner -->
  <script
    id="cookieyes"
    type="text/javascript"
    src="https://cdn-cookieyes.com/client_data/e9c032e34948c08e8ad6b9973971db36/script.js"
  ></script>
  <!-- End cookieyes banner -->

  <!-- Google tag (gtag.js) -->
  <script
    async
    src="https://www.googletagmanager.com/gtag/js?id=G-LT2BEMKHKC"
  ></script>

  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-LT2BEMKHKC');
  </script>

  <title>Drava Burgundy Ceramic Table Lamp | KASODI</title>

  <meta
    name="description"
    content="Discover the Drava burgundy ceramic table lamp by Kave Home, selected by KASODI for its richly glazed textured base, warm colour and softly diffused light."
  />

  <link
    rel="canonical"
    href="https://kasodi.com/home-decor/drava-burgundy-ceramic-table-lamp/"
  />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="KASODI" />

  <meta
    property="og:title"
    content="Drava Burgundy Ceramic Table Lamp | KASODI"
  />

  <meta
    property="og:description"
    content="Discover Drava by Kave Home, a burgundy ceramic table lamp with a richly glazed textured base and softly diffused light. A refined accent for warm, considered interiors."
  />

  <meta
    property="og:url"
    content="https://kasodi.com/home-decor/drava-burgundy-ceramic-table-lamp/"
  />

  <meta
    property="og:image"
    content="https://kasodi.com/images/home-decor/kave-home-drava-burgundy-ceramic-table-lamp.webp"
  />

  <meta
    property="og:image:alt"
    content="Drava burgundy ceramic table lamp by Kave Home"
  />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
</head>


  <body>
    <Header />

    <main class="product-detail-page">

      <!-- BREADCRUMBS -->
      <div class="product-breadcrumb">
  <a href="/">Home</a>
  <span>&middot;</span>
  <a href="/home-decor">Decor</a>
  <span>&middot;</span>
  <span>Drava Burgundy Ceramic Table Lamp</span>
</div>

      <!-- PRODUCT HERO -->
      <section class="product-detail-hero">

        <figure class="product-detail-image product-photo-with-credit">
  <img
    src="/images/home-decor/kave-home-drava-burgundy-ceramic-table-lamp.webp"
    alt="Drava burgundy ceramic table lamp by Kave Home"
  />
  <figcaption class="product-photo-credit">
    AI-generated visual &middot; Product: Kave Home
  </figcaption>
</figure>

        <div class="product-detail-content">

          <p class="product-detail-eyebrow">
            KASODI EDIT &middot; LIGHTING
          </p>

          <h1>Drava Burgundy Ceramic Table Lamp</h1>

          <p class="product-detail-brand">Kave Home</p>

          <p class="product-detail-intro">
            A richly coloured table lamp pairing a tall glazed ceramic base
            with a simple light fabric shade. The deep burgundy finish and
            subtly textured surface give Drava a warm decorative presence,
            while its clean silhouette keeps the overall look refined.
          </p>

          <div class="product-detail-divider"></div>

          <div class="product-detail-meta">

            <div>
              <span>Material</span>
              <strong>Ceramic &middot; Fabric</strong>
            </div>

            <div>
              <span>Dimensions</span>
              <strong>49 &times; 33 &times; 33 cm</strong>
            </div>

            <div>
              <span>Colour</span>
              <strong>Burgundy &middot; Cream</strong>
            </div>

            <div>
              <span>Finish</span>
              <strong>Glazed &middot; Textured</strong>
            </div>

            <div>
              <span>Bulb</span>
              <strong>E27 &middot; Max. 40 W</strong>
            </div>

            <div>
              <span>Weight</span>
              <strong>2.08 kg</strong>
            </div>

          </div>

          <div class="affiliate-action">
            <a
              href="https://kavehome.com/es/en/p/drava-table-lamp-in-burgundy-ceramic-with-cotton-shade?utm_affcid=11111111&utm_medium=affiliate&utm_source=kasodi&utm_affaid=kasodi&utm_affcid=11111111"
              target="_blank"
              rel="nofollow sponsored"
              class="product-shop-button"
            >
              Find It Here &rarr;
            </a>

            <p class="affiliate-note">
              Affiliate link &middot; KASODI may earn a commission at no extra cost to you.
            </p>
          </div>

        </div>

      </section>


      <!-- WHY WE LOVE IT -->
      <section class="why-we-love">

        <div class="why-we-love-label">
          KASODI NOTE
        </div>

        <div class="why-we-love-content">

          <h2>Why we love it</h2>

          <p>
            Drava brings colour into a room without feeling overly decorative.
            The deep burgundy ceramic base has a glossy, irregular texture that
            catches the light beautifully, giving the lamp more character than
            a conventional neutral design.
          </p>

          <p>
            We especially like the contrast between the saturated ceramic and
            the simple pale shade. At 49 cm high, it has enough presence for a
            console, bedside table or living room side table, where it can work
            as both a source of soft light and a decorative object.
          </p>

        </div>

      </section>


      <!-- CARE -->
      <section class="product-care">

        <p class="product-detail-eyebrow">CARE</p>

        <h2>Keep the glazed finish looking beautiful</h2>

        <p>
          Dust the ceramic base and shade regularly with a soft, dry cloth.
          Avoid abrasive cleaners on the glazed surface. Drava is designed for
          indoor use and requires one E27 bulb up to 40 W, which is sold
          separately.
        </p>

      </section>


      <!-- STYLE IT WITH -->
      <section class="styling-ideas">

        <div class="styling-heading">
          <p>KASODI STYLING</p>
          <h2>Style it with</h2>
        </div>

        <div class="styling-grid">

          <div class="styling-card">
            <span>01</span>
            <h3>Dark Wood</h3>
            <p>
              Place Drava on walnut, dark oak or another warm-toned wood to
              bring out the depth of its burgundy glaze.
            </p>
          </div>

          <div class="styling-card">
            <span>02</span>
            <h3>Soft Neutrals</h3>
            <p>
              Pair it with cream linen, warm beige walls and natural textiles
              so the coloured ceramic becomes the quiet focal point.
            </p>
          </div>

          <div class="styling-card">
            <span>03</span>
            <h3>Antique Brass</h3>
            <p>
              Small brass frames, trays or decorative details complement the
              warm garnet tone and give the setting a collected feel.
            </p>
          </div>

        </div>

      </section>


      <!-- CONTINUE EXPLORING -->
      <section class="continue-exploring">

        <div class="continue-exploring-heading">
          <p>KASODI EDIT</p>
          <h2>Continue Exploring</h2>
        </div>

        <div class="continue-exploring-grid">

          <a
            href="/home-decor/lurea-sculptural-glass-centrepiece"
            class="continue-card"
          >
            <div class="continue-card-image">
              <img
                src="/images/home-decor/kave-home-lurea-sculptural-glass-centrepiece.webp"
                alt="Lurea Sculptural Glass Centrepiece"
              />
            </div>

            <div class="continue-card-info">
              <span>DECORATIVE OBJECTS</span>
              <h3>Lurea Sculptural Glass Centrepiece</h3>
              <p>Kave Home</p>
              <strong>Discover &rarr;</strong>
            </div>
          </a>


          <a
  href="/home-decor/raze-beige-marble-linen-table-lamp"
  class="continue-card"
>
  <div class="continue-card-image">
    <img
  src="/images/home-decor/raze-continue-exploring.png"
  alt="Raze Beige Marble & Linen Table Lamp"
/>
  </div>

  <div class="continue-card-info">
    <span>LIGHTING</span>
    <h3>Raze Beige Marble &amp; Linen Table Lamp</h3>
    <p>Kave Home</p>
    <strong>Discover &rarr;</strong>
  </div>
</a>


          <a
            href="/candles-fragrance/walnut-candle-holder-set"
            class="continue-card"
          >
            <div class="continue-card-image">
              <img
                src="/images/candles-fragrance/sabaily-walnut-candle-holder-set.webp"
                alt="Walnut Candle Holder Set"
              />
            </div>

            <div class="continue-card-info">
              <span>CANDLES &amp; FRAGRANCE</span>
              <h3>Walnut Candle Holder Set</h3>
              <p>Sabai'ly</p>
              <strong>Discover &rarr;</strong>
            </div>
          </a>

        </div>

      </section>


      <!-- FINAL CTA -->
      <section class="product-final-cta">

        <p class="product-detail-eyebrow">
          KAVE HOME &middot; DRAVA
        </p>

        <h2>A warm glow with a richer shade of colour.</h2>

        <a
          href="https://kavehome.com/es/en/p/drava-table-lamp-in-burgundy-ceramic-with-cotton-shade?utm_affcid=11111111&utm_medium=affiliate&utm_source=kasodi&utm_affaid=kasodi&utm_affcid=11111111"
          target="_blank"
          rel="nofollow sponsored"
          class="product-shop-button"
        >
          Find It Here &rarr;
        </a>

        <p class="affiliate-note affiliate-note-light">
          Affiliate link &middot; KASODI may earn a commission at no extra cost to you.
        </p>

      </section>

    </main>

    <Footer />
  </body>
</html>