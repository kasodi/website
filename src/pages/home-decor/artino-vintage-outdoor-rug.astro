---
import "../../styles/global.css";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
---

<html lang="en">
  <head>
    <!-- Google Consent Mode -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
        functionality_storage: "denied",
        personalization_storage: "denied",
        security_storage: "granted",
        wait_for_update: 2000
      });

      gtag("set", "ads_data_redaction", true);
      gtag("set", "url_passthrough", true);
    </script>

    <!-- Start cookieyes banner -->
    <script
      id="cookieyes"
      type="text/javascript"
      src="https://cdn-cookieyes.com/client_data/e9c032e34948c08e8ad6b9973971db36/script.js"
    ></script>
    <!-- End cookieyes banner -->

    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-LT2BEMKHKC"
    ></script>

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-LT2BEMKHKC');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Artino Vintage Outdoor Rug | KASODI</title>

    <meta
      name="description"
      content="Discover the Artino vintage outdoor rug from Alfombra.es, selected by KASODI for its softly faded colours, ornamental pattern and romantic vintage character."
    />
  </head>

  <body>

    <Header />


    <main class="product-detail-page">

      <div class="product-breadcrumb">
        <a href="/">Home</a>
        <span>&middot;</span>
        <a href="/home-decor">Home Decor</a>
        <span>&middot;</span>
        <span>Artino Vintage Outdoor Rug</span>
      </div>


      <section class="product-detail-hero">

        <div class="product-detail-image">
          <img
            src="/images/home-decor/alfombra-artino-vintage-outdoor-rug.png"
            alt="Artino multicolour vintage outdoor rug styled in a warm Mediterranean KASODI interior"
          />
        </div>


        <div class="product-detail-content">

          <p class="product-detail-eyebrow">
            KASODI EDIT &middot; RUGS
          </p>

          <h1>
            Artino Vintage Outdoor Rug
          </h1>

          <p class="product-detail-brand">
            Alfombra.es
          </p>

          <p class="product-detail-intro">
            A softly faded rug with the character of a well-loved vintage find.
            Artino combines pale blue, warm cream and muted decorative tones
            with an ornamental pattern that brings colour to a space without
            overwhelming it.
          </p>


          <div class="product-detail-divider"></div>


          <div class="product-detail-meta">

            <div>
              <span>Material</span>
              <strong>100% Polypropylene</strong>
            </div>

            <div>
              <span>Dimensions</span>
              <strong>160 &times; 220 cm</strong>
            </div>

            <div>
              <span>Colour</span>
              <strong>Multicolour</strong>
            </div>

            <div>
              <span>Height</span>
              <strong>6 mm</strong>
            </div>

            <div>
              <span>Style</span>
              <strong>Vintage &middot; Ornamental</strong>
            </div>

            <div>
              <span>Use</span>
              <strong>Outdoor</strong>
            </div>

          </div>


          <div class="affiliate-action">

            <a
              href="https://tidd.ly/4yPaoyA"
              target="_blank"
              rel="nofollow sponsored"
              class="product-shop-button"
            >
              Find It Here &rarr;
            </a>

            <p class="affiliate-note">
              Affiliate link &middot; KASODI may earn a commission at no extra cost to you.
            </p>

          </div>

        </div>

      </section>


      <section class="why-we-love">

        <div class="why-we-love-label">
          KASODI NOTE
        </div>

        <div class="why-we-love-content">

          <h2>Why we love it</h2>

          <p>
            Artino has the relaxed beauty of an old decorative rug without
            feeling overly traditional. Its washed palette softens the
            ornamental pattern, allowing the blue, cream and muted pink tones
            to sit naturally alongside stone, linen and warm wood.
          </p>

          <p>
            We especially like it for terraces and balconies where a little
            pattern can transform an otherwise simple outdoor setting. Pair it
            with pale furniture, natural ceramics and leafy plants for an easy
            Mediterranean look.
          </p>

        </div>

      </section>


      <section class="product-care">

        <p class="product-detail-eyebrow">
          CARE
        </p>

        <h2>Made for relaxed outdoor living</h2>

        <p>
          Hand cleaning is recommended. During prolonged periods of rain,
          place the rug in a covered, dry area so it can dry and air
          thoroughly before returning it outdoors.
        </p>

      </section>


      <section class="styling-ideas">

        <div class="styling-heading">
          <p>KASODI STYLING</p>
          <h2>Style it with</h2>
        </div>


        <div class="styling-grid">

          <div class="styling-card">
            <span>01</span>
            <h3>Natural Linen</h3>
            <p>
              Cream and off-white linen cushions keep the setting light and
              allow the rug's softly faded colours to become the focal point.
            </p>
          </div>


          <div class="styling-card">
            <span>02</span>
            <h3>Terracotta Ceramics</h3>
            <p>
              Large weathered pots and handmade ceramics bring warmth to the
              pale blue palette and reinforce its Mediterranean character.
            </p>
          </div>


          <div class="styling-card">
            <span>03</span>
            <h3>Olive Green</h3>
            <p>
              Olive trees and relaxed greenery work beautifully with the
              vintage pattern while adding a natural layer of colour.
            </p>
          </div>

        </div>

      </section>


      <section class="continue-exploring">

        <div class="continue-exploring-heading">
          <p>KASODI EDIT</p>
          <h2>Continue Exploring</h2>
        </div>

        <div class="continue-exploring-grid">


          <a
            href="/home-decor/tokko-sculptural-round-rug"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/home-decor/alfombra-tokko-sculptural-round-rug.png"
                alt="Tokko Sculptural Round Rug"
              />
            </div>

            <div class="continue-card-info">
              <span>RUGS</span>
              <h3>Tokko Sculptural Round Rug</h3>
              <p>Alfombra.es</p>
              <strong>Discover &rarr;</strong>
            </div>

          </a>


          <a
            href="/home-decor/alura-teak-wood-floor-mirror"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/home-decor/kave-home-alura-teak-wood-floor-mirror.png"
                alt="Alura Teak Wood Floor Mirror"
              />
            </div>

            <div class="continue-card-info">
              <span>MIRRORS</span>
              <h3>Alura Teak Wood Floor Mirror</h3>
              <p>Kave Home</p>
              <strong>Discover &rarr;</strong>
            </div>

          </a>


          <a
            href="/home-decor/drava-burgundy-ceramic-table-lamp"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/home-decor/kave-home-drava-burgundy-ceramic-table-lamp.png"
                alt="Drava Burgundy Ceramic Table Lamp"
              />
            </div>

            <div class="continue-card-info">
              <span>LIGHTING</span>
              <h3>Drava Burgundy Ceramic Table Lamp</h3>
              <p>Kave Home</p>
              <strong>Discover &rarr;</strong>
            </div>

          </a>

        </div>

      </section>


      <section class="product-final-cta">

        <p class="product-detail-eyebrow">
          ALFOMBRA.ES &middot; ARTINO
        </p>

        <h2>
          A faded vintage pattern for relaxed outdoor spaces.
        </h2>

        <a
          href="https://tidd.ly/4yPaoyA"
          target="_blank"
          rel="nofollow sponsored"
          class="product-shop-button"
        >
          Find It Here &rarr;
        </a>

        <p class="affiliate-note affiliate-note-light">
          Affiliate link &middot; KASODI may earn a commission at no extra cost to you.
        </p>

      </section>

    </main>


    <Footer />

  </body>
</html>