---
import "../../styles/global.css";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
---

<html lang="en">
  <head>
    <!-- Google Consent Mode -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
        functionality_storage: "denied",
        personalization_storage: "denied",
        security_storage: "granted",
        wait_for_update: 2000
      });

      gtag("set", "ads_data_redaction", true);
      gtag("set", "url_passthrough", true);
    </script>

    <!-- Start cookieyes banner -->
    <script
      id="cookieyes"
      type="text/javascript"
      src="https://cdn-cookieyes.com/client_data/e9c032e34948c08e8ad6b9973971db36/script.js"
    ></script>
    <!-- End cookieyes banner -->

    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-LT2BEMKHKC"
    ></script>

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-LT2BEMKHKC');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Tokko Sculptural Round Rug | KASODI</title>

    <meta
      name="description"
      content="Discover the Tokko sculptural round rug from Alfombra.es, selected by KASODI for its warm cream palette, curved geometric relief and soft architectural character."
    />
  </head>

  <body>

    <Header />


    <main class="product-detail-page">

      <div class="product-breadcrumb">
        <a href="/">Home</a>
        <span>&middot;</span>
        <a href="/home-decor">Home Decor</a>
        <span>&middot;</span>
        <span>Tokko Sculptural Round Rug</span>
      </div>


      <section class="product-detail-hero">

        <div class="product-detail-image">
          <img
            src="/images/home-decor/alfombra-tokko-sculptural-round-rug.png"
            alt="Tokko sculptural round cream rug styled in a warm KASODI interior"
          />
        </div>


        <div class="product-detail-content">

          <p class="product-detail-eyebrow">
            KASODI EDIT &middot; RUGS
          </p>

          <h1>
            Tokko Sculptural Round Rug
          </h1>

          <p class="product-detail-brand">
            Alfombra.es
          </p>

          <p class="product-detail-intro">
            A soft cream rug defined by a sculptural geometric relief and a
            beautifully rounded silhouette. Tokko brings texture and movement
            to a room without introducing a strong colour, making it an easy
            way to add character to calm, neutral interiors.
          </p>


          <div class="product-detail-divider"></div>


          <div class="product-detail-meta">

            <div>
              <span>Colour</span>
              <strong>Cream</strong>
            </div>

            <div>
              <span>Shape</span>
              <strong>Round</strong>
            </div>

            <div>
              <span>Diameter</span>
              <strong>120 cm</strong>
            </div>

            <div>
              <span>Design</span>
              <strong>Geometric relief</strong>
            </div>

            <div>
              <span>Style</span>
              <strong>Modern &middot; Textured</strong>
            </div>

            <div>
              <span>Use</span>
              <strong>Indoor</strong>
            </div>

          </div>


          <div class="affiliate-action">

            <a
              href="https://tidd.ly/4xvQM1i"
              target="_blank"
              rel="nofollow sponsored"
              class="product-shop-button"
            >
              Find It Here &rarr;
            </a>

            <p class="affiliate-note">
              Affiliate link &middot; KASODI may earn a commission at no extra cost to you.
            </p>

          </div>

        </div>

      </section>


      <section class="why-we-love">

        <div class="why-we-love-label">
          KASODI NOTE
        </div>

        <div class="why-we-love-content">

          <h2>Why we love it</h2>

          <p>
            Tokko shows how a neutral rug can still have plenty of personality.
            Its raised curved pattern gives the cream surface an architectural
            quality, creating interest through texture rather than colour.
          </p>

          <p>
            We particularly like the round version for softening rooms dominated
            by straight furniture and rectangular layouts. It works beautifully
            beneath a reading chair, beside a sofa or as a quiet focal point in
            a smaller living space.
          </p>

        </div>

      </section>


      <section class="product-care">

        <p class="product-detail-eyebrow">
          CARE
        </p>

        <h2>Keep the texture looking its best</h2>

        <p>
          Vacuum regularly using a gentle setting to remove surface dust while
          protecting the raised pattern. Treat spills promptly and always follow
          the retailer's specific care instructions for the rug.
        </p>

      </section>


      <section class="styling-ideas">

        <div class="styling-heading">
          <p>KASODI STYLING</p>
          <h2>Style it with</h2>
        </div>


        <div class="styling-grid">

          <div class="styling-card">
            <span>01</span>
            <h3>Warm Wood</h3>
            <p>
              Walnut, oak and other warm woods bring depth to the cream palette
              and emphasise the rug's softly sculpted surface.
            </p>
          </div>


          <div class="styling-card">
            <span>02</span>
            <h3>Olive Green</h3>
            <p>
              An olive-toned chair, cushions or leafy branches add a muted
              Mediterranean contrast without disturbing the calm palette.
            </p>
          </div>


          <div class="styling-card">
            <span>03</span>
            <h3>Natural Ceramics</h3>
            <p>
              Handmade stoneware and softly textured ceramics echo the tactile
              character of the rug and keep the room feeling collected.
            </p>
          </div>

        </div>

      </section>


      <section class="continue-exploring">

        <div class="continue-exploring-heading">
          <p>KASODI EDIT</p>
          <h2>Continue Exploring</h2>
        </div>

        <div class="continue-exploring-grid">


          <a
            href="/home-decor/alura-teak-wood-floor-mirror"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/home-decor/kave-home-alura-teak-wood-floor-mirror.png"
                alt="Alura Teak Wood Floor Mirror"
              />
            </div>

            <div class="continue-card-info">
              <span>MIRRORS</span>
              <h3>Alura Teak Wood Floor Mirror</h3>
              <p>Kave Home</p>
              <strong>Discover &rarr;</strong>
            </div>

          </a>


          <a
            href="/home-decor/drava-burgundy-ceramic-table-lamp"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/home-decor/kave-home-drava-burgundy-ceramic-table-lamp.png"
                alt="Drava Burgundy Ceramic Table Lamp"
              />
            </div>

            <div class="continue-card-info">
              <span>LIGHTING</span>
              <h3>Drava Burgundy Ceramic Table Lamp</h3>
              <p>Kave Home</p>
              <strong>Discover &rarr;</strong>
            </div>

          </a>


          <a
            href="/home-decor/lurea-sculptural-glass-centrepiece"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/home-decor/kave-home-lurea-sculptural-glass-centrepiece.png"
                alt="Lurea Sculptural Glass Centrepiece"
              />
            </div>

            <div class="continue-card-info">
              <span>DECORATIVE OBJECTS</span>
              <h3>Lurea Sculptural Glass Centrepiece</h3>
              <p>Kave Home</p>
              <strong>Discover &rarr;</strong>
            </div>

          </a>

        </div>

      </section>


      <section class="product-final-cta">

        <p class="product-detail-eyebrow">
          ALFOMBRA.ES &middot; TOKKO
        </p>

        <h2>
          Soft geometry for a room with quiet character.
        </h2>

        <a
          href="https://tidd.ly/4xvQM1i"
          target="_blank"
          rel="nofollow sponsored"
          class="product-shop-button"
        >
          Find It Here &rarr;
        </a>

        <p class="affiliate-note affiliate-note-light">
          Affiliate link &middot; KASODI may earn a commission at no extra cost to you.
        </p>

      </section>

    </main>


    <Footer />

  </body>
</html>