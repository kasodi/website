---
import "../../styles/global.css";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
---

<html lang="en">
  <head>
    <!-- Google Consent Mode -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
        functionality_storage: "denied",
        personalization_storage: "denied",
        security_storage: "granted",
        wait_for_update: 2000
      });

      gtag("set", "ads_data_redaction", true);
      gtag("set", "url_passthrough", true);
    </script>

    <!-- Start cookieyes banner -->
    <script
      id="cookieyes"
      type="text/javascript"
      src="https://cdn-cookieyes.com/client_data/e9c032e34948c08e8ad6b9973971db36/script.js"
    ></script>
    <!-- End cookieyes banner -->

    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-LT2BEMKHKC"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-LT2BEMKHKC');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Vintage Textured Ceramic Vase | KASODI</title>

    <meta
      name="description"
      content="Discover the Vintage Textured Ceramic Vase by YUMIPLUS, a cream ceramic vase with a softly aged finish and vertical relief selected by KASODI for warm, collected interiors."
    />
  </head>

  <body>

    <Header />


    <main class="product-detail-page">

      <div class="product-breadcrumb">
        <a href="/">Home</a>
        <span>·</span>
        <a href="/home-decor">Home Decor</a>
        <span>·</span>
        <span>Vintage Textured Ceramic Vase</span>
      </div>


      <section class="product-detail-hero">

        <div class="product-detail-image">
          <img
            src="/images/home-decor/vintage-textured-ceramic-vase.png"
            alt="Vintage textured ceramic vase by YUMIPLUS styled by KASODI"
          />
        </div>


        <div class="product-detail-content">

          <p class="product-detail-eyebrow">
            KASODI FIND · HOME DECOR
          </p>

          <h1>
            Vintage Textured Ceramic Vase
          </h1>

          <p class="product-detail-brand">
            YUMIPLUS
          </p>

          <p class="product-detail-intro">
            A characterful ceramic vase with a softly aged cream finish,
            vertical relief and a gently flared neck. Its rustic texture and
            simple silhouette give it the feel of a collected vintage piece,
            while the neutral palette makes it easy to style throughout the home.
          </p>


          <div class="product-detail-divider"></div>


          <div class="product-detail-meta">

            <div>
              <span>Material</span>
              <strong>Ceramic</strong>
            </div>

            <div>
              <span>Height</span>
              <strong>Approx. 17 cm</strong>
            </div>

            <div>
              <span>Base Width</span>
              <strong>Approx. 11 cm</strong>
            </div>

            <div>
              <span>Opening</span>
              <strong>Approx. 7 cm</strong>
            </div>

            <div>
              <span>Colour</span>
              <strong>Cream · Aged Beige</strong>
            </div>

            <div>
              <span>Style</span>
              <strong>Vintage · Rustic</strong>
            </div>

          </div>


          <div class="affiliate-action">

            <a
              href="https://temu.to/k/e5ebte526q4"
              target="_blank"
              rel="nofollow sponsored"
              class="product-shop-button"
            >
              Find It Here →
            </a>

            <p class="affiliate-note">
              Affiliate link · KASODI may earn a commission at no extra cost to you.
            </p>

          </div>

        </div>

      </section>


      <section class="why-we-love">

        <div class="why-we-love-label">
          KASODI NOTE
        </div>

        <div class="why-we-love-content">

          <h2>Why we love it</h2>

          <p>
            This vase has the kind of imperfect texture that makes a room feel
            more layered and collected. The cream ceramic is softened by subtle
            brown speckling and an aged surface, while the vertical relief gives
            the simple shape more depth and character.
          </p>

          <p>
            We especially like it with loose white flowers, olive branches or
            eucalyptus, but it also works beautifully as a decorative object on
            its own. Place it on a wooden console, bookshelf or side table where
            its quiet texture can add warmth without competing with the rest of
            the room.
          </p>

        </div>

      </section>


      <section class="product-care">

        <p class="product-detail-eyebrow">
          CARE
        </p>

        <h2>Care for the textured finish</h2>

        <p>
          Clean gently with a soft damp cloth or sponge and mild detergent.
          Avoid abrasive cleaners and rough scouring pads that may affect the
          textured surface. Dry carefully after cleaning and handle with care
          when arranging flowers or moving the vase.
        </p>

      </section>


      <section class="styling-ideas">

        <div class="styling-heading">
          <p>KASODI STYLING</p>
          <h2>Style it with</h2>
        </div>


        <div class="styling-grid">

          <div class="styling-card">
            <span>01</span>
            <h3>White Flowers</h3>
            <p>
              Soft white blooms keep the palette calm while highlighting the
              warm, aged texture of the ceramic.
            </p>
          </div>


          <div class="styling-card">
            <span>02</span>
            <h3>Warm Wood</h3>
            <p>
              Natural or aged wood reinforces the rustic character and gives
              the neutral vase a warmer backdrop.
            </p>
          </div>


          <div class="styling-card">
            <span>03</span>
            <h3>Vintage Books</h3>
            <p>
              A small stack of worn books creates height and adds another
              collected layer without making the styling feel overly arranged.
            </p>
          </div>

        </div>

      </section>


      <section class="continue-exploring">

        <div class="continue-exploring-heading">
          <p>HOME DECOR</p>
          <h2>Continue Exploring</h2>
        </div>

        <div class="continue-exploring-grid">


          <a
            href="/home-decor/white-twisted-ceramic-vase"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/home-decor/white-twisted-ceramic-vase.png"
                alt="White Twisted Ceramic Vase"
              />
            </div>

            <div class="continue-card-info">
              <span>HOME DECOR</span>
              <h3>White Twisted Ceramic Vase</h3>
              <p>Rundago</p>
              <strong>Discover →</strong>
            </div>

          </a>


          <a
            href="/home-decor/blue-floral-ceramic-pitcher"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/home-decor/blue-floral-ceramic-pitcher.png"
                alt="Blue Floral Ceramic Pitcher"
              />
            </div>

            <div class="continue-card-info">
              <span>HOME DECOR</span>
              <h3>Blue Floral Ceramic Pitcher</h3>
              <p>Temu Find</p>
              <strong>Discover →</strong>
            </div>

          </a>


          <a
            href="/new-finds/vintage-botanical-jewelry-box"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/new-finds/vintage-botanical-jewelry-box.png"
                alt="Vintage Botanical Jewelry Box"
              />
            </div>

            <div class="continue-card-info">
              <span>HOME DECOR</span>
              <h3>Vintage Botanical Jewelry Box</h3>
              <p>Tila Home</p>
              <strong>Discover →</strong>
            </div>

          </a>

        </div>

      </section>


      <section class="product-final-cta">

        <p class="product-detail-eyebrow">
          YUMIPLUS · TEXTURED CERAMIC
        </p>

        <h2>
          A quiet vintage texture for a more collected home.
        </h2>

        <a
          href="https://temu.to/k/e5ebte526q4"
          target="_blank"
          rel="nofollow sponsored"
          class="product-shop-button"
        >
          Find It Here →
        </a>

        <p class="affiliate-note affiliate-note-light">
          Affiliate link · KASODI may earn a commission at no extra cost to you.
        </p>

      </section>

    </main>


    <Footer />

  </body>
</html>