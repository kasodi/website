---
import "../../styles/global.css";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
---

<html lang="en">
  <head>
    <!-- Google Consent Mode -->
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
        functionality_storage: "denied",
        personalization_storage: "denied",
        security_storage: "granted",
        wait_for_update: 2000
      });

      gtag("set", "ads_data_redaction", true);
      gtag("set", "url_passthrough", true);
    </script>

    <!-- Start cookieyes banner -->
    <script
      id="cookieyes"
      type="text/javascript"
      src="https://cdn-cookieyes.com/client_data/e9c032e34948c08e8ad6b9973971db36/script.js"
    ></script>
    <!-- End cookieyes banner -->

    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-LT2BEMKHKC"
    ></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-LT2BEMKHKC');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Blue Floral Ceramic Pitcher | KASODI</title>

    <meta
      name="description"
      content="Discover the Blue Floral Ceramic Pitcher, a vintage-inspired white ceramic pitcher with cobalt-blue floral detailing selected by KASODI for beautiful home styling."
    />
  </head>

  <body>

    <Header />


    <main class="product-detail-page">

      <div class="product-breadcrumb">
        <a href="/">Home</a>
        <span>·</span>
        <a href="/home-decor">Home Decor</a>
        <span>·</span>
        <span>Blue Floral Ceramic Pitcher</span>
      </div>


      <section class="product-detail-hero">

        <div class="product-detail-image">
          <img
            src="/images/home-decor/blue-floral-ceramic-pitcher.png"
            alt="Blue floral ceramic pitcher styled by KASODI"
          />
        </div>


        <div class="product-detail-content">

          <p class="product-detail-eyebrow">
            KASODI FIND · HOME DECOR
          </p>

          <h1>
            Blue Floral Ceramic Pitcher
          </h1>

          <p class="product-detail-brand">
            Temu Find
          </p>

          <p class="product-detail-intro">
            A decorative ceramic pitcher with an elegant curved silhouette,
            deep blue floral detailing and a softly scalloped rim. Its classic
            blue-and-white palette gives it the character of a vintage European
            find — beautiful with fresh flowers or simply displayed on its own.
          </p>


          <div class="product-detail-divider"></div>


          <div class="product-detail-meta">

            <div>
              <span>Material</span>
              <strong>Ceramic</strong>
            </div>

            <div>
              <span>Dimensions</span>
              <strong>Approx. 17 × 20.5 cm</strong>
            </div>

            <div>
              <span>Colour</span>
              <strong>White · Cobalt Blue</strong>
            </div>

            <div>
              <span>Pattern</span>
              <strong>Floral</strong>
            </div>

            <div>
              <span>Style</span>
              <strong>Vintage · European-inspired</strong>
            </div>

            <div>
              <span>Ideal for</span>
              <strong>Flowers · Table · Shelf Styling</strong>
            </div>

          </div>


          <div class="affiliate-action">

            <a
              href="https://temu.to/k/ed1w3ebh6m2"
              target="_blank"
              rel="nofollow sponsored"
              class="product-shop-button"
            >
              Find It Here →
            </a>

            <p class="affiliate-note">
              Affiliate link · KASODI may earn a commission at no extra cost to you.
            </p>

          </div>

        </div>

      </section>


      <section class="why-we-love">

        <div class="why-we-love-label">
          KASODI NOTE
        </div>

        <div class="why-we-love-content">

          <h2>Why we love it</h2>

          <p>
            This pitcher has the kind of decorative character that makes a
            simple surface feel instantly more collected. The flowing silhouette
            and sculptural handle give it presence, while the cobalt floral
            pattern keeps the overall look classic and familiar.
          </p>

          <p>
            We especially like it filled with loose white flowers or greenery,
            but it is decorative enough to stand on its own on a console,
            kitchen shelf or dining table. The blue-and-white palette also makes
            it easy to combine with natural linen, warm wood and other vintage-inspired
            pieces without making the room feel overly coordinated.
          </p>

        </div>

      </section>


      <section class="product-care">

        <p class="product-detail-eyebrow">
          CARE
        </p>

        <h2>Keep the ceramic finish looking beautiful</h2>

        <p>
          Clean gently with a soft cloth or sponge and mild detergent. Avoid
          abrasive cleaners or rough scouring pads that may damage the glazed
          surface or decorative pattern. Dry carefully after cleaning.
        </p>

      </section>


      <section class="styling-ideas">

        <div class="styling-heading">
          <p>KASODI STYLING</p>
          <h2>Style it with</h2>
        </div>


        <div class="styling-grid">

          <div class="styling-card">
            <span>01</span>
            <h3>White Flowers</h3>
            <p>
              Hydrangeas, peonies or loose garden flowers soften the blue pattern
              and keep the overall styling light and elegant.
            </p>
          </div>


          <div class="styling-card">
            <span>02</span>
            <h3>Natural Linen</h3>
            <p>
              Warm ivory or oatmeal linen gives the cool blue-and-white ceramic
              a softer, more relaxed backdrop.
            </p>
          </div>


          <div class="styling-card">
            <span>03</span>
            <h3>Warm Wood</h3>
            <p>
              A wooden console, shelf or dining table adds warmth and helps the
              decorative blue floral pattern stand out.
            </p>
          </div>

        </div>

      </section>


      <section class="continue-exploring">

        <div class="continue-exploring-heading">
          <p>HOME DECOR</p>
          <h2>Continue Exploring</h2>
        </div>

        <div class="continue-exploring-grid">


          <a
            href="/kasodi-edit/botanical-vintage-pitcher"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/kasodi-edit/kasodi-edit-floral-ceramic-pitcher.png"
                alt="Botanical Vintage Pitcher"
              />
            </div>

            <div class="continue-card-info">
              <span>HOME DECOR</span>
              <h3>Botanical Vintage Pitcher</h3>
              <p>Ethereal Eves</p>
              <strong>Discover →</strong>
            </div>

          </a>


          <a
            href="/new-finds/vintage-botanical-jewelry-box"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/new-finds/vintage-botanical-jewelry-box.png"
                alt="Vintage Botanical Jewelry Box"
              />
            </div>

            <div class="continue-card-info">
              <span>HOME DECOR</span>
              <h3>Vintage Botanical Jewelry Box</h3>
              <p>Tila Home</p>
              <strong>Discover →</strong>
            </div>

          </a>


          <a
            href="/new-finds/vintage-butterfly-photo-frame"
            class="continue-card"
          >

            <div class="continue-card-image">
              <img
                src="/images/new-finds/vintage-butterfly-photo-frame.png"
                alt="Vintage Butterfly Photo Frame"
              />
            </div>

            <div class="continue-card-info">
              <span>HOME DECOR</span>
              <h3>Vintage Butterfly Photo Frame</h3>
              <p>LEYI DECOR</p>
              <strong>Discover →</strong>
            </div>

          </a>

        </div>

      </section>


      <section class="product-final-cta">

        <p class="product-detail-eyebrow">
          TEMU FIND · BLUE & WHITE CERAMIC
        </p>

        <h2>
          A classic blue detail with vintage character.
        </h2>

        <a
          href="https://temu.to/k/ed1w3ebh6m2"
          target="_blank"
          rel="nofollow sponsored"
          class="product-shop-button"
        >
          Find It Here →
        </a>

        <p class="affiliate-note affiliate-note-light">
          Affiliate link · KASODI may earn a commission at no extra cost to you.
        </p>

      </section>

    </main>


    <Footer />

  </body>
</html>