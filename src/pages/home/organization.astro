---
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const products = [
  {
    name: 'Mareno Glass Storage Jar',
    brand: 'INNA Glas',
    category: 'Organization',
    image: '/images/home-organization/inna-glas-mareno-glass-storage-jar.png',
    href: '/home-organization/mareno-glass-storage-jar',
  },
  {
    name: 'Savannah Woven Storage Basket',
    brand: 'YAADU',
    category: 'Organization',
    image: '/images/home-organization/yaadu-savannah-woven-storage-basket.png',
    href: '/home-organization/savannah-woven-storage-basket',
  },
  {
    name: 'Textured Oval Organizer Tray',
    brand: 'Blissilk',
    category: 'Organization',
    image: '/images/home-organization/blissilk-textured-oval-organizer-tray.png',
    href: '/home-organization/textured-oval-organizer-tray',
  },
  {
    name: 'Woven Rattan Organizer Tray',
    brand: 'KASODI Find',
    category: 'Organization',
    image: '/images/home-organization/wocpvm-woven-rattan-organizer-tray.png',
    href: '/home-organization/woven-rattan-organizer-tray',
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Organization | KASODI</title>

    <meta
      name="description"
      content="Discover the KASODI Organization edit — baskets, trays and useful storage selected to bring order without compromising the beauty of a room."
    />

    <link
      rel="icon"
      type="image/png"
      href="/images/kasodi-favicon.png?v=2"
    />
  </head>

  <body>
    <Header />

    <main>
      <section class="home-collection">
        <div class="collection-head">
          <div>
            <a href="/home" class="collection-parent">HOME</a>
            <h1>Organization</h1>
          </div>

          <p>
            Storage that earns its place in the room: baskets, trays and useful
            objects selected with aesthetics in mind.
          </p>
        </div>

        <div class="product-grid">
          {products.map((product) => (
            <a class="product" href={product.href}>
              <img src={product.image} alt={product.name} />

              <span>{product.category}</span>

              <h2>{product.name}</h2>

              <p>{product.brand}</p>

              <u>Discover &rarr;</u>
            </a>
          ))}
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #f8f6f1;
    color: #29251f;
    font-family: Arial, sans-serif;
  }

  .home-collection {
    padding: 90px 8% 120px;
    min-height: 70vh;
  }

  .collection-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: end;
    margin-bottom: 55px;
  }

  .collection-parent {
    display: inline-block;
    width: max-content;
    font-size: 11px;
    letter-spacing: 0.28em;
    color: #9a6b3b;
    text-decoration: none;
  }

  .collection-parent:hover {
    opacity: 0.65;
  }

  .collection-head h1 {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 64px;
    line-height: 1;
    font-weight: 400;
    margin: 20px 0 0;
  }

  .collection-head > p {
    max-width: 520px;
    margin: 0;
    color: #8a6848;
    font-size: 17px;
    line-height: 1.6;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .product {
    color: #29251f;
    text-decoration: none;
  }

  .product img {
    width: 100%;
    aspect-ratio: 0.82;
    object-fit: cover;
    display: block;
  }

  .product > span {
    display: block;
    margin-top: 16px;
    font-size: 10px;
    letter-spacing: 0.16em;
    color: #9a6b3b;
    text-transform: uppercase;
  }

  .product h2 {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 24px;
    line-height: 1.3;
    font-weight: 400;
    margin: 8px 0 5px;
  }

  .product p {
    margin: 0 0 14px;
    color: #775d43;
    font-size: 13px;
  }

  .product u {
    font-size: 12px;
    text-underline-offset: 5px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  @media (max-width: 900px) {
    .collection-head {
      grid-template-columns: 1fr;
    }

    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .home-collection {
      padding: 65px 6% 90px;
    }

    .collection-head h1 {
      font-size: 52px;
    }

    .product-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }

    .product h2 {
      font-size: 20px;
    }
  }
</style>