---
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const products = [
  {
    name: 'Vintage Textured Ceramic Vase',
    brand: 'KASODI Find',
    category: 'Decor',
    image: '/images/home-decor/vintage-textured-ceramic-vase.png',
    href: '/home-decor/vintage-textured-ceramic-vase',
  },
  {
    name: 'White Twisted Ceramic Vase',
    brand: 'KASODI Find',
    category: 'Decor',
    image: '/images/home-decor/white-twisted-ceramic-vase.png',
    href: '/home-decor/white-twisted-ceramic-vase',
  },
  {
    name: 'Lurea Sculptural Glass Centrepiece',
    brand: 'Kave Home',
    category: 'Decor',
    image: '/images/home-decor/kave-home-lurea-sculptural-glass-centrepiece.png',
    href: '/home-decor/lurea-sculptural-glass-centrepiece',
  },
  {
    name: 'Serela White Marble Bookends',
    brand: 'Kave Home',
    category: 'Decor',
    image: '/images/interesting-finds/kave-home-serela-white-marble-bookends.png',
    href: '/interesting-finds/serela-white-marble-bookends',
  },
  {
    name: 'Garel Green Marble Decorative Set',
    brand: 'Kave Home',
    category: 'Decor',
    image: '/images/interesting-finds/kave-home-garel-green-marble-decorative-set.png',
    href: '/interesting-finds/garel-green-marble-decorative-set',
  },
  {
    name: 'Drava Burgundy Ceramic Table Lamp',
    brand: 'Kave Home',
    category: 'Lighting',
    image: '/images/home-decor/kave-home-drava-burgundy-ceramic-table-lamp.png',
    href: '/home-decor/drava-burgundy-ceramic-table-lamp',
  },
  {
    name: 'Tokko Sculptural Round Rug',
    brand: 'Kave Home',
    category: 'Rugs',
    image: '/images/home-decor/alfombra-tokko-sculptural-round-rug.png',
    href: '/home-decor/tokko-sculptural-round-rug',
  },
  {
    name: 'Artino Vintage Outdoor Rug',
    brand: 'KASODI Find',
    category: 'Rugs',
    image: '/images/home-decor/alfombra-artino-vintage-outdoor-rug.png',
    href: '/home-decor/artino-vintage-outdoor-rug',
  },
  {
    name: 'Torino Vintage Medallion Rug',
    brand: 'KASODI Find',
    category: 'Rugs',
    image: '/images/home-decor/alfombra-torino-vintage-medallion-rug.png',
    href: '/home-decor/torino-vintage-medallion-rug',
  },
  {
    name: 'Vintage Beige Salon Rug',
    brand: 'KASODI Find',
    category: 'Rugs',
    image: '/images/textiles-cozy/vintage-beige-salon-rug.png',
    href: '/textiles-cozy/vintage-beige-salon-rug',
  },
  
{
  name: 'Vintage Butterfly Photo Frame',
  brand: 'LEVI DECOR',
  category: 'Decorative Objects',
  image: '/images/new-finds/vintage-butterfly-photo-frame.png',
  href: '/new-finds/vintage-butterfly-photo-frame',
},
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Decor | KASODI</title>

    <meta
      name="description"
      content="Discover the KASODI Decor edit — vases, sculptural objects, lighting, rugs and distinctive details chosen for warmth, character and visual interest."
    />

    <link
      rel="icon"
      type="image/png"
      href="/images/kasodi-favicon.png?v=2"
    />
  </head>

  <body>
    <Header />

    <main>
      <section class="home-collection">
        <div class="collection-head">
          <div>
            <a href="/home" class="collection-parent">HOME</a>
            <h1>Decor</h1>
          </div>

          <p>
            Vases, sculptural objects, lighting, rugs and distinctive details
            chosen for warmth, character and visual interest.
          </p>
        </div>

        <div class="product-grid">
          {products.map((product) => (
            <a class="product" href={product.href}>
              <img src={product.image} alt={product.name} />

              <span>{product.category}</span>

              <h2>{product.name}</h2>

              <p>{product.brand}</p>

              <u>Discover &rarr;</u>
            </a>
          ))}
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #f8f6f1;
    color: #29251f;
    font-family: Arial, sans-serif;
  }

  .home-collection {
    padding: 90px 8% 120px;
    min-height: 70vh;
  }

  .collection-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: end;
    margin-bottom: 55px;
  }

  .collection-parent {
    display: inline-block;
    width: max-content;
    font-size: 11px;
    letter-spacing: 0.28em;
    color: #9a6b3b;
    text-decoration: none;
  }

  .collection-parent:hover {
    opacity: 0.65;
  }

  .collection-head h1 {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 64px;
    line-height: 1;
    font-weight: 400;
    margin: 20px 0 0;
  }

  .collection-head > p {
    max-width: 520px;
    margin: 0;
    color: #8a6848;
    font-size: 17px;
    line-height: 1.6;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .product {
    color: #29251f;
    text-decoration: none;
  }

  .product img {
    width: 100%;
    aspect-ratio: 0.82;
    object-fit: cover;
    display: block;
  }

  .product > span {
    display: block;
    margin-top: 16px;
    font-size: 10px;
    letter-spacing: 0.16em;
    color: #9a6b3b;
    text-transform: uppercase;
  }

  .product h2 {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 24px;
    line-height: 1.3;
    font-weight: 400;
    margin: 8px 0 5px;
  }

  .product p {
    margin: 0 0 14px;
    color: #775d43;
    font-size: 13px;
  }

  .product u {
    font-size: 12px;
    text-underline-offset: 5px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  @media (max-width: 900px) {
    .collection-head {
      grid-template-columns: 1fr;
    }

    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .home-collection {
      padding: 65px 6% 90px;
    }

    .collection-head h1 {
      font-size: 52px;
    }

    .product-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }

    .product h2 {
      font-size: 20px;
    }
  }
</style>