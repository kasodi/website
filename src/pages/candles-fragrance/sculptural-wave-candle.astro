
---
import "../../styles/global.css";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";

const affiliateUrl = "https://temu.to/k/ec1oh6wo4j6";
const productImage = "/images/candles-fragrance/sculptural-wave-candle.png";
---

<html lang="en">
  <head>
    <!-- Google Consent Mode -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];

      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
        functionality_storage: "denied",
        personalization_storage: "denied",
        security_storage: "granted",
        wait_for_update: 2000
      });

      gtag("set", "ads_data_redaction", true);
      gtag("set", "url_passthrough", true);
    </script>

    <!-- Start CookieYes banner -->
    <script
      id="cookieyes"
      type="text/javascript"
      src="https://cdn-cookieyes.com/client_data/e9c032e34948c08e8ad6b9973971db36/script.js"
    ></script>
    <!-- End CookieYes banner -->

    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-LT2BEMKHKC"
    ></script>

    <script is:inline>
      window.dataLayer = window.dataLayer || [];

      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("js", new Date());
      gtag("config", "G-LT2BEMKHKC");
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Sculptural Wave Candle | KASODI</title>

    <meta
      name="description"
      content="Discover the Sculptural Wave Candle by Shape Scent Lab, selected by KASODI for its flowing ivory silhouette, textured wax design and soft vanilla fragrance."
    />

    <link
      rel="canonical"
      href="https://kasodi.com/candles-fragrance/sculptural-wave-candle/"
    />

    <meta property="og:type" content="product" />
    <meta
      property="og:title"
      content="Sculptural Wave Candle | KASODI"
    />
    <meta
      property="og:description"
      content="An ivory sculptural candle with flowing curves, a softly textured finish and a warm vanilla scent. Discover this curated KASODI find."
    />
    <meta
      property="og:url"
      content="https://kasodi.com/candles-fragrance/sculptural-wave-candle/"
    />
    <meta
      property="og:image"
      content="https://kasodi.com/images/candles-fragrance/sculptural-wave-candle.png"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="Sculptural Wave Candle | KASODI"
    />
    <meta
      name="twitter:description"
      content="A softly sculptural ivory candle with flowing curves and a warm vanilla fragrance."
    />
    <meta
      name="twitter:image"
      content="https://kasodi.com/images/candles-fragrance/sculptural-wave-candle.png"
    />
  </head>

  <body>
    <Header />

    <main class="product-detail-page">

      <!-- BREADCRUMBS -->
      <div class="product-breadcrumb">
        <a href="/">Home</a>
        <span>&middot;</span>
        <a href="/lifestyle">Lifestyle</a>
        <span>&middot;</span>
        <a href="/lifestyle/candles-fragrance">
          Candles &amp; Fragrance
        </a>
        <span>&middot;</span>
        <span>Sculptural Wave Candle</span>
      </div>

      <!-- PRODUCT HERO -->
      <section class="product-detail-hero">

        <div class="product-detail-image">
          <img
            src={productImage}
            alt="Ivory Sculptural Wave Candle by Shape Scent Lab styled on a warm stone table in a Mediterranean interior"
            width="1080"
            height="1350"
          />
        </div>

        <div class="product-detail-content">

          <p class="product-detail-eyebrow">
            KASODI EDIT · CANDLES & FRAGRANCE
          </p>

          <h1>
            Sculptural Wave Candle
          </h1>

          <p class="product-detail-brand">
            Shape Scent Lab
          </p>

          <p class="product-detail-intro">
            A beautifully sculptural candle defined by flowing,
            ribbon-like curves and a softly textured ivory finish.
            With its expressive silhouette and gentle vanilla
            fragrance, this decorative piece brings warmth,
            movement and a quiet sense of artistry to a shelf,
            coffee table or thoughtfully styled corner.
          </p>

          <div class="product-detail-divider"></div>

          <div class="product-detail-meta">

            <div>
              <span>Material</span>
              <strong>Wax blend · Beeswax, paraffin & soy wax</strong>
            </div>

            <div>
              <span>Weight</span>
              <strong>125 g · Tall version</strong>
            </div>

            <div>
              <span>Colour</span>
              <strong>Warm ivory · Cream</strong>
            </div>

            <div>
              <span>Fragrance</span>
              <strong>Vanilla</strong>
            </div>

            <div>
              <span>Wick</span>
              <strong>Single wick</strong>
            </div>

            <div>
              <span>Style</span>
              <strong>Sculptural · Organic · Contemporary</strong>
            </div>

          </div>

          <div class="affiliate-action">

            <a
              href={affiliateUrl}
              target="_blank"
              rel="nofollow sponsored noopener noreferrer"
              class="product-shop-button"
            >
              Find It Here →
            </a>

            <p class="affiliate-note">
              Affiliate link · KASODI may earn a commission at no extra cost to you.
            </p>

          </div>

        </div>
      </section>

      <!-- WHY WE LOVE IT -->
      <section class="why-we-love">

        <div class="why-we-love-label">
          KASODI NOTE
        </div>

        <div class="why-we-love-content">

          <h2>Why we love it</h2>

          <p>
            Some decorative objects make an impression through
            colour, others through their form. This candle
            belongs to the latter. Its flowing, wave-like
            layers create an almost architectural silhouette,
            with soft curves that catch the light and bring
            a beautiful sense of movement to a space.
          </p>

          <p>
            We particularly love the contrast between its
            expressive shape and its understated ivory colour.
            Styled on travertine, warm wood or a simple ceramic
            tray, it becomes a small statement piece without
            overwhelming the room. Even when unlit, its
            sculptural form adds texture and character.
          </p>

          <p>
            The delicate vanilla fragrance makes it an
            inviting finishing touch for a cosy evening
            or a carefully curated interior.
          </p>

        </div>
      </section>

      <!-- CARE -->
      <section class="product-care">

        <p class="product-detail-eyebrow">
          CARE
        </p>

        <h2>Keep the sculptural shape beautiful</h2>

        <p>
          Place the candle on a stable, heat-resistant candle
          plate or tray to protect the surface beneath it.
          Trim the wick before lighting and keep the candle
          away from drafts, curtains and flammable objects.
          Never leave a burning candle unattended.
        </p>

        <p>
          Because of its sculptural design, wax may melt
          unevenly and flow beyond the original shape.
          Keep away from children and pets, and allow
          the wax to cool completely before handling.
        </p>

      </section>

      <!-- STYLING IDEAS -->
      <section class="styling-ideas">

        <div class="styling-heading">
          <p>KASODI STYLING</p>
          <h2>Style it with</h2>
        </div>

        <div class="styling-grid">

          <div class="styling-card">
            <span>01</span>
            <h3>Travertine & Natural Stone</h3>
            <p>
              Place the candle on a travertine or limestone
              surface to highlight its soft ivory colour.
              The natural texture of stone provides a
              beautiful contrast to its flowing curves.
            </p>
          </div>

          <div class="styling-card">
            <span>02</span>
            <h3>Warm Wood & Linen</h3>
            <p>
              Pair it with a walnut or oak coffee table,
              a linen-covered book and warm neutral
              textiles for a relaxed, inviting arrangement
              inspired by Mediterranean interiors.
            </p>
          </div>

          <div class="styling-card">
            <span>03</span>
            <h3>Handmade Ceramics</h3>
            <p>
              Combine the candle with an earthy ceramic
              vase or a softly glazed bowl. The mix of
              organic shapes and tactile finishes creates
              a collected, effortlessly elegant look.
            </p>
          </div>

        </div>
      </section>

      <!-- CONTINUE EXPLORING -->
      <section class="continue-exploring">

        <div class="continue-exploring-heading">
          <p>CANDLES & FRAGRANCE</p>
          <h2>Continue Exploring</h2>
        </div>

        <div class="continue-exploring-grid">

          <!-- CARD 1 -->
          <a
            href="/candles-fragrance/sculptural-ivory-candles"
            class="continue-card"
          >
            <div class="continue-card-image">
              <img
                src="/images/kasodi-edit/kasodi-edit-sculptural-ivory-candles.png"
                alt="Sculptural Ivory Candles"
                loading="lazy"
              />
            </div>

            <div class="continue-card-info">
              <span>CANDLES</span>
              <h3>Sculptural Ivory Candles</h3>
              <p>ALMA DE LLAMA</p>
              <strong>Discover →</strong>
            </div>
          </a>

          <!-- CARD 2 -->
          <a
            href="/home-decor/blue-floral-ceramic-pitcher"
            class="continue-card"
          >
            <div class="continue-card-image">
              <img
                src="/images/home-decor/blue-floral-ceramic-pitcher.png"
                alt="Blue Floral Ceramic Pitcher"
                loading="lazy"
              />
            </div>

            <div class="continue-card-info">
              <span>HOME DECOR</span>
              <h3>Blue Floral Ceramic Pitcher</h3>
              <p>Curated by KASODI</p>
              <strong>Discover →</strong>
            </div>
          </a>

          <!-- CARD 3 -->
          <a
            href="/textiles-cozy/cream-tassel-table-runner"
            class="continue-card"
          >
            <div class="continue-card-image">
              <img
                src="/images/textiles-cozy/cream-tassel-table-runner.png"
                alt="Cream Tassel Table Runner"
                loading="lazy"
              />
            </div>

            <div class="continue-card-info">
              <span>TEXTILES & COZY</span>
              <h3>Cream Tassel Table Runner</h3>
              <p>Curated by KASODI</p>
              <strong>Discover →</strong>
            </div>
          </a>

        </div>
      </section>

      <!-- FINAL CTA -->
      <section class="product-final-cta">

        <p class="product-detail-eyebrow">
          SHAPE SCENT LAB · SCULPTURAL CANDLE
        </p>

        <h2>
          A little movement, texture and warmth for your home.
        </h2>

        <a
          href={affiliateUrl}
          target="_blank"
          rel="nofollow sponsored noopener noreferrer"
          class="product-shop-button"
        >
          Find It Here →
        </a>

        <p class="affiliate-note affiliate-note-light">
          Affiliate link · KASODI may earn a commission at no extra cost to you.
        </p>

      </section>

    </main>

    <Footer />
  </body>
</html>
