---
import "../../styles/global.css";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
---

<html lang="en">
  <head>
    <!-- Google Consent Mode -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
        functionality_storage: "denied",
        personalization_storage: "denied",
        security_storage: "granted",
        wait_for_update: 2000
      });

      gtag("set", "ads_data_redaction", true);
      gtag("set", "url_passthrough", true);
    </script>

    <!-- Start cookieyes banner -->
    <script
      id="cookieyes"
      type="text/javascript"
      src="https://cdn-cookieyes.com/client_data/e9c032e34948c08e8ad6b9973971db36/script.js"
    ></script>
    <!-- End cookieyes banner -->

    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-LT2BEMKHKC"
    ></script>

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-LT2BEMKHKC');
    </script>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>Ribbed Sculptural Candle Set | KASODI</title>

    <meta
      name="description"
      content="Discover the Ribbed Sculptural Candle Set by ALMA DE LLAMA, selected by KASODI for its architectural form, natural rapeseed wax and warm ivory finish."
    />
  </head>

  <body>

    <Header />

    <main class="product-detail-page">

      <!-- BREADCRUMBS -->
      <div class="product-breadcrumb">
        <a href="/">Home</a>
        <span>·</span>
        <a href="/candles-fragrance">Candles & Fragrance</a>
        <span>·</span>
        <span>Ribbed Sculptural Candle Set</span>
      </div>


      <!-- PRODUCT HERO -->
      <section class="product-detail-hero">

        <div class="product-detail-image">
          <img
            src="/images/candles-fragrance/alma-de-llama-ribbed-sculptural-candles.png"
            alt="Ribbed sculptural candle set by ALMA DE LLAMA styled by KASODI"
          />
        </div>


        <div class="product-detail-content">

          <p class="product-detail-eyebrow">
            KASODI EDIT · CANDLES & FRAGRANCE
          </p>

          <h1>
            Ribbed Sculptural Candle Set
          </h1>

          <p class="product-detail-brand">
            ALMA DE LLAMA
          </p>

          <p class="product-detail-intro">
            A pair of sculptural pillar candles defined by vertical ribbing
            and softly cinched silhouettes. Made in Spain from natural
            rapeseed vegetable wax, their warm ivory finish and architectural
            form make them decorative objects in their own right — equally
            at home on a dining table, console or quiet shelf.
          </p>

          <div class="product-detail-divider"></div>


          <!-- PRODUCT META -->
          <div class="product-detail-meta">

            <div class="product-meta-item">
              <span>Material</span>
              <p>Natural rapeseed wax</p>
            </div>

            <div class="product-meta-item">
              <span>Size</span>
              <p>Approx. 4.5 × 14.5 cm</p>
            </div>

            <div class="product-meta-item">
              <span>Weight</span>
              <p>Approx. 365 g</p>
            </div>

            <div class="product-meta-item">
              <span>Colour</span>
              <p>Ivory · White</p>
            </div>

            <div class="product-meta-item">
              <span>Set</span>
              <p>2 candles</p>
            </div>

            <div class="product-meta-item">
              <span>Made in</span>
              <p>Spain</p>
            </div>

          </div>


          <!-- AFFILIATE -->
          <div class="affiliate-action">

            <a
              href="https://amzn.to/4iqxmqN"
              target="_blank"
              rel="nofollow sponsored"
              class="affiliate-button"
            >
              Find It Here →
            </a>

            <p class="affiliate-disclosure">
              Affiliate link · KASODI may earn a commission at no extra cost to you.
            </p>

          </div>

        </div>

      </section>


      <!-- WHY WE LOVE IT -->
      <section class="why-we-love">

        <div class="why-we-love-inner">

          <p class="section-eyebrow">
            KASODI NOTE
          </p>

          <h2>
            Why we love it
          </h2>

          <p>
            The appeal of these candles is in the balance between clean
            geometry and a softer sculptural shape. Deep vertical ribbing
            gives them an architectural quality, while the narrowed centre
            keeps the silhouette from feeling too formal or predictable.
          </p>

          <p>
            We especially like the two different heights styled together.
            The warm ivory tone works beautifully with stone, dark wood,
            ceramics and aged metals, making the pair easy to introduce
            into both minimal and more collected interiors. Because they
            are unscented, they are also particularly suited to a dining
            table or tablescape.
          </p>

        </div>

      </section>


      <!-- CARE -->
      <section class="product-care">

        <div class="product-care-inner">

          <p class="section-eyebrow">
            CARE
          </p>

          <h2>
            Keep the sculptural form beautiful
          </h2>

          <p>
            Place the candles on a stable, heat-resistant surface and keep
            them away from drafts, direct heat and flammable objects. Trim
            the wick before lighting and never leave a burning candle
            unattended. A candle plate or decorative tray will help protect
            the surface beneath as the wax softens.
          </p>

        </div>

      </section>


      <!-- STYLE IT WITH -->
      <section class="styling-ideas">

        <div class="styling-heading">

          <p class="section-eyebrow">
            STYLE IT WITH
          </p>

          <h2>
            Simple materials, sculptural contrast.
          </h2>

        </div>


        <div class="styling-grid">

          <article class="styling-card">
            <span>01</span>

            <h3>
              Travertine & Stone
            </h3>

            <p>
              Pale stone brings out the warm ivory tone of the wax while
              giving the ribbed silhouettes a calm architectural setting.
            </p>
          </article>


          <article class="styling-card">
            <span>02</span>

            <h3>
              Dark Wood
            </h3>

            <p>
              Walnut, oak or another deeper wood tone creates a beautiful
              contrast against the creamy candles and makes their shape
              more pronounced.
            </p>
          </article>


          <article class="styling-card">
            <span>03</span>

            <h3>
              Aged Brass
            </h3>

            <p>
              A small brass tray, bowl or decorative object introduces
              warmth and a subtle glow without competing with the sculptural
              form of the candles.
            </p>
          </article>

        </div>

      </section>


      <!-- CONTINUE EXPLORING -->
      <section class="continue-exploring">

        <div class="continue-exploring-heading">

          <p class="section-eyebrow">
            KASODI EDIT
          </p>

          <h2>
            Continue Exploring
          </h2>

        </div>


        <div class="continue-exploring-grid">

          <a
            href="/candles-fragrance/lena-sculptural-flower-candle"
            class="explore-card"
          >
            <div class="explore-image">
              <img
                src="/images/candles-fragrance/serentique-lena-sculptural-flower-candle.png"
                alt="Lena Sculptural Flower Candle"
                loading="lazy"
              />
            </div>

            <p class="explore-category">
              CANDLES
            </p>

            <h3>
              Lena Sculptural Flower Candle
            </h3>

            <p class="explore-brand">
              Serentique
            </p>
          </a>


          <a
            href="/candles-fragrance/sculptural-ivory-candles"
            class="explore-card"
          >
            <div class="explore-image">
              <img
                src="/images/kasodi-edit/kasodi-edit-sculptural-ivory-candles.png"
                alt="Sculptural Ivory Candles"
                loading="lazy"
              />
            </div>

            <p class="explore-category">
              CANDLES
            </p>

            <h3>
              Sculptural Ivory Candles
            </h3>

            <p class="explore-brand">
              ALMA DE LLAMA
            </p>
          </a>


          <a
            href="/home-decor/blue-floral-ceramic-pitcher"
            class="explore-card"
          >
            <div class="explore-image">
              <img
                src="/images/home-decor/blue-floral-ceramic-pitcher.png"
                alt="Blue Floral Ceramic Pitcher"
                loading="lazy"
              />
            </div>

            <p class="explore-category">
              HOME DECOR
            </p>

            <h3>
              Blue Floral Ceramic Pitcher
            </h3>

            <p class="explore-brand">
              KASODI EDIT
            </p>
          </a>

        </div>

      </section>


      <!-- FINAL CTA -->
      <section class="product-final-cta">

        <div class="product-final-cta-inner">

          <p class="section-eyebrow">
            ALMA DE LLAMA · SCULPTURAL CANDLES
          </p>

          <h2>
            Architectural candlelight for a quieter interior.
          </h2>

          <a
            href="https://amzn.to/4iqxmqN"
            target="_blank"
            rel="nofollow sponsored"
            class="affiliate-button"
          >
            Find It Here →
          </a>

          <p class="affiliate-disclosure">
            Affiliate link · KASODI may earn a commission at no extra cost to you.
          </p>

        </div>

      </section>

    </main>

    <Footer />

  </body>
</html>