---
import "../../styles/global.css";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
---

<html lang="en">
  <head>
    <!-- Google Consent Mode -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
        functionality_storage: "denied",
        personalization_storage: "denied",
        security_storage: "granted",
        wait_for_update: 2000
      });

      gtag("set", "ads_data_redaction", true);
      gtag("set", "url_passthrough", true);
    </script>

    <!-- Start cookieyes banner -->
    <script
      id="cookieyes"
      type="text/javascript"
      src="https://cdn-cookieyes.com/client_data/e9c032e34948c08e8ad6b9973971db36/script.js"
    ></script>
    <!-- End cookieyes banner -->

    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-LT2BEMKHKC"
    ></script>

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-LT2BEMKHKC');
    </script>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>Walnut Candle Holder Set | KASODI</title>

    <meta
      name="description"
      content="Discover the Walnut Candle Holder Set by Sabai'ly, selected by KASODI for its rich natural wood grain, simple circular form and versatile design."
    />
  </head>

  <body>

    <Header />

    <main class="product-detail-page">

      <!-- BREADCRUMBS -->
      <div class="product-breadcrumb">
        <a href="/">Home</a>
        <span>·</span>
        <a href="/candles-fragrance">Candles & Fragrance</a>
        <span>·</span>
        <span>Walnut Candle Holder Set</span>
      </div>


      <!-- PRODUCT HERO -->
      <section class="product-detail-hero">

        <div class="product-detail-image">
          <img
            src="/images/candles-fragrance/sabaily-walnut-candle-holder-set.png"
            alt="Walnut candle holder set by Sabai'ly styled by KASODI"
          />
        </div>


        <div class="product-detail-content">

          <p class="product-detail-eyebrow">
            KASODI EDIT · CANDLES & FRAGRANCE
          </p>

          <h1>
            Walnut Candle Holder Set
          </h1>

          <p class="product-detail-brand">
            Sabai'ly
          </p>

          <p class="product-detail-intro">
            A pair of simple round candle holders crafted from natural
            walnut wood, bringing warmth and contrast to candles and small
            decorative arrangements. The rich grain and raised edge give
            each piece a quiet, tactile character while helping protect
            the surface beneath from heat and softened wax.
          </p>

          <div class="product-detail-divider"></div>


          <!-- PRODUCT META -->
          <div class="product-detail-meta">

            <div class="product-meta-item">
              <span>Material</span>
              <p>Natural walnut wood</p>
            </div>

            <div class="product-meta-item">
              <span>Size</span>
              <p>Ø10 × 1.3 cm</p>
            </div>

            <div class="product-meta-item">
              <span>Inner surface</span>
              <p>Ø8.5 cm</p>
            </div>

            <div class="product-meta-item">
              <span>Colour</span>
              <p>Dark walnut</p>
            </div>

            <div class="product-meta-item">
              <span>Set</span>
              <p>2 candle holders</p>
            </div>

            <div class="product-meta-item">
              <span>Finish</span>
              <p>Lacquered wood</p>
            </div>

          </div>


          <!-- AFFILIATE -->
          <div class="affiliate-action">

            <a
              href="https://amzn.to/4rhwHKK"
              target="_blank"
              rel="nofollow sponsored"
              class="affiliate-button"
            >
              Find It Here →
            </a>

            <p class="affiliate-disclosure">
              Affiliate link · KASODI may earn a commission at no extra cost to you.
            </p>

          </div>

        </div>

      </section>


      <!-- WHY WE LOVE IT -->
      <section class="why-we-love">

        <div class="why-we-love-inner">

          <p class="section-eyebrow">
            KASODI NOTE
          </p>

          <h2>
            Why we love it
          </h2>

          <p>
            Some accessories quietly make an entire room feel warmer,
            and these walnut candle holders are a perfect example.
            Their clean circular silhouette lets the natural grain
            become the decorative detail, while the deep wood tone
            introduces beautiful contrast alongside pale candles,
            ceramics and stone.
          </p>

          <p>
            We also like how versatile they are. Designed to hold candles
            up to approximately 8 cm in diameter, the shallow wooden
            dishes can also work as small coasters or understated
            decorative trays. They are the kind of useful object that
            can move easily from a dining table to a coffee table,
            bedside table or console.
          </p>

        </div>

      </section>


      <!-- CARE -->
      <section class="product-care">

        <div class="product-care-inner">

          <p class="section-eyebrow">
            CARE
          </p>

          <h2>
            Preserve the natural walnut finish
          </h2>

          <p>
            Wipe the surface gently with a soft, dry or slightly damp
            cloth and dry promptly. Avoid soaking the wood or using
            abrasive cleaners. When used with candles, keep the holder
            on a stable surface and never leave a burning candle
            unattended.
          </p>

        </div>

      </section>


      <!-- STYLE IT WITH -->
      <section class="styling-ideas">

        <div class="styling-heading">

          <p class="section-eyebrow">
            STYLE IT WITH
          </p>

          <h2>
            Warm wood, soft wax and natural texture.
          </h2>

        </div>


        <div class="styling-grid">

          <article class="styling-card">
            <span>01</span>

            <h3>
              Ivory Candles
            </h3>

            <p>
              Cream and ivory candles create a beautiful contrast against
              the dark walnut, allowing both the wood grain and sculptural
              candle form to stand out.
            </p>
          </article>


          <article class="styling-card">
            <span>02</span>

            <h3>
              Deep Olive
            </h3>

            <p>
              A dark green pillar candle brings an earthy Mediterranean
              note to the walnut and works especially well with natural
              foliage and warm neutral interiors.
            </p>
          </article>


          <article class="styling-card">
            <span>03</span>

            <h3>
              Stone & Linen
            </h3>

            <p>
              Pair the rich wood with travertine, softly textured ceramics
              and relaxed linen to create the layered natural-material
              palette we love at KASODI.
            </p>
          </article>

        </div>

      </section>


      <!-- CONTINUE EXPLORING -->
      <section class="continue-exploring">

        <div class="continue-exploring-heading">

          <p class="section-eyebrow">
            KASODI EDIT
          </p>

          <h2>
            Continue Exploring
          </h2>

        </div>


        <div class="continue-exploring-grid">

          <a
            href="/candles-fragrance/ribbed-sculptural-candle-set"
            class="explore-card"
          >
            <div class="explore-image">
              <img
                src="/images/candles-fragrance/alma-de-llama-ribbed-sculptural-candles.png"
                alt="Ribbed Sculptural Candle Set"
                loading="lazy"
              />
            </div>

            <p class="explore-category">
              CANDLES
            </p>

            <h3>
              Ribbed Sculptural Candle Set
            </h3>

            <p class="explore-brand">
              ALMA DE LLAMA
            </p>
          </a>


          <a
            href="/candles-fragrance/lena-sculptural-flower-candle"
            class="explore-card"
          >
            <div class="explore-image">
              <img
                src="/images/candles-fragrance/serentique-lena-sculptural-flower-candle.png"
                alt="Lena Sculptural Flower Candle"
                loading="lazy"
              />
            </div>

            <p class="explore-category">
              CANDLES
            </p>

            <h3>
              Lena Sculptural Flower Candle
            </h3>

            <p class="explore-brand">
              Serentique
            </p>
          </a>


          <a
            href="/candles-fragrance/sculptural-ivory-candles"
            class="explore-card"
          >
            <div class="explore-image">
              <img
                src="/images/kasodi-edit/kasodi-edit-sculptural-ivory-candles.png"
                alt="Sculptural Ivory Candles"
                loading="lazy"
              />
            </div>

            <p class="explore-category">
              CANDLES
            </p>

            <h3>
              Sculptural Ivory Candles
            </h3>

            <p class="explore-brand">
              ALMA DE LLAMA
            </p>
          </a>

        </div>

      </section>


      <!-- FINAL CTA -->
      <section class="product-final-cta">

        <div class="product-final-cta-inner">

          <p class="section-eyebrow">
            SABAI'LY · WALNUT CANDLE HOLDERS
          </p>

          <h2>
            A warm wooden detail for candlelit corners.
          </h2>

          <a
            href="https://amzn.to/4rhwHKK"
            target="_blank"
            rel="nofollow sponsored"
            class="affiliate-button"
          >
            Find It Here →
          </a>

          <p class="affiliate-disclosure">
            Affiliate link · KASODI may earn a commission at no extra cost to you.
          </p>

        </div>

      </section>

    </main>

    <Footer />

  </body>
</html>