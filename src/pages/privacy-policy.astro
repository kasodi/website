---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Privacy Policy | KASODI</title>

    <meta
      name="description"
      content="Read the KASODI Privacy Policy and learn how information may be handled when you visit or interact with our website."
    />
  </head>

  <body>

    <Header />


    <main class="policy-page">

      <section class="policy-hero">

        <p class="policy-eyebrow">
          YOUR PRIVACY
        </p>

        <h1>
          Privacy Policy
        </h1>

        <p class="policy-intro">
          This Privacy Policy explains how KASODI handles information when you
          visit our website, contact us or follow links to third-party websites.
        </p>

        <p class="policy-updated">
          Last updated: August 2026
        </p>

      </section>


      <section class="policy-content">


        <div class="policy-section">

          <span class="policy-number">01</span>

          <div>
            <h2>About KASODI</h2>

            <p>
              KASODI is an independent home and lifestyle curation website
              based in Spain and intended for readers in Spain and across
              Europe.
            </p>

            <p>
              For questions about this Privacy Policy or the handling of
              personal information in connection with KASODI, you can contact
              us at:
            </p>

            <a
              class="policy-email"
              href="mailto:kasodi.info@gmail.com"
            >
              kasodi.info@gmail.com
            </a>
          </div>

        </div>


        <div class="policy-section">

          <span class="policy-number">02</span>

          <div>
            <h2>Information you provide to us</h2>

            <p>
              KASODI currently does not provide user accounts, registration,
              comments, newsletter subscriptions or website contact forms.
            </p>

            <p>
              If you choose to contact KASODI by email, we may receive the
              information you voluntarily include in your message, such as
              your name, email address and the content of your enquiry.
            </p>

            <p>
              We use this information only as reasonably necessary to read,
              respond to and manage your communication with us.
            </p>
          </div>

        </div>


        <div class="policy-section">

          <span class="policy-number">03</span>

          <div>
            <h2>Technical information</h2>

            <p>
              When you visit a website, certain technical information may be
              processed automatically as part of providing and securing the
              website. This can include information such as IP address,
              browser type, device information, requested pages, date and time
              of access and similar technical data.
            </p>

            <p>
              Such information may be processed by the infrastructure and
              hosting services used to make KASODI available online, including
              for purposes such as delivering website content, maintaining
              security and diagnosing technical problems.
            </p>
          </div>

        </div>


        <div class="policy-section">

          <span class="policy-number">04</span>

          <div>
            <h2>Analytics and advertising technologies</h2>

            <p>
              KASODI currently does not use Google Analytics, Meta Pixel,
              Pinterest Tag or similar analytics or advertising tracking tools
              on the website.
            </p>

            <p>
              If we introduce analytics, advertising technologies or similar
              services in the future, this Privacy Policy and, where
              appropriate, our Cookie Policy and consent mechanisms will be
              updated accordingly.
            </p>
          </div>

        </div>


        <div class="policy-section">

          <span class="policy-number">05</span>

          <div>
            <h2>Affiliate links and third-party websites</h2>

            <p>
              KASODI contains affiliate links and other external links that may
              take you to websites operated by third parties.
            </p>

            <p>
              Our current affiliate relationships include Amazon.es through
              the Amazon Associates Program and the Temu Affiliate Program.
              We may work with additional retailers, brands and affiliate
              networks in the future.
            </p>

            <p>
              When you follow an external link and leave KASODI, the third-party
              website may collect or process information in accordance with its
              own privacy policy, cookie policy and terms. KASODI does not
              control the privacy practices of those third-party websites.
            </p>

            <p>
              We encourage you to review the relevant privacy information
              provided by a third-party website before providing personal
              information or completing a purchase.
            </p>
          </div>

        </div>


        <div class="policy-section">

          <span class="policy-number">06</span>

          <div>
            <h2>Social media links</h2>

            <p>
              KASODI may provide links to our profiles on services such as
              Instagram, Facebook and Pinterest.
            </p>

            <p>
              These are external links. When you choose to visit a social media
              platform, your interaction with that platform is governed by its
              own privacy practices, cookie policies and terms.
            </p>

            <p>
              KASODI currently does not embed social media feeds or similar
              social media widgets on the website.
            </p>
          </div>

        </div>


        <div class="policy-section">

          <span class="policy-number">07</span>

          <div>
            <h2>Cookies</h2>

            <p>
              KASODI currently does not intentionally use analytics or
              advertising cookies through tools such as Google Analytics,
              Meta Pixel or Pinterest Tag.
            </p>

            <p>
              However, technical infrastructure used to provide the website
              may process information necessary for the operation, delivery,
              reliability or security of the service. In addition, third-party
              websites you visit through links from KASODI may use their own
              cookies and similar technologies.
            </p>

            <p>
              More information is provided in our Cookie Policy.
            </p>
          </div>

        </div>


        <div class="policy-section">

          <span class="policy-number">08</span>

          <div>
            <h2>How long we keep information</h2>

            <p>
              If you contact KASODI directly by email, correspondence may be
              retained for as long as reasonably necessary to respond to your
              enquiry, maintain appropriate business records, resolve disputes
              or meet applicable legal obligations.
            </p>

            <p>
              We do not intentionally retain personal information for longer
              than necessary for the purpose for which it was received.
            </p>
          </div>

        </div>


        <div class="policy-section">

          <span class="policy-number">09</span>

          <div>
            <h2>Your data protection rights</h2>

            <p>
              If applicable under the General Data Protection Regulation
              (GDPR) or other relevant European data protection law, you may
              have rights regarding your personal data, including the right to
              request access, correction or deletion of personal information.
            </p>

            <p>
              Depending on the circumstances, you may also have rights to
              restrict or object to certain processing, request data
              portability or withdraw consent where processing is based on
              consent.
            </p>

            <p>
              You may contact KASODI at kasodi.info@gmail.com regarding a
              privacy request. You may also have the right to lodge a complaint
              with the competent data protection supervisory authority.
            </p>
          </div>

        </div>


        <div class="policy-section">

          <span class="policy-number">10</span>

          <div>
            <h2>Children's privacy</h2>

            <p>
              KASODI is a home and lifestyle curation website intended for a
              general audience. The website is not designed to knowingly
              collect personal information from children.
            </p>
          </div>

        </div>


        <div class="policy-section">

          <span class="policy-number">11</span>

          <div>
            <h2>Changes to this Privacy Policy</h2>

            <p>
              KASODI may update this Privacy Policy when the website, our
              services, the technologies we use or applicable requirements
              change.
            </p>

            <p>
              When we make changes, the updated version will be published on
              this page and the “Last updated” date will be revised.
            </p>
          </div>

        </div>


        <div class="policy-section">

          <span class="policy-number">12</span>

          <div>
            <h2>Contact</h2>

            <p>
              If you have questions about this Privacy Policy or would like to
              make a privacy-related request, contact:
            </p>

            <a
              class="policy-email"
              href="mailto:kasodi.info@gmail.com"
            >
              kasodi.info@gmail.com
            </a>
          </div>

        </div>

      </section>


      <section class="policy-final">

        <p class="policy-eyebrow">
          KASODI
        </p>

        <h2>
          Beautiful things, shared with transparency.
        </h2>

        <a href="/#collections" class="product-shop-button">
          Explore the Collection →
        </a>

      </section>

    </main>


  <Footer />

  </body>
</html>


<style>

  .policy-page {
    background: #f8f5ef;
    color: #29251f;
  }


  .policy-hero {
    max-width: 1000px;
    margin: 0 auto;
    padding: 110px 40px 100px;
    text-align: center;
  }


  .policy-eyebrow {
    margin: 0 0 25px;
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #917552;
  }


  .policy-hero h1 {
    margin: 0 auto 35px;
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
    font-size: clamp(48px, 6vw, 78px);
    line-height: 1.05;
  }


  .policy-intro {
    max-width: 720px;
    margin: 0 auto;
    font-size: 19px;
    line-height: 1.75;
    color: #5e574d;
  }


  .policy-updated {
    margin: 30px 0 0;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: #8b8378;
  }


  .policy-content {
    max-width: 1080px;
    margin: 0 auto;
    padding: 20px 40px 120px;
  }


  .policy-section {
    padding: 60px 0;
    border-top: 1px solid rgba(41, 37, 31, 0.15);

    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 45px;
  }


  .policy-number {
    font-size: 11px;
    letter-spacing: 0.18em;
    color: #917552;
  }


  .policy-section > div {
    max-width: 760px;
  }


  .policy-section h2 {
    margin: 0 0 25px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 32px;
    line-height: 1.2;
    font-weight: 400;
  }


  .policy-section p {
    margin: 0 0 20px;
    font-size: 16px;
    line-height: 1.85;
    color: #5d564c;
  }


  .policy-email {
    display: inline-block;
    margin-top: 5px;
    color: #29251f;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 24px;
    text-decoration: none;
    border-bottom: 1px solid rgba(41, 37, 31, 0.35);
  }


  .policy-email:hover {
    opacity: 0.65;
  }


  .policy-final {
    padding: 110px 40px;
    text-align: center;
    background: #29251f;
    color: #f8f5ef;
  }


  .policy-final h2 {
    max-width: 800px;
    margin: 0 auto 35px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(36px, 4vw, 55px);
    line-height: 1.15;
    font-weight: 400;
  }


  .policy-final .product-shop-button {
    display: inline-block;
  }


  @media (max-width: 700px) {

    .policy-hero,
    .policy-content,
    .policy-final {
      padding-left: 22px;
      padding-right: 22px;
    }


    .policy-section {
      grid-template-columns: 1fr;
      gap: 18px;
      padding: 45px 0;
    }


    .policy-hero {
      padding-top: 70px;
      padding-bottom: 70px;
    }


    .policy-email {
      font-size: 20px;
    }

  }

</style>