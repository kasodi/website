---
import '../styles/global.css';
import Header from './Header.astro';
import Footer from './Footer.astro';

const { title, intro, hero, groups = [], journal } = Astro.props;

interface Group {
  id: string;
  name: string;
  image: string;
  description?: string;
  href?: string;
  eyebrow?: string;
  products?: any[];
}

const typedGroups = groups as Group[];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0" />
    <title>{title} | KASODI</title>
    <meta name="description" content={intro} />
    <link
      rel="icon"
      type="image/png"
      href="/images/kasodi-favicon.png?v=2"
    />
  </head>

  <body>
    <Header />

    <main>

      <!-- HERO -->
      <section class="world-hero">
        <div class="hero-copy">
          <span>KASODI · {title.toUpperCase()}</span>

          <h1>{title}</h1>

          <p>{intro}</p>

          <a href="#discover">
            Explore {title} ↓
          </a>
        </div>

        <img
          src={hero}
          alt={`${title} by KASODI`}
        />
      </section>


      <!-- DISCOVER -->
      <section class="discover" id="discover">

        <div class="section-head">
          <span>DISCOVER</span>

          <h2>Explore {title}</h2>

          <p>
            A considered edit of the collection.
          </p>
        </div>

        <div class="group-grid">

          {typedGroups.map((g) => (
            <a
              class="group-card"
              href={g.href || `/${title.toLowerCase()}/${g.id}`}
            >
              <img
                src={g.image}
                alt={g.name}
              />

              <div>
                <h3>{g.name}</h3>
                <span>Discover &rarr;</span>
              </div>
            </a>
          ))}

        </div>
      </section>


      <!-- JOURNAL -->
      {journal && (
        <section class="journal">

          <div class="journal-copy">
            <span>FROM THE JOURNAL</span>

            <h2>{journal.title}</h2>

            <p>{journal.text}</p>

            <a href={journal.href}>
              Discover the Story &rarr;
            </a>
          </div>

          <img
            src={journal.image}
            alt={journal.title}
          />

        </section>
      )}

    </main>

    <Footer />
  </body>
</html>


<style>

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f8f6f1;
    color: #29251f;
    font-family: Arial, sans-serif;
  }


  /* HERO */

  .world-hero {
    display: grid;
    grid-template-columns: 42% 58%;
    min-height: 620px;
    border-bottom: 1px solid rgba(41,37,31,.12);
  }

  .hero-copy {
    padding: 110px 12% 80px 16%;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero-copy span,
  .section-head span,
  .collection-head span,
  .journal span {
    font-size: 11px;
    letter-spacing: .28em;
    color: #9a6b3b;
  }

  .hero-copy h1,
  .section-head h2,
  .collection-head h2,
  .journal h2,
  .group-card h3,
  .product h3 {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 400;
  }

  .hero-copy h1 {
    font-size: 76px;
    line-height: .95;
    margin: 22px 0;
  }

  .hero-copy p {
    font-size: 17px;
    line-height: 1.7;
    color: #775d43;
    max-width: 440px;
  }

  .hero-copy a,
  .journal a {
    color: #29251f;
    text-decoration: none;
    border-bottom: 1px solid #29251f;
    width: max-content;
    padding-bottom: 5px;
    margin-top: 16px;
    font-size: 13px;
  }

  .world-hero > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }


  /* SECTIONS */

  .discover,
  .collection,
  .journal {
    padding: 90px 8%;
    border-bottom: 1px solid rgba(41,37,31,.12);
  }


  /* DISCOVER HEADING */

  .section-head {
    display: grid;
    grid-template-columns: 170px 1fr 1fr;
    align-items: end;
    margin-bottom: 44px;
  }

  .section-head h2 {
    font-size: 48px;
    margin: 0;
  }

  .section-head p {
    color: #8a6848;
    justify-self: end;
  }


  /* GROUP CARDS */

  .group-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 28px;
}

.group-grid:has(> :nth-child(3):last-child) {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

  .group-card {
    color: #29251f;
    text-decoration: none;
  }

  .group-card img {
    width: 100%;
    aspect-ratio: 1.35;
    object-fit: cover;
  }

  .group-card > div {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  height: 110px;
  box-sizing: border-box;
  padding: 18px 0;
  border-bottom: 1px solid #a58c73;
}

  .group-card h3 {
    font-size: 28px;
    margin: 0;
  }

  .group-card span {
    font-size: 13px;
  }
  .group-card h3 {
  min-width: 0;
}

.group-card span {
  flex-shrink: 0;
  white-space: nowrap;
  margin-left: 16px;
}


  /* COLLECTION */

  .collection-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: end;
    margin-bottom: 42px;
  }

  .collection-head h2 {
    font-size: 48px;
    margin: 12px 0 0;
  }

  .collection-head p {
    color: #8a6848;
    line-height: 1.6;
    max-width: 520px;
  }


  /* PRODUCTS */

  .product-grid {
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 24px;
  }

  .product {
    color: #29251f;
    text-decoration: none;
  }

  .product img {
    width: 100%;
    aspect-ratio: .82;
    object-fit: cover;
  }

  .product > span {
    display: block;
    margin-top: 16px;
    font-size: 10px;
    letter-spacing: .16em;
    color: #9a6b3b;
    text-transform: uppercase;
  }

  .product h3 {
    font-size: 24px;
    margin: 8px 0 5px;
  }

  .product p {
    margin: 0 0 14px;
    color: #775d43;
    font-size: 13px;
  }

  .product u {
    font-size: 12px;
    text-underline-offset: 5px;
  }


  /* JOURNAL */

  .journal {
    display: grid;
    grid-template-columns: 42% 58%;
    gap: 70px;
    align-items: center;
  }

  .journal-copy {
    min-width: 0;
  }

  .journal h2 {
  font-size: 58px;
  line-height: 1;
  margin: 18px 0 22px;
  max-width: 500px;
  }

  .journal p {
    color: #775d43;
    font-size: 17px;
    line-height: 1.65;
    max-width: 470px;
    margin: 0;
  }

  .journal img {
    width: 100%;
    aspect-ratio: 1.7;
    object-fit: cover;
  }

/* LAPTOP / SMALL DESKTOP */

@media (max-width: 1450px) and (min-width: 801px) {

  /* HERO */

  .world-hero {
    grid-template-columns: 40% 60%;
    min-height: 560px;
  }

  .hero-copy {
    padding: 80px 10% 70px 12%;
  }

  .hero-copy h1 {
    font-size: 64px;
  }


  /* DISCOVER */

  .discover {
    padding-left: 5%;
    padding-right: 5%;
  }

  .section-head {
    grid-template-columns: 140px minmax(0, 1fr) auto;
    gap: 24px;
  }

  .section-head h2 {
    font-size: 44px;
  }

  .section-head p {
    margin: 0;
    white-space: nowrap;
  }


  /* CATEGORY CARDS */

  .group-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 42px 28px;
}

  .group-card {
    min-width: 0;
  }

  .group-card > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 10px;
    align-items: center;
  }

  .group-card h3 {
    min-width: 0;
    font-size: clamp(22px, 2vw, 26px);
    line-height: 1.05;
  }

  .group-card span {
    margin-left: 0;
    padding-top: 0;
    white-space: nowrap;
    font-size: 12px;
  }


  /* JOURNAL */

  .journal {
    grid-template-columns: minmax(0, 40%) minmax(0, 60%);
    gap: 45px;
    padding-left: 6%;
    padding-right: 6%;
  }

  .journal h2 {
    font-size: 50px;
  }
}


/* TABLET */

@media (max-width: 800px) {

  .world-hero {
    grid-template-columns: 1fr;
    min-height: auto;
  }

  .hero-copy {
    padding: 70px 8%;
  }

  .hero-copy h1 {
    font-size: 58px;
  }

  .world-hero > img {
    height: 430px;
  }

  .section-head,
  .collection-head,
  .journal {
    grid-template-columns: 1fr;
  }

  .section-head {
    gap: 12px;
  }

  .section-head p {
    justify-self: start;
    margin: 0;
  }

  .group-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 36px 22px;
  }

  .group-card {
    min-width: 0;
  }

  .group-card > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 10px;
    align-items: center;
  }

  .group-card h3 {
    min-width: 0;
    font-size: 26px;
    line-height: 1.05;
  }

  .group-card span {
    margin-left: 0;
    white-space: nowrap;
    font-size: 12px;
  }

  .product-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .discover,
  .collection,
  .journal {
    padding: 65px 6%;
  }

  .journal {
    gap: 40px;
  }

  .journal h2 {
    font-size: 44px;
    line-height: 1.04;
  }
}


/* MOBILE */

@media (max-width: 520px) {

  .hero-copy {
    padding: 55px 7%;
  }

  .hero-copy h1 {
    font-size: 50px;
  }

  .world-hero > img {
    height: 360px;
  }

  .section-head h2 {
    font-size: 40px;
  }

  .group-grid {
    grid-template-columns: 1fr;
    gap: 32px;
  }

  .group-card > div {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .group-card h3 {
    font-size: 27px;
  }

  .product-grid {
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .product h3 {
    font-size: 20px;
  }

  .journal {
    gap: 30px;
  }

  .journal h2 {
    font-size: 40px;
  }
}

</style>