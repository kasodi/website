<header class="site-header">
  <a class="logo" href="/">KASODI</a>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu">MENU</button>
  <nav class="main-nav" aria-label="Primary navigation">
    <a href="/home">Home</a>
    <a href="/kitchen">Kitchen</a>
    <a href="/bedroom">Bedroom</a>
    <a href="/lifestyle">Lifestyle</a>
    <a href="/journal">Journal</a>
  </nav>
</header>
<nav class="mobile-menu" id="mobile-menu" aria-label="Mobile navigation">
  <a href="/home">Home</a><a href="/kitchen">Kitchen</a><a href="/bedroom">Bedroom</a><a href="/lifestyle">Lifestyle</a><a href="/journal">Journal</a>
</nav>
<script>
  const menuButton = document.querySelector('.menu-toggle');
  const mobileMenu = document.querySelector('.mobile-menu');
  if (menuButton && mobileMenu) {
    menuButton.addEventListener('click', () => {
      const isOpen = mobileMenu.classList.toggle('is-open');
      menuButton.textContent = isOpen ? 'CLOSE' : 'MENU';
      menuButton.setAttribute('aria-expanded', String(isOpen));
    });
    mobileMenu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
      mobileMenu.classList.remove('is-open'); menuButton.textContent = 'MENU'; menuButton.setAttribute('aria-expanded', 'false');
    }));
  }
</script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400&display=swap');
.site-header{width:100%;height:96px;padding:0 4%;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(41,37,31,.09);background:#f8f6f1}.logo{display:block;font-family:"Cormorant Garamond",Georgia,serif;font-size:32px;font-weight:300;letter-spacing:.20em;color:#29251f;text-decoration:none}.main-nav{display:flex;align-items:center;gap:38px}.main-nav a{color:#29251f;text-decoration:none;text-transform:uppercase;letter-spacing:.15em;font-size:11px}.menu-toggle{display:none;border:0;background:transparent;padding:8px 0;font:inherit;font-size:11px;text-transform:uppercase;letter-spacing:.18em;color:#29251f;cursor:pointer}.mobile-menu{display:none;width:100%;padding:12px 6% 28px;background:#f8f6f1;border-bottom:1px solid rgba(41,37,31,.09)}.mobile-menu a{display:block;padding:14px 0;color:#29251f;text-decoration:none;text-transform:uppercase;letter-spacing:.15em;font-size:12px;border-bottom:1px solid rgba(41,37,31,.08)}.mobile-menu a:last-child{border-bottom:0}@media(max-width:760px){.site-header{height:96px;padding:0 6%}.logo{font-size:30px}.main-nav{display:none}.menu-toggle{display:block}.mobile-menu.is-open{display:block!important}}
</style>
